<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Marshal.UI.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <!-- Wybieraczka barw mieszka w osobnym pakiecie i niesie własny motyw.
         Bez tego wiersza kontrolka istnieje, ale nie ma się czym narysować. -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
  </Application.Styles>
</Application>
