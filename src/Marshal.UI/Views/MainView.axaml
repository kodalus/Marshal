<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Marshal.UI.ViewModels"
             xmlns:k="using:Marshal.UI.Kontrolki"
             xmlns:tasks="using:Marshal.Domain.Tasks"
             xmlns:uc="using:Marshal.Application.UseCases"
             xmlns:rev="using:Marshal.Application.Review"
             xmlns:sys="using:System"
             xmlns:dn="using:Marshal.Domain.Notes"
             xmlns:dc="using:Marshal.Domain.Calendar"
             xmlns:da="using:Marshal.Domain.Areas"
             xmlns:dk="using:Marshal.Domain.Contacts"
             xmlns:cal="using:Marshal.Infrastructure.Calendar"
             xmlns:df="using:Marshal.Domain.Filters"
             xmlns:ti="using:Avalonia.Input.TextInput"
             x:Class="Marshal.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             ti:TextInputOptions.AutoCapitalization="True">

  <!-- Wielka litera na początku zdania w każdym polu tekstowym: właściwość
       ti:TextInputOptions.AutoCapitalization na korzeniu, wyżej. Jest dziedziczona,
       więc stoi raz zamiast przy czterdziestu polach — i nowe pole dostaje to samo
       bez pamiętania o tym.

       To podpowiedź dla klawiatury telefonu, a nie poprawianie wpisanego tekstu:
       kto chce małej litery, po prostu ją pisze. Zamienianie pierwszej litery po
       fakcie zmieniałoby zapisane dane bez pytania.

       Wyłączona tam, gdzie wielka litera jest pomyłką: adresy pocztowe, adresy stron
       i poświadczenia Google. -->



  <UserControl.Resources>
    <!--
      Ikony przełączników w szczegółach zadania — **rysunki, nie znaki pisma**.

      Stały tu kiedyś emoji i na Androidzie nie pojawiało się nic: krój Inter, którym
      pisze cała aplikacja, nie ma takich znaków, a podstawienia innego kroju Avalonia
      tam nie robi. Zostawało pięć pustych kwadracików bez żadnego objawu, że to brak
      czcionki. Potem były słowa — czytelne, ale zajmowały dwa wiersze na telefonie.

      Ścieżka nie zależy od żadnego kroju: rysuje się tak samo na obu platformach
      i w obu motywach, bo barwę bierze z przycisku, na którym siedzi. To jest jedyna
      postać ikony, która nie może zniknąć przez czcionkę.

      Wszystkie w kwadracie 24 na 24 i krzywymi sześciennymi zamiast łuków: zapis łuku
      w tym języku różni się od tego z SVG i pomyłka w nim kończy się figurą, która
      albo nie rysuje się wcale, albo rysuje się nie tak — a sprawdzić to da się
      dopiero na ekranie.
    -->
    <StreamGeometry x:Key="IkonaTerminu">M4,5 L20,5 L20,21 L4,21 Z M4,10 L20,10 M8,2 L8,7 M16,2 L16,7</StreamGeometry>

    <StreamGeometry x:Key="IkonaPrzypomnienia">M6,10 C6,6.7 8.7,4 12,4 C15.3,4 18,6.7 18,10 L18,15 L20,18 L4,18 L6,15 Z M10,20 C10.4,21.2 11.1,21.8 12,21.8 C12.9,21.8 13.6,21.2 14,20</StreamGeometry>

    <StreamGeometry x:Key="IkonaWagi">M6,3 L6,22 M6,4 L19,4 L16,9.5 L19,15 L6,15</StreamGeometry>

    <StreamGeometry x:Key="IkonaSil">M13,2 L5,14 L11,14 L11,22 L19,10 L13,10 Z</StreamGeometry>

    <StreamGeometry x:Key="IkonaRytmu">M5,11 C5,7.1 8.1,4 12,4 C14.6,4 16.9,5.4 18.1,7.5 M15,7 L18.5,7.5 L19,4 M19,13 C19,16.9 15.9,20 12,20 C9.4,20 7.1,18.6 5.9,16.5 M9,17 L5.5,16.5 L5,20</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Pole daty ma własną szerokość najmniejszą, liczoną na trzy panele. W wierszu
         przypomnienia stało obok pola godziny i wypychało je poza krawędź karty —
         widać to było jako „hourminute" wciśnięte w sam róg. -->
    <Style Selector="Button.nav">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="14,8" />
    </Style>

    <!-- Pozycja bocznego paska: cała szerokość i napis od lewej. Przycisk szerokości
         napisu daje trzynaście różnych szerokości jedna pod drugą, po których oko
         jedzie zygzakiem zamiast w dół. -->
    <Style Selector="Button.boczny">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.boczny:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Pole}" />
    </Style>
    <!-- Ekran, na którym się właśnie jest. Pasek ma trzynaście jednakowych napisów
         i bez tego jedyną odpowiedzią na pytanie „gdzie ja jestem" była treść obok. -->
    <Style Selector="Button.boczny.wybrany">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.boczny.wybrany /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AkcentTlo}" />
    </Style>
    <!-- Godziny na bloku kalendarza: mniejsze od tytułu, bo są odpowiedzią na drugie
         pytanie, nie na pierwsze. -->
    <!-- Pole godziny ma własną szerokość najmniejszą, liczoną na trzy panele
         z sekundami — dwa takie pola obok siebie nie mieściły się w karcie i wychodziły
         poza jej krawędź. Zerowa szerokość najmniejsza oddaje rozstrzygnięcie siatce,
         w której leżą; ta sama poprawka dotyczy przycisku w środku, bo on ma swoją. -->
    <!-- Pasek ikon: równe kwadraty, nie prostokąty wielkości znaku. Pięć przycisków
         o pięciu różnych szerokościach czytało się jak pięć różnych rzeczy. -->
    <!-- Przełącznik rzadkiego pola. Szerokość z treści, nie kwadrat: odkąd niesie słowo,
         a nie symbol, stała szerokość albo ucinałaby napis, albo musiałaby być liczona
         pod najdłuższy z nich. -->
    <Style Selector="ToggleButton.ikona">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Pole}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Krawedz}" />
    </Style>
    <!-- Włączone poznaje się po obwódce w barwie wyróżnienia, nie po zamalowaniu:
         zamalowane tło zjada czytelność znaku, który na nim stoi. -->
    <Style Selector="ToggleButton.ikona:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Akcent}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <!-- Przełącznik z samym rysunkiem: kwadratowy, bo nie ma w nim napisu, który
         rozciągałby go na szerokość. Pięć takich mieści się w jednym wierszu także
         na telefonie — słowa rozkładały się na dwa. -->
    <Style Selector="ToggleButton.ikona.rysunek">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="44" />
    </Style>

    <!-- Obrys, nie wypełnienie: przy dwudziestu punktach wypełniona figura zlewa się
         w plamę, a kreska zostaje czytelna. Grubość i zaokrąglenia dobrane tak, żeby
         rysunek miał ten sam ciężar co napis obok. -->
    <Style Selector="Path.ikonka">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />

      <!-- Barwa z przycisku, nie z zasobu: przycisk zna swój motyw i swój stan,
           a ikona ma po prostu za nim iść. -->
      <Setter Property="Stroke" Value="{Binding $parent[ToggleButton].Foreground}" />
    </Style>

    <!-- Wciśnięty przełącznik barwi też rysunek. Sama ramka w barwie wyróżnienia
         ginęła na telefonie: przy pięciu kwadracikach obok siebie kreska grubości
         półtora punkta to za mało, żeby od razu zobaczyć, który jest włączony. -->
    <Style Selector="ToggleButton.ikona:checked Path.ikonka">
      <Setter Property="Stroke" Value="{DynamicResource Akcent}" />
    </Style>

    <Style Selector="TextBlock.godzina">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Kwadracik odhaczenia rysowany z ramki i napisu. Gotowe pole wyboru ma
         w motywie własną najmniejszą wysokość, poniżej której nie schodzi — na bloku
         kwadransa układało się na trzydzieści dwa punkty, rysowało na szesnaście
         i przycinało krawędzią bloku do rogu. Ramka pokazuje się przy najechaniu,
         ptaszek widać zawsze, gdy zadanie jest odhaczone. Na dotyku najechania nie ma,
         więc tam odhacza się z listy, z menu podręcznego albo ze szczegółu. -->
    <Style Selector="Border.odhacz">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#00FFFFFF" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="#10FFFFFF" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- Blok jest przyciskiem, żeby kliknięcie otwierało szczegół. Własna oprawa
         przycisku wyłączona: barwę bloku niesie ramka w środku, a domyślne tło
         motywu zamalowałoby kolor kalendarza przy najechaniu. -->
    <Style Selector="Border.slot">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.slot">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.slot /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.slot:pointerover Border.odhacz">
      <Setter Property="BorderBrush" Value="#C0FFFFFF" />
      <Setter Property="Background" Value="#25FFFFFF" />
    </Style>

    <!-- Pasek dolny: każda zakładka szeroka na tyle, ile ma treści — równe piąte
         części ucinały odznakę skrzynki. Wysokość i tak łapie kciuk, a wolne
         miejsce rozdzielają przerwy między zakładkami. -->
    <Style Selector="Button.tab">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.tab.wybrany">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tab.wybrany /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AkcentTlo}" />
    </Style>

    <Style Selector="Button.sheet">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Button.branch">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- Pusta lista nie ma rysować płyty. Domyślne tło listy przy braku pozycji daje
         szary prostokąt na pół ekranu, po którym nie widać, czy jest pusto, czy się
         nie wczytało. Dotyczy wszystkich list, nie tylko tej jednej. -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Oprawa wiersza z zadaniem. Na „Dzisiaj" tytuł zadania i zdanie wyjaśniające
         pod listą były tym samym napisem tej samej wielkości — po niczym nie dało się
         poznać, co jest rzeczą do zrobienia, a co komentarzem aplikacji. -->
    <Style Selector="Border.wiersz">
      <Setter Property="Background" Value="{DynamicResource Pole}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="FontSize" Value="12" />
      <!-- Zawijanie w stylu, nie przy każdym użyciu. Na telefonie każde podpowiedziane
           zdanie bez tego urywa się w połowie, a jest ich w tym pliku trzydzieści. -->
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Etykiety stanu bez czerwieni i bez wykrzykników: „przesunięte 4 razy" jest
         informacją, a ta sama liczba na czerwono jest wyrzutem (spec 11.1, N12–N15). -->
    <Style Selector="TextBlock.badge">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,10,0,3" />
    </Style>
    <!-- Dzisiejsza kolumna kalendarza. Przy siedmiu jednakowych nagłówkach
         znalezienie dzisiejszego wymagało przeczytania numerów i porównania ich
         z tym, co się pamięta — a kalendarz otwiera się właśnie po to, żeby nie
         musieć. Błękit, nie fiolet: fiolet mówi „wybrane", a dzisiaj nikt nie
         wybrał. -->
    <Style Selector="Border.dzis">
      <Setter Property="Background" Value="{DynamicResource Blekit}" />
    </Style>
    <Style Selector="Border.dzis > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AkcentTekst}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Komórka siatki miesiąca. Obrys zamiast wypełnienia: trzydzieści wypełnionych
         prostokątów obok siebie zlewa się w szachownicę, a to, co ma się z nich odczytać,
         to zagęszczenie wpisów, nie sama siatka. -->
    <Style Selector="Border.komorka">
      <Setter Property="BorderBrush" Value="{DynamicResource Krawedz}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Padding" Value="4" />

      <!-- Bez najmniejszej wysokości: tę ustala okno, dzieląc swoją między tygodnie.
           Wpisana tutaj wygrywałaby z podziałem i wracałoby przewijanie.

           Przycięcie, bo przy sześciu tygodniach na telefonie komórka bywa niższa niż
           jej treść. Wylewająca się nazwa weszłaby na sąsiedni tydzień i byłoby to
           gorsze niż nazwa ucięta w połowie — ucięta wygląda na uciętą. -->
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Dni sąsiednich miesięcy zostają, tylko przygaszone: tydzień na przełomie jest
         tygodniem, a wycięcie z niego trzech dni robi dziurę tam, gdzie jej nie ma. -->
    <Style Selector="Border.komorka.obcy">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Dzisiaj obrysem, nie wypełnieniem — inaczej przykrywałoby własną treść. -->
    <Style Selector="Border.komorka.dzisiaj">
      <Setter Property="BorderBrush" Value="{DynamicResource Blekit}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="TextBlock.numer">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Karta, która na wąskim ekranie przestaje być kartą. -->
    <Style Selector="Border.pelny">
      <Setter Property="MaxWidth" Value="Infinity" />
      <Setter Property="MaxHeight" Value="Infinity" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ToggleButton.day">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
  </UserControl.Styles>

  <!-- Nazwa, bo klawiatura ekranowa dopisuje mu wyściółkę od dołu. Zob. PodepnijKlawiature. -->
  <Grid x:Name="Korzen" Background="{DynamicResource Tlo}">
  <DockPanel Margin="12">

    <!-- Nawigacja z boku, nie u góry.
         Rząd przycisków nad treścią zabierał pas na całą szerokość okna po to, żeby
         pomieścić trzynaście pozycji, a przy węższym oknie zawijał się na dwa rzędy
         i odsuwał kalendarz jeszcze niżej. Z boku lista rośnie w dół, gdzie miejsca
         jest pod dostatkiem, a treść dostaje całą wysokość okna.

         Dokowany jako **pierwszy**, przed paskami odmowy i przypomnień: te dotyczą
         tego, co się właśnie robi, więc mają stać nad treścią, a nie nad wszystkim
         razem z nawigacją.

         Sto osiemdziesiąt sześć punktów, nie dwieście z okładem: pasek zabiera je
         kalendarzowi na stałe, a tydzień potrzebuje siedmiu kolumn po dziewięćdziesiąt
         sześć. Przy oknie węższym niż mniej więcej tysiąc punktów siatka i tak zacznie
         się przewijać w bok — dlatego węższego paska nie da się tu wymienić na
         wygodniejszy, tylko na mniej ciasny. -->
    <!-- Pasek wychodzi poza wewnętrzny margines okna, żeby dotykał jego krawędzi.
         Oprawa nawigacji odcięta z trzech stron paskiem tła wygląda jak kolejna
         karta z treścią, a nie jak bok aplikacji. -->
    <Border DockPanel.Dock="Left" Width="186" Margin="-12,-12,12,-12" Padding="12,12,8,12"
            Background="{DynamicResource TloBoczne}"
            BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Krawedz}"
            IsVisible="{Binding ShowWideNav}">
      <DockPanel>

        <!-- Znak i nazwa u góry paska: to jest miejsce, w którym oko ląduje najpierw,
             i jedyne, gdzie ikona aplikacji ma szansę cokolwiek znaczyć. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="9"
                    Margin="6,2,0,14">
          <Image Source="/Assets/marshal.png" Width="22" Height="22"
                 VerticalAlignment="Center" />
          <TextBlock Text="Marshal" FontWeight="SemiBold" FontSize="16"
                     VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <!-- Kalendarz pierwszy. Jest ekranem, na którym schodzi najwięcej czasu,
                 a stał ósmy — czyli pod czterema listami, do których zagląda się
                 raz dziennie, i pod przeglądem, do którego raz w tygodniu. -->
            <Button Classes="boczny" Classes.wybrany="{Binding IsCalendar}"
                    Command="{Binding ShowCalendarCommand}" Content="Kalendarz" />
            <Button Classes="boczny" Classes.wybrany="{Binding IsToday}"
                    Command="{Binding ShowTodayCommand}" Content="Dzisiaj" />
            <Button Classes="boczny" Classes.wybrany="{Binding IsNow}"
                    Command="{Binding ShowNowCommand}" Content="Teraz" />
            <Button Classes="boczny" Classes.wybrany="{Binding IsInbox}"
                    Command="{Binding ShowInboxCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Skrzynka" />
                <Border Background="{DynamicResource Odznaka}" CornerRadius="9" Padding="7,1"
                        IsVisible="{Binding HasInbox}">
                  <TextBlock Text="{Binding InboxCount}" FontSize="12" />
                </Border>
              </StackPanel>
            </Button>
            <Button Classes="boczny" Classes.wybrany="{Binding IsNext}"
                    Command="{Binding ShowNextCommand}" Content="Następne" />
            <Button Classes="boczny" Classes.wybrany="{Binding IsProjects}"
                    Command="{Binding ShowProjectsCommand}" Content="Obszary i projekty" />
            <Button Classes="boczny" Classes.wybrany="{Binding IsSomeday}"
                    Command="{Binding ShowSomedayCommand}" Content="Kiedyś" />
            <Button Classes="boczny" Classes.wybrany="{Binding IsWaiting}"
                    Command="{Binding ShowWaitingCommand}" Content="Oczekiwane" />
            <Button Classes="boczny" Classes.wybrany="{Binding IsReview}"
                    Command="{Binding ShowReviewCommand}" Content="Przegląd" />
            <Button Classes="boczny" Classes.wybrany="{Binding IsNotes}"
                    Command="{Binding ShowNotesCommand}" Content="Notatki" />
            <Button Classes="boczny" Classes.wybrany="{Binding IsFilters}"
                    Command="{Binding ShowFiltersCommand}" Content="Filtry" />
            <Button Classes="boczny" Classes.wybrany="{Binding IsArchive}"
                    Command="{Binding ShowArchiveCommand}" Content="Archiwum" />
            <Button Classes="boczny" Classes.wybrany="{Binding IsSettings}"
                    Command="{Binding ShowSettingsCommand}" Content="Ustawienia" />
            <Button Classes="boczny" Classes.wybrany="{Binding IsJournal}"
                    Command="{Binding ShowJournalCommand}" Content="Co się działo" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>


    <!-- Odmowa, która nie miała gdzie się pokazać. Jeden pasek na całe okno, bo
         kliknięcie bez skutku zdarza się na każdym ekranie, a ramka z wyjaśnieniem
         stała tylko na jednym. -->
    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="14,10" CornerRadius="8"
            Background="{DynamicResource TloOstrzezenia}"
            IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="rozumiem" Padding="10,4" Margin="10,0,0,0"
                VerticalAlignment="Top" Command="{Binding DismissNoticeCommand}" />
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Pasek dolny (wąskie okno). Cztery ekrany dnia codziennego pod kciukiem plus
         „Więcej" na resztę. Wybór czwórki nie jest dowolny: Kalendarz jest ekranem
         startowym i jedyną rzeczą z godziną, Dzisiaj mówi, co obiecane, Teraz
         odpowiada na „co robić", a Skrzynka jest jedynym miejscem, które rośnie samo.
         Reszta to ekrany, do których siada się świadomie, a nie zagląda między jednym
         a drugim.

         Kolejność i podświetlenie wybranego takie samo jak w pasku bocznym: to jest
         ta sama nawigacja na węższym ekranie, a nie druga, której trzeba się uczyć
         od nowa. -->
    <Border DockPanel.Dock="Bottom" IsVisible="{Binding ShowBottomNav}"
            Margin="-12,8,-12,-12" Padding="4,0,4,2" Background="{DynamicResource TloBoczne}">
      <!-- Kolumny „Auto” z gwiazdkami pomiędzy: zakładka jest szeroka na swoją
           treść, a nadmiar szerokości rozchodzi się po przerwach. Skrajne przerwy
           są o połowę węższe, żeby brzegi paska nie odstawały od środka. -->
      <Grid ColumnDefinitions="0.5*,Auto,*,Auto,*,Auto,*,Auto,*,Auto,0.5*">
        <Button Grid.Column="1" Classes="tab" Classes.wybrany="{Binding IsCalendar}"
                Content="Kalendarz" Command="{Binding ShowCalendarCommand}" />
        <Button Grid.Column="3" Classes="tab" Classes.wybrany="{Binding IsToday}"
                Content="Dzisiaj" Command="{Binding ShowTodayCommand}" />
        <Button Grid.Column="5" Classes="tab" Classes.wybrany="{Binding IsNow}"
                Content="Teraz" Command="{Binding ShowNowCommand}" />
        <Button Grid.Column="7" Classes="tab" Classes.wybrany="{Binding IsInbox}"
                Command="{Binding ShowInboxCommand}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="Skrzynka" VerticalAlignment="Center" />
            <!-- Liczba tylko wtedy, gdy jest niezerowa, i bez czerwieni (spec 11.1).
                 Krążek ma swoje minimum szerokości, żeby jedno- i dwucyfrowa liczba
                 wyglądały tak samo. -->
            <Border Background="{DynamicResource Odznaka}" CornerRadius="9" Padding="5,1"
                    MinWidth="18" VerticalAlignment="Center" IsVisible="{Binding HasInbox}">
              <TextBlock Text="{Binding InboxCount}" FontSize="11"
                         TextAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>
        </Button>
        <Button Grid.Column="9" Classes="tab" Classes.wybrany="{Binding IsMoreOpen}"
                Content="Więcej" Command="{Binding ToggleMoreCommand}" />
      </Grid>
    </Border>

    <!-- Wrzut na dole, nad paskiem. Na telefonie to jest miejsce, w którym stoi kciuk
         i nad którym otwiera się klawiatura; na górze ekranu pole do pisania każe
         sięgać przez cały ekran. Na pulpicie różnicy nie ma, więc jeden układ. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                IsVisible="{Binding ShowCapture}">
      <!-- Przycisk obok pola, nie sam Enter. Na klawiaturze ekranowej Androida klawisz
           w prawym dolnym rogu bywa czym innym w każdej klawiaturze — raz to „gotowe",
           raz nowa linia, raz emotikona — a pole bez przycisku daje się wypełnić
           i nie daje się zatwierdzić. Napis w polu obiecywał przy tym Enter, którego
           tam po prostu nie ma.

           Przycisk także na pulpicie, choć tam Enter działa: dwa różne układy tego
           samego pola znaczyłyby, że instrukcja i zrzut ekranu pasują do jednej
           platformy, a wrzut jest czynnością, którą robi się najczęściej ze wszystkich. -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" Text="{Binding CaptureText}"
                 Watermark="Wrzuć myśl"
                 FontSize="16"
                 AcceptsReturn="False">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding CaptureCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <Button Grid.Column="1" Classes="nav glowny" Margin="6,0,0,0"
                VerticalAlignment="Stretch"
                Command="{Binding CaptureCommand}" Content="Wrzuć" />
      </Grid>
      <TextBlock Classes="hint" Margin="2,4,0,0" IsVisible="{Binding ShowWideNav}"
                 Text="Bez pól, bez decyzji — obszar i reszta dochodzą przy przetwarzaniu. Enter też wrzuca." />
    </StackPanel>

    <!-- Ekrany leżą na sobie w jednej komórce; widoczny jest zawsze jeden. -->
    <Grid>

    <!-- Skrzynka -->
    <DockPanel IsVisible="{Binding IsInbox}">
      <Button DockPanel.Dock="Bottom" Margin="0,12,0,0"
              HorizontalAlignment="Stretch" Padding="14,12"
              Classes="glowny"
              Command="{Binding ShowClarifyCommand}"
              IsEnabled="{Binding HasInbox}"
              Content="Przetwórz skrzynkę" />
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                 Text="Przetwarzanie pokazuje jedną pozycję naraz." />
      <!-- Dwuklik otwiera szczegół. Do dziś jedyną drogą do wrzutu było przetwarzanie,
           więc dopisanie godziny do myśli, która już leży w skrzynce, wymagało przejścia
           przez całe drzewko decyzji. -->
      <ListBox ItemsSource="{Binding InboxItems}" DoubleTapped="OtworzZListy">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="tasks:TaskItem">
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Padding="0,4" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Przetwarzanie: jedna pozycja, bez listy w tle -->
    <!-- Widoczność i podmiana kontekstu muszą siedzieć na różnych elementach:
         DataContext ustawiony na elemencie obowiązuje też dla pozostałych powiązań
         na tym samym elemencie, więc IsVisible szukałoby właściwości w modelu
         przetwarzania zamiast w głównym. -->
    <Panel IsVisible="{Binding IsClarify}">
    <ScrollViewer DataContext="{Binding Clarify}">
      <StackPanel MaxWidth="560" HorizontalAlignment="Center"
                  x:DataType="vm:ClarifyViewModel">

        <!-- Wyjście z przetwarzania. Do dziś nie było stąd żadnej drogi na ekrany:
             pasek nawigacji jest w tym widoku schowany, żeby decyzja nie konkurowała
             z resztą aplikacji — ale „nie konkuruje" nie znaczy „nie da się wyjść". -->
        <Grid ColumnDefinitions="Auto,*">
          <!-- Z powrotem do skrzynki, nie na kalendarz: przetwarzanie zaczyna się
               w skrzynce i przerwanie go w połowie znaczy „wracam do reszty wrzutów",
               a nie „chcę teraz obejrzeć tydzień". -->
          <Button Grid.Column="0" Classes="nav" Content="◀ wyjdź"
                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowInboxCommand}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Przewijanie kolejki bez rozstrzygania. Wrzut, którego akurat nie da się
                 rozstrzygnąć, blokował całą resztę i kończyło się zamknięciem ekranu. -->
            <Button Classes="nav" Content="◀" Padding="10,4" Margin="0"
                    Command="{Binding BackCommand}" IsVisible="{Binding CanMove}" />
            <TextBlock Classes="hint" VerticalAlignment="Center"
                       Text="{Binding Remaining, StringFormat='Do rozstrzygnięcia: {0}'}" />
            <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding Position}"
                       IsVisible="{Binding CanMove}" />
            <Button Classes="nav" Content="▶" Padding="10,4" Margin="0"
                    Command="{Binding SkipCommand}" IsVisible="{Binding CanMove}" />
          </StackPanel>
        </Grid>

        <Border Margin="0,12,0,20" Padding="20" CornerRadius="8" Background="{DynamicResource Panel}">
          <TextBlock Text="{Binding Current.Title}" FontSize="22" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="Miejsce — obszar albo projekt w nim" Classes="hint" />
        <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}"
                  HorizontalAlignment="Stretch" Margin="0,4,0,16">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PlacementChoice">
              <StackPanel Orientation="Horizontal">
                <Border Width="{Binding Indent}" />
                <TextBlock Text="{Binding Label}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Długość i siły pytane tutaj, przy decyzji: ekran „Teraz" dobiera pod
             dostępne minuty i poziom sił, więc zadanie bez oszacowania nie trafia tam
             nigdy. Dotąd dało się to wpisać tylko w szczegółach — czyli trzeba było
             przetworzyć skrzynkę, znaleźć zadanie na liście i otworzyć je jeszcze raz.
             Myśl jest najświeższa właśnie teraz. -->
        <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
          <StackPanel Grid.Column="0" Margin="0,0,6,0">
            <TextBlock Text="Ile to zajmie (minuty)" Classes="hint" />
            <NumericUpDown Value="{Binding EstimatedMinutes}" Minimum="1" Maximum="600"
                           Increment="5" FormatString="0" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <TextBlock Text="Ile trzeba mieć w sobie" Classes="hint" />
            <ComboBox ItemsSource="{Binding Energies}" SelectedItem="{Binding SelectedEnergy}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
        <TextBlock Classes="hint" Margin="2,0,0,16" TextWrapping="Wrap"
                   Text="{Binding EstimateHint}" />

        <TextBlock Text="Nie wymaga działania" Classes="hint" Margin="0,0,0,6" />
        <Button Classes="branch" Command="{Binding TrashCommand}" Content="Kosz" />
        <Button Classes="branch" Command="{Binding SomedayCommand}" Content="Kiedyś-może" />
        <Button Classes="branch" Command="{Binding ToNoteCommand}" Content="Materiał referencyjny (notatka)" />

        <TextBlock Text="Wymaga działania" Classes="hint" Margin="0,14,0,6" />
        <Button Classes="branch" Command="{Binding DoNowCommand}"
                Content="Zrobione teraz (krócej niż dwie minuty)" />
        <Button Classes="branch" Command="{Binding TodayCommand}" Content="Robię to dzisiaj" />
        <!-- Nazwa mówi, dokąd to trafia, a nie jak się nazywa w metodzie. „Następna
             akcja" jest pojęciem z książki i nie niesie żadnej informacji komuś, kto
             właśnie stoi przed wyborem. -->
        <Button Classes="branch" Command="{Binding MakeNextCommand}"
                Content="Na listę do zrobienia — bez konkretnego dnia" />
        <TextBlock Classes="hint" Margin="2,0,0,4" TextWrapping="Wrap"
                   Text="Pierwsze trafia od razu do piątki na dziś. Drugie zostaje na liście „Następne” i wypływa w „Teraz”, gdy pasuje do czasu i sił. „Zaplanuj” niżej stawia zadanie na konkretnym dniu kalendarza." />

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBox Grid.Column="0" Text="{Binding WaitingForWho}" Watermark="Na kogo czekasz?" />
          <Button Grid.Column="1" Margin="6,0,0,0" Padding="14,10"
                  Command="{Binding DelegateCommand}" Content="Oczekiwane" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <k:WyborDaty Grid.Column="0" Wartosc="{Binding ScheduledFor}" />
          <Button Grid.Column="1" Margin="6,0,0,0" Padding="14,10"
                  Command="{Binding ScheduleCommand}" Content="Zaplanuj" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding ProjectOutcome}"
                   Watermark="Po czym poznasz, że to skończone?" />
          <Button Grid.Column="1" Margin="6,0,0,0" Padding="14,10"
                  Command="{Binding PromoteToProjectCommand}" Content="To projekt" />
        </Grid>
        <TextBlock Classes="hint" Margin="2,4,0,0"
                   Text="Projekt nazywa się wynikiem, nie czynnością." />

        <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource Ostrzezenie}" Margin="0,16,0,0"
                   TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
      </StackPanel>
    </ScrollViewer>
    </Panel>

    <!-- Następne akcje -->
    <ListBox IsVisible="{Binding IsNext}" ItemsSource="{Binding NextActions}" DoubleTapped="OtworzZListy">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TaskRow">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
              <TextBlock Classes="badge" Text="{Binding Badges}" TextWrapping="Wrap"
                         IsVisible="{Binding HasBadges}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Szczegół" Padding="10,4" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenCommand}"
                    CommandParameter="{Binding}" />
            <Button Grid.Column="2" Content="Zrobione" Padding="10,4"
                    VerticalAlignment="Center"
                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).CompleteCommand}"
                    CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Dzisiaj -->
    <DockPanel IsVisible="{Binding IsToday}">
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                 Text="Zadania na dziś i po terminie. Terminy pierwsze — to fakt zewnętrzny, nie decyzja." />

      <!-- Pięć slotów wyboru na dziś (8.6). To nie to samo co dzień wykonania:
           dzień wykonania może mieć dwadzieścia zadań, a to jest te pięć, na które
           się piszesz. -->
      <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="14,12" CornerRadius="8"
              Background="{DynamicResource Panel}">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Na dziś" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Classes="hint" Text="{Binding FocusCount}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding FocusItems}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="tasks:TaskItem">
                <!-- Wiersz zadania w oprawie. Bez niej tytuł zadania i zdanie
                     wyjaśniające pod listą były tym samym napisem tej samej wielkości
                     i nie dało się poznać, w co można kliknąć. -->
                <Border Classes="wiersz" Margin="0,3">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="zrobione" Padding="10,4"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CompleteTaskCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="zdejmij" Padding="10,4"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).UnfocusCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Szósty nie wchodzi, dopóki coś nie zejdzie. Limit działa bez oporu,
               bo dotyczy jednego dnia i zeruje się co dobę (8.6). -->
          <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource Panel}"
                  IsVisible="{Binding HasPendingFocus}">
            <StackPanel Spacing="6">
              <TextBlock TextWrapping="Wrap">
                <Run Text="Pięć slotów jest zajętych. Co schodzi, żeby weszło:" />
                <Run Text="{Binding PendingFocus.Title}" FontWeight="SemiBold" />
                <Run Text="?" />
              </TextBlock>
              <Button Content="jednak nie" Padding="10,4" HorizontalAlignment="Left"
                      Command="{Binding CancelPendingFocusCommand}" />
            </StackPanel>
          </Border>

          <!-- Kandydaci: „Następne" i zaplanowane na dziś lub wcześniej (8.6).
               Nie to samo co lista poniżej — większość następnych akcji nie ma daty
               wykonania i bez tego miejsca nie dałoby się ich w ogóle wybrać. -->
          <StackPanel IsVisible="{Binding !FocusIsFull}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="label" Text="Do wyboru" />
              <!-- Granica „kiedyś-może" zostaje, ale da się ją przekroczyć świadomie.
                   Zadanie z dopisaną długością i siłą jest już opisane jak rzecz do
                   zrobienia, a mimo to nie dawało się go stąd wybrać w ogóle. -->
              <CheckBox Grid.Column="1" IsChecked="{Binding AlsoSomeday}"
                        Content="także z „Kiedyś”" FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer MaxHeight="220">
              <ItemsControl ItemsSource="{Binding FocusCandidates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TaskRow">
                    <Border Classes="wiersz" Margin="0,3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap"
                                 VerticalAlignment="Center" Opacity="0.8" />
                      <Button Grid.Column="1" Content="na dziś" Padding="10,4"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).FocusCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <TextBlock Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Niewykonany wybór po prostu wygasa o północy. Bez podsumowania i bez oceny." />
        </StackPanel>
      </Border>

      <!-- N1 i N3 trafiają tutaj, bo są sprawami na dziś. Cisza obszarów (N10) nigdy —
           to nie jest sprawa na dziś, a codzienne przypominanie zamieniłoby ją w szum. -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">

        <Border Padding="12,10" CornerRadius="8" Background="{DynamicResource Panel}"
                IsVisible="{Binding HasNudges}">
          <StackPanel>
            <TextBlock Text="Do ponaglenia" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Nudges}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rev:WaitingItem">
                  <TextBlock Margin="0,2" TextWrapping="Wrap">
                    <Run Text="{Binding Task.Title}" />
                    <Run Text=" — " />
                    <Run Text="{Binding Who}" />
                    <Run Text=", " />
                    <Run Text="{Binding Days}" />
                    <Run Text=" dni" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource Panel}"
                IsVisible="{Binding HasBlocked}">
          <StackPanel>
            <TextBlock Text="Projekty bez następnej akcji" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding BlockedProjects}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rev:BlockedProject">
                  <TextBlock Margin="0,2" TextWrapping="Wrap">
                    <Run Text="{Binding Outcome}" />
                    <Run Text=" · " />
                    <Run Text="{Binding AreaName}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
      <TextBlock Classes="hint" Margin="2,4,0,0" IsVisible="{Binding !HasToday}"
                 Text="Na dziś nic nie ma terminu ani dnia wykonania. To jest poprawny stan, nie pusty ekran." />
      <ListBox ItemsSource="{Binding TodayItems}" IsVisible="{Binding HasToday}" DoubleTapped="OtworzZListy">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TaskRow">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
              <StackPanel Grid.Column="0" VerticalAlignment="Center"
                          Opacity="{Binding Opacity}">
                <TextBlock TextWrapping="Wrap">
                  <Run Text="{Binding Mark}" />
                  <Run Text="{Binding Title}" />
                </TextBlock>
                <TextBlock Classes="badge" Text="{Binding Badges}" TextWrapping="Wrap"
                           IsVisible="{Binding HasBadges}" />
              </StackPanel>
              <Button Grid.Column="1" Content="na dziś" Padding="10,4" Margin="0,0,6,0"
                      IsVisible="{Binding !IsDone}"
                      VerticalAlignment="Center"
                      Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).FocusCommand}"
                      CommandParameter="{Binding}" />
              <Button Grid.Column="2" Content="Zrobione" Padding="10,4"
                      VerticalAlignment="Center" IsVisible="{Binding !IsDone}"
                      Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).CompleteCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Kiedyś-może -->
    <DockPanel IsVisible="{Binding IsSomeday}">
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                 TextWrapping="Wrap"
                 Text="Bez presji i bez terminu. Wraca, gdy dojrzeje. Prawy przycisk na pozycji — „Weź na dziś” wyjmuje ją stąd i robi z niej następną akcję." />
      <ListBox ItemsSource="{Binding SomedayItems}" DoubleTapped="OtworzZListy">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="tasks:TaskItem">
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Padding="0,4" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Teraz: odpowiedź na jedno pytanie, nie lista (8.1) -->
    <DockPanel IsVisible="{Binding IsNow}">
      <StackPanel DockPanel.Dock="Top" DataContext="{Binding Now}"
                  x:DataType="vm:NowViewModel" Margin="0,0,0,12">

        <TextBlock Classes="label" Text="Ile masz czasu" />
        <ComboBox ItemsSource="{Binding Minutes}" SelectedItem="{Binding SelectedMinutes}"
                  HorizontalAlignment="Stretch" />

        <TextBlock Classes="label" Text="Ile masz siły" />
        <ComboBox ItemsSource="{Binding Energies}" SelectedItem="{Binding SelectedEnergy}"
                  HorizontalAlignment="Stretch" />
        <TextBlock Classes="hint" Margin="2,4,0,0"
                   Text="Podpowiedziane z pory dnia. Do nadpisania jednym kliknięciem." />

        <!-- „Kiedyś-może" jest z założenia poza systemem rzeczy do zrobienia i dlatego
             ten ekran go nie rusza. Ale zadanie, któremu dopisano długość i siłę, jest
             już opisane tak jak rzecz do zrobienia — i odmowa pokazania go, gdy pyta
             się wprost, byłaby upieraniem się przy metodzie wbrew człowiekowi. -->
        <CheckBox IsChecked="{Binding AlsoSomeday}" Margin="0,10,0,0"
                  Content="sięgnij też do „Kiedyś”" />

        <!-- Pusty ekran z komunikatem „nic nie pasuje" byłby prawdą bezużyteczną.
             Zamiast niego mikrozadanie, które samo się rozwiązuje w miarę używania. -->
        <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource Panel}"
                IsVisible="{Binding SuggestEstimating}">
          <TextBlock Text="{Binding EstimatePrompt}" TextWrapping="Wrap" />
        </Border>

      </StackPanel>

      <ScrollViewer DataContext="{Binding Now}">
        <ItemsControl ItemsSource="{Binding Picks}" x:DataType="vm:NowViewModel"
                      DoubleTapped="OtworzZListy">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="uc:NowPick">
              <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="8" Background="{DynamicResource Panel}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Task.Title}" TextWrapping="Wrap" FontSize="15" />
                    <!-- Powód jest częścią odpowiedzi, nie ozdobnikiem: lista bez
                         uzasadnienia każe wierzyć na słowo, a wtedy pierwszy chybiony
                         wybór odbiera jej zaufanie w całości. -->
                    <TextBlock Classes="badge" TextWrapping="Wrap">
                      <Run Text="{Binding Reason}" />
                      <Run Text=" · " />
                      <Run Text="{Binding Task.EstimatedMinutes}" />
                      <Run Text=" min" />
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Zrobione" Padding="12,6"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:NowViewModel)DataContext).CompleteCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Kalendarz godzinowy (spec 11). Wydarzenia pełne, zadania półprzezroczyste:
         umowa z kimś i zamiar wobec siebie nie mogą wyglądać tak samo. -->
    <!-- Widoczność i podmiana kontekstu na osobnych elementach. DataContext ustawiony
         na elemencie obowiązuje też dla pozostałych powiązań tego elementu, więc
         IsVisible szukałoby właściwości w modelu kalendarza zamiast w głównym. -->
    <Panel IsVisible="{Binding IsCalendar}">
    <!-- Przycinane do swoich granic: siatka przesuwa się w bok razem z podglądami
         sąsiednich zakresów, a nieprzycięte wyjeżdżałyby na nagłówki dni i na pasek
         nawigacji. Przycięcie na rodzicu, nie na samej siatce — to ona się rusza. -->
    <DockPanel DataContext="{Binding Calendar}" ClipToBounds="True">

      <StackPanel DockPanel.Dock="Top" x:DataType="vm:CalendarViewModel" Margin="0,0,0,10">
        <!-- Jeden rząd: gdzie jesteśmy, jak szeroko patrzymy, skąd bierzemy. Zakres
             stał wcześniej w osobnym rzędzie, w czterech równych kolumnach rozciągniętych
             na całą szerokość — cztery pola wielkości dłoni na jedną decyzję. Teraz
             mieści się w tej samej linii, co reszta, a czym dokładnie jest, rozstrzyga
             szerokość okna. -->
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
          <Button Grid.Column="0" Classes="nav" Command="{Binding PreviousCommand}" Content="◀" />
          <Button Grid.Column="1" Classes="nav" Command="{Binding TodayCommand}" Content="dziś" />
          <Button Grid.Column="2" Classes="nav" Command="{Binding NextCommand}" Content="▶" />
          <!-- Jedna komórka, dwie odpowiedzi na to, ile jest miejsca. Na szerokim
               oknie cztery przyciski: widać naraz, jakie są możliwości i który zakres
               jest teraz. Na telefonie stoją w tej linii strzałki i pobieranie, więc
               zostaje pole wyboru — mówi to samo jednym słowem. -->
          <Panel Grid.Column="3" Margin="6,0">
            <StackPanel Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        IsVisible="{Binding ShowRangeButtons}">
              <Button Classes="nav" Command="{Binding ShowDayCommand}" Content="dzień" />
              <Button Classes="nav" Command="{Binding ShowThreeDaysCommand}" Content="3 dni" />
              <Button Classes="nav" Command="{Binding ShowWeekCommand}" Content="tydzień" />
              <Button Classes="nav" Command="{Binding ShowMonthCommand}" Content="miesiąc" />
            </StackPanel>

            <ComboBox MinWidth="0" HorizontalAlignment="Stretch"
                      IsVisible="{Binding ShowRangePicker}"
                      ItemsSource="{Binding Zakresy}"
                      SelectedItem="{Binding Zakres}" />
          </Panel>
          <Button Grid.Column="4" Classes="nav" Command="{Binding FetchCommand}" Content="Pobierz" />
        </Grid>
        <TextBlock Classes="hint" Margin="2,6,0,0" Text="{Binding Range}" />
        <!-- Pusta siatka ma trzy przyczyny wyglądające tak samo. Ta linijka je rozdziela.
             Na telefonie schowana: to linijka do diagnozy, a tam zabiera dwa wiersze nad
             kalendarzem i odpowiada na pytanie, którego się przy telefonie nie zadaje. -->
        <TextBlock Classes="hint" Margin="2,2,0,0" Text="{Binding Summary}"
                   IsVisible="{Binding ShowSummary}" />
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />

        <!-- Cofnięcie po przeniesieniu wydarzenia. Przy zapisie do cudzego kalendarza
             nie jest wygodą, tylko jedyną odpowiedzią na omsknięcie ręki. -->
        <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource Panel}"
                IsVisible="{Binding CanUndo}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Classes="hint" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="{Binding UndoText}" />
            <Button Grid.Column="1" Classes="nav" Content="Cofnij"
                    Command="{Binding UndoMoveCommand}" />
            <Button Grid.Column="2" Classes="nav" Content="Zostaw"
                    Command="{Binding ForgetUndoCommand}" />
          </Grid>
        </Border>
      </StackPanel>

      <!-- Nagłówki dni zakotwiczone nad siatką, a nie w niej.
           Wewnątrz przewijanej siatki uciekały do góry przy pierwszym obrocie kółka
           i po kilku godzinach dnia nie było już wiadomo, na którą kolumnę się patrzy.
           Osobny widok przewijany w poziomie razem z siatką: kolumny mogą być szersze
           niż okno przy bardzo wąskim oknie, a nagłówek rozjechany z kolumną byłby
           gorszy od nagłówka, który ucieka. -->
      <ScrollViewer x:Name="NaglowkiDni" DockPanel.Dock="Top" x:DataType="vm:CalendarViewModel"
                    HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    Margin="0,0,0,4" IsVisible="{Binding !IsMonth}">
        <StackPanel Orientation="Horizontal">
          <Border Width="52" />
          <ItemsControl ItemsSource="{Binding Columns}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CalendarColumn">
                <StackPanel Margin="0,0,2,0"
                            Width="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).ColumnWidth}">

                  <Border CornerRadius="10" Padding="10,2" Margin="0,0,0,4"
                          HorizontalAlignment="Center"
                          Classes.dzis="{Binding IsToday}">
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Opacity="0.7" />
                  </Border>

                  <!-- Pasek całodniowy nad siatką, nie w niej: wydarzenie bez godziny
                       umieszczone o północy kłamałoby o porze. Po jednej rzeczy na
                       wiersz: dwie obok siebie zostawiały z każdej po pięć znaków
                       i kropki. Wysokość wspólna dla wszystkich kolumn, żeby pasmo
                       miało prostą dolną krawędź, a nie schodkową. -->
                  <Border CornerRadius="4" Background="{DynamicResource Panel}"
                          Height="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).AllDayHeight}"
                          IsVisible="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).HasAnyAllDay}">
                    <ItemsControl ItemsSource="{Binding AllDay}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AllDayBox">
                          <Button Classes="slot" Padding="6,2" Margin="0,0,0,1"
                                  Height="23" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  VerticalContentAlignment="Center"
                                  Background="{DynamicResource Panel}"
                                  Click="OtworzCalodniowe" Tag="{Binding}">
                            <TextBlock Text="{Binding Label}" FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <!-- Odstęp, gdy nic całodniowego nie ma w żadnym dniu: siatka nie ma
                       się wtedy podnosić pod same nazwy dni. -->
                  <Border Height="24"
                          IsVisible="{Binding !$parent[ItemsControl].((vm:CalendarViewModel)DataContext).HasAnyAllDay}" />

                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Siatka godzinowa i siatka miesiąca w jednym miejscu: to dwie odpowiedzi na
           to samo pytanie, pokazywane na przemian. Rozdzielone na dwoje rodzeństwa
           w tym samym panelu, bo miesiąc nie ma godzin, kolumn ani paska całodniowego
           i wciśnięty w tamtą siatkę musiałby udawać jej szczególny przypadek. -->
      <Panel x:Name="ObszarKalendarza" Loaded="ObszarKalendarzaGotowy">

      <!-- Sąsiednie zakresy, widoczne wyłącznie w trakcie przejechania palcem.
           Stoją w tym samym panelu, co siatka, przesunięte o szerokość okna w lewo
           i w prawo — panel przesuwa się w całości, więc jadą razem z nią i palec
           odsłania to, co naprawdę jest obok, zamiast pustego tła.

           Obrazek, nie druga siatka: nie da się w nich niczego dotknąć. Interaktywna
           jest zawsze ta jedna, na której się stoi — inaczej każde odhaczenie
           i każde przeciągnięcie bloku musiałoby wiedzieć, do której z trzech siatek
           należy, a to jest ten rodzaj wiedzy, który potem zostaje wszędzie.
           Rysowane przed siatką, żeby przy zaokrągleniach to ona była na wierzchu. -->
      <Panel x:Name="PodgladPrzed" IsVisible="False" IsHitTestVisible="False"
             x:DataType="vm:CalendarViewModel">

        <ScrollViewer IsVisible="{Binding !IsMonth}"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
          <StackPanel Orientation="Horizontal">
            <StackPanel Width="52">
              <ItemsControl ItemsSource="{Binding HourLabels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Height="48">
                      <TextBlock Classes="godzina" Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding KolumnyPrzed}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarColumn">
                  <Panel Margin="0,0,2,0">
                    <ItemsControl ItemsSource="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).HourLabels}"
                                  Width="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).ColumnWidth}"
                                  Background="{DynamicResource PoleSlabe}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Border Height="48" BorderThickness="0,1,1,0"
                                  BorderBrush="{DynamicResource Krawedz}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Slots}"
                                  Height="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).GridHeight}"
                                  Width="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).ColumnWidth}"
                                  Background="{x:Null}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter" x:DataType="vm:SlotBox">
                          <Setter Property="Canvas.Top" Value="{Binding Top}" />
                          <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        </ControlTheme>
                      </ItemsControl.ItemContainerTheme>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SlotBox">
                          <Border Classes="slot" Width="{Binding Width}" Height="{Binding Height}"
                                  Opacity="{Binding Opacity}" Background="{Binding Background}"
                                  CornerRadius="4" Padding="4,2">
                            <TextBlock Text="{Binding Title}" FontSize="11"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <ItemsControl IsVisible="{Binding IsMonth}" ItemsSource="{Binding TygodniePrzed}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MonthWeek">
              <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MonthCell">
                    <Border Classes="komorka" Classes.obcy="{Binding IsOtherMonth}"
                            Classes.dzisiaj="{Binding IsToday}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="numer" Text="{Binding Day}" />
                        <ItemsControl ItemsSource="{Binding Entries}" VerticalAlignment="Top">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MonthEntry">
                              <Border Background="{Binding Background}" CornerRadius="3"
                                      Padding="3,0" Margin="0,1">
                                <TextBlock FontSize="11" Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>

      <Panel x:Name="PodgladPo" IsVisible="False" IsHitTestVisible="False"
             x:DataType="vm:CalendarViewModel">

        <ScrollViewer IsVisible="{Binding !IsMonth}"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
          <StackPanel Orientation="Horizontal">
            <StackPanel Width="52">
              <ItemsControl ItemsSource="{Binding HourLabels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Height="48">
                      <TextBlock Classes="godzina" Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding KolumnyPo}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarColumn">
                  <Panel Margin="0,0,2,0">
                    <ItemsControl ItemsSource="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).HourLabels}"
                                  Width="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).ColumnWidth}"
                                  Background="{DynamicResource PoleSlabe}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Border Height="48" BorderThickness="0,1,1,0"
                                  BorderBrush="{DynamicResource Krawedz}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Slots}"
                                  Height="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).GridHeight}"
                                  Width="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).ColumnWidth}"
                                  Background="{x:Null}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter" x:DataType="vm:SlotBox">
                          <Setter Property="Canvas.Top" Value="{Binding Top}" />
                          <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        </ControlTheme>
                      </ItemsControl.ItemContainerTheme>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SlotBox">
                          <Border Classes="slot" Width="{Binding Width}" Height="{Binding Height}"
                                  Opacity="{Binding Opacity}" Background="{Binding Background}"
                                  CornerRadius="4" Padding="4,2">
                            <TextBlock Text="{Binding Title}" FontSize="11"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <ItemsControl IsVisible="{Binding IsMonth}" ItemsSource="{Binding TygodniePo}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MonthWeek">
              <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MonthCell">
                    <Border Classes="komorka" Classes.obcy="{Binding IsOtherMonth}"
                            Classes.dzisiaj="{Binding IsToday}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="numer" Text="{Binding Day}" />
                        <ItemsControl ItemsSource="{Binding Entries}" VerticalAlignment="Top">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MonthEntry">
                              <Border Background="{Binding Background}" CornerRadius="3"
                                      Padding="3,0" Margin="0,1">
                                <TextBlock FontSize="11" Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>

      <ScrollViewer x:Name="SiatkaKalendarza" x:DataType="vm:CalendarViewModel"
                    IsVisible="{Binding !IsMonth}"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Horizontal">

          <!-- Godziny raz, z lewej, żeby nie powtarzać ich przy każdej kolumnie. -->
          <StackPanel Width="52">
            <ItemsControl ItemsSource="{Binding HourLabels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Height="48">
                    <TextBlock Classes="hint" Text="{Binding}" VerticalAlignment="Top" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <ItemsControl Name="KolumnyDni" ItemsSource="{Binding Columns}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CalendarColumn">
                <StackPanel Margin="0,0,2,0">

                  <!-- Rozmiar na liście, nie na płótnie pod nią. Płótno **nie mierzy się
                       swoją zawartością** — jego rozmiar własny to zero — więc lista
                       z płótnem w środku, wstawiona do drugiego płótna, dostawała
                       zero na zero i obcinała wszystko. Całodniowe rysowały się dalej,
                       bo idą zwykłym paskiem nad siatką; godzinowe znikały bez śladu. -->
                  <Panel>

                    <!-- Siatka pod blokami: po jednej linii na godzinę i pionowa
                         krecha na prawej krawędzi kolumny. Bez niej blok wisi
                         w pustce i nie widać, o której się zaczyna. Linie są
                         osobną warstwą, nie tłem bloków, bo mają być widoczne
                         również tam, gdzie nic nie zaplanowano. -->
                    <ItemsControl Name="Godziny" Tag="{Binding Date}"
                                  Loaded="WarstwaGodzinGotowa"
                                  PointerPressed="NowaRzeczNaSiatce"
                                  PointerReleased="SiatkaPuszczona"
                                  PointerCaptureLost="SiatkaPorzucona"
                                  ItemsSource="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).HourLabels}"
                                  Width="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).ColumnWidth}"
                                  Background="{DynamicResource PoleSlabe}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Border Height="48" BorderThickness="0,1,1,0" BorderBrush="{DynamicResource Krawedz}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Slots}"
                                  Height="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).GridHeight}"
                                  Width="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).ColumnWidth}"
                                  Background="{x:Null}">
                      <!-- Tło **puste**, nie przezroczyste. Przezroczyste jest w Avalonii
                           normalnym celem kliknięcia, więc warstwa bloków zjadała każde
                           kliknięcie na całej wysokości kolumny — także w miejscach, gdzie
                           nie ma żadnego bloku. Zakładanie zadania klikiem w pustą siatkę
                           nie działało wcale, bo zdarzenie nigdy nie docierało do warstwy
                           z liniami godzin. Puste tło przepuszcza klik dalej. -->
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter" x:DataType="vm:SlotBox">
                          <Setter Property="Canvas.Top" Value="{Binding Top}" />
                          <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        </ControlTheme>
                      </ItemsControl.ItemContainerTheme>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SlotBox">
                          <!-- Ramka, nie przycisk. Przycisk obsługuje wciśnięcie
                               wskaźnika sam i oznacza je jako załatwione, więc nasze
                               powiadomienia o przeciąganiu **nigdy do nas nie docierały**
                               i blok nie dawał się ruszyć. Kliknięcie rozpoznajemy sami:
                               puszczenie bez przejechania progu. -->
                          <Border Classes="slot" Width="{Binding Width}" Height="{Binding Height}"
                                  Tag="{Binding}"
                                  PointerPressed="BlokWcisniety"
                                  PointerMoved="BlokRuszony"
                                  PointerReleased="BlokPuszczony"
                                  PointerCaptureLost="BlokPuscilWskaznik"
                                  Opacity="{Binding Opacity}"
                                  Background="{Binding Background}" CornerRadius="4" Padding="4,2">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                              <!-- Miejsce na odhaczenie zajęte na stałe, a nie odsłaniane:
                                   pole pojawiające się pod kursorem przesuwałoby tytuł
                                   w chwili najechania. Samo pole jest przezroczyste i
                                   nieklikalne do czasu najechania — niewidoczne, ale
                                   klikalne byłoby gorsze niż jedno i drugie naraz. -->
                              <!-- Bez najechania widać sam ptaszek, po najechaniu pole
                                   wyboru. Odhaczenie mieszka w polu, nie obok nazwy:
                                   ptaszek dopisany do tytułu był napisem, a nie stanem,
                                   i nie dawał się kliknąć.

                                   Na dotyku pola nie ma wcale — zob. SlotBox.ShowCheck.
                                   Zostaje sam ptaszek jako stan, bez oprawy i bez
                                   przyjmowania dotknięć: kwadracik wielkości dziesięciu
                                   punktów leżący na bloku, który się przeciąga
                                   i otwiera, mylił się częściej, niż trafiał. -->
                              <Panel Grid.Column="0" Width="{Binding CheckSize}"
                                     Margin="0,0,3,0"
                                     IsVisible="{Binding ShowMarkColumn}">
                                <Border Classes.odhacz="{Binding ShowCheck}" Tag="{Binding}"
                                        IsHitTestVisible="{Binding ShowCheck}"
                                        Width="{Binding CheckSize}"
                                        Height="{Binding CheckSize}"
                                        VerticalAlignment="Top" HorizontalAlignment="Left"
                                        PointerPressed="OdhaczNaSiatce"
                                        PointerReleased="OdhaczeniePuszczone"
                                        PointerCaptureLost="OdhaczeniePorzucone">
                                  <TextBlock Text="✓" IsVisible="{Binding IsDone}"
                                             FontSize="{Binding MarkSize}"
                                             LineHeight="{Binding CheckSize}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Border>
                              </Panel>

                              <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11"
                                         TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />

                              <!-- Godziny przy prawej krawędzi. Blok pokazuje, ile coś trwa,
                                   ale nie od której — a to jest pierwsze pytanie o wpis. -->
                              <StackPanel Grid.Column="2" Margin="4,0,0,0"
                                          IsVisible="{Binding ShowTimes}">
                                <TextBlock Classes="godzina" Text="{Binding StartText}" />
                                <TextBlock Classes="godzina" Text="{Binding EndText}" />
                              </StackPanel>

                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Bieżąca godzina, tylko na dzisiejszej kolumnie i **nad** blokami.
                         Pod nimi ginęłaby dokładnie wtedy, gdy coś teraz trwa — czyli
                         w jedynym momencie, w którym cokolwiek znaczy. -->
                    <Canvas IsVisible="{Binding IsToday}">
                      <Border Canvas.Top="{Binding NowTop}" Canvas.Left="0" Height="2"
                              Background="{DynamicResource Ostrzezenie}"
                              Width="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).ColumnWidth}" />
                    </Canvas>

                  </Panel>

                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>

      <!-- Miesiąc: cały obrazek bez godzin. Odpowiada na inne pytanie niż siatka
           godzinowa — „gdzie jest gęsto i które dni są puste" — a tego nie widać
           z siedmiu dni naraz.

           Dotknięcie dnia schodzi na jego siatkę godzinową, dotknięcie wpisu otwiera
           zadanie. Wydarzenia z podłączonych kalendarzy nie mają stąd drogi: w komórce
           nie ma miejsca na to, co odróżnia je od zadania, a jeden gest znaczący dwie
           różne rzeczy jest gorszy od gestu, którego nie ma. -->
      <!-- Na całą wysokość, bez przewijania. Miesiąc jest widokiem ogólnym: jego wartość
           bierze się z tego, że widać **cały** naraz — gdzie jest gęsto, a gdzie pusto.
           Miesiąc, po którym trzeba przewijać, przestaje odpowiadać na to pytanie,
           a zaczyna udawać gorszy tydzień.

           Stąd tygodnie w siatce o jednej kolumnie: dzieli ona wysokość równo między
           nie, więc luty z czterema tygodniami ma komórki wyższe niż marzec z sześcioma.
           Wysokość ustala okno, nie treść. -->
      <Grid x:DataType="vm:CalendarViewModel" IsVisible="{Binding IsMonth}"
            RowDefinitions="Auto,*">

          <ItemsControl Grid.Row="0" ItemsSource="{Binding MonthHeaders}" Margin="0,0,0,4">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="hint" Text="{Binding}" HorizontalAlignment="Center" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Wysokość siatki idzie do modelu widoku: z niej wychodzi, ile wpisów mieści
               komórka. Stała czwórka chowała na komputerze rzeczy, na które było miejsce,
               a na telefonie przy sześciu tygodniach przycinała czwartą, której licznik
               nadmiaru już nie policzył. -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding MonthWeeks}"
                        Loaded="SiatkaMiesiacaGotowa">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MonthWeek">
                <ItemsControl ItemsSource="{Binding Cells}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonthCell">
                      <Border Classes="komorka" Classes.obcy="{Binding IsOtherMonth}"
                              Classes.dzisiaj="{Binding IsToday}"
                              PointerReleased="NaDniuMiesiaca">
                        <DockPanel>
                          <!-- Numer dnia i licznik nadmiaru w jednym wierszu u góry:
                               oba są wiadomością o komórce, a nie jej treścią, i oba
                               mają przetrwać przycięcie. -->
                          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Classes="numer" Text="{Binding Day}" />
                            <TextBlock Grid.Column="1" Classes="hint" HorizontalAlignment="Right"
                                       Text="{Binding OverflowLabel}"
                                       IsVisible="{Binding HasOverflow}" />
                          </Grid>

                          <ItemsControl ItemsSource="{Binding Entries}" VerticalAlignment="Top">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MonthEntry">
                                <!-- Tło w barwie obszaru. Miesiąc czyta się wzrokiem,
                                     a nie literami: cztery jednakowe linijki w komórce
                                     nie mówią, czy dzień jest zajęty pracą, czy dziećmi.
                                     Zaokrąglenie i odstęp, żeby sąsiadujące wpisy nie
                                     zlały się w jeden pas. -->
                                <Border Background="{Binding Background}" CornerRadius="3"
                                        Padding="3,0" Margin="0,1"
                                        PointerReleased="NaWpisieMiesiaca">
                                  <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Classes="hint" Margin="0,0,4,0"
                                               FontSize="11"
                                               Text="{Binding Time}" IsVisible="{Binding HasTime}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis" FontSize="11" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

      </Grid>
      </Panel>
    </DockPanel>

    <!-- Kliknięte wydarzenie z podłączonego kalendarza. Własna karta, nie okno szczegółu
         zadania: należy do czegoś innego i ma inne pola. Przeciągnąć da się je wprost
         na siatce; odhaczyć tam tylko na pulpicie, bo na dotyku kwadracik na bloku
         mylił się częściej, niż trafiał. Na telefonie odhacza się stąd. -->
    <!-- Kliknięcie obok karty zamyka ją — tak samo jak przy karcie zadania. Dotąd
         miała to tylko tamta, a że obie wyglądają identycznie i otwierają się tym
         samym dotknięciem, wychodziło z tego „raz działa, raz nie". Różnica nie brała
         się z żadnej decyzji: karta wydarzenia powstała później i zamykania po prostu
         nie dostała. -->
    <Panel DataContext="{Binding Calendar}" IsVisible="{Binding HasOpened}"
           Background="{DynamicResource Zaslona}"
           PointerPressed="TloWydarzenia">
      <Border x:DataType="vm:CalendarViewModel" MaxWidth="480" Margin="12" Padding="20"
              CornerRadius="10" Background="{DynamicResource Karta}" VerticalAlignment="Center"
              PointerPressed="ZatrzymajKlikniecie">
        <StackPanel Spacing="8">

          <Grid ColumnDefinitions="Auto,*">
            <!-- Ptaszek przy nazwie, tak samo jak w oknie zadania. Na pulpicie odhacza
                 się także kwadracikiem na bloku; na telefonie tego kwadracika nie ma
                 i to pole jest jedynym miejscem, bo kartę i tak się otwiera, żeby
                 zobaczyć, o co chodzi. -->
            <CheckBox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                      IsVisible="{Binding CanCompleteOpened}"
                      IsChecked="{Binding Opened.IsDone, Mode=OneWay}"
                      Command="{Binding ToggleOpenedCommand}" />
            <TextBox Grid.Column="1" Text="{Binding OpenedTitle}" FontSize="18"
                     IsEnabled="{Binding CanEditOpened}" />
          </Grid>

          <TextBlock Classes="hint" Text="{Binding Opened.DayText}" />

          <Grid ColumnDefinitions="*,Auto,*">
            <k:WyborGodziny Grid.Column="0" Wartosc="{Binding OpenedStart}"
                            IsEnabled="{Binding CanEditOpened}" />
            <TextBlock Grid.Column="1" Text="–" Margin="8,0" VerticalAlignment="Center" />
            <k:WyborGodziny Grid.Column="2" Wartosc="{Binding OpenedEnd}"
                            IsEnabled="{Binding CanEditOpened}" />
          </Grid>

          <!-- Obszar, czyli to samo pytanie co przy zadaniu: do kogo to należy. Przy
               wydarzeniu odpowiedź nie ma gdzie usiąść po naszej stronie, bo Google nie
               ma pola na obszar — siedzi więc tam, gdzie i tak siedzi, w kalendarzu.
               Zmiana obszaru przekłada wydarzenie do kalendarza tamtego obszaru, a że
               kalendarze udostępnia się w Google raz na zawsze, jest to zarazem jedyna
               potrzebna droga do pokazania komuś pojedynczej rzeczy. -->
          <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0"
                IsVisible="{Binding CanMoveOpened}">
            <TextBlock Grid.Column="0" Text="Obszar" VerticalAlignment="Center"
                       Margin="0,0,8,0" Opacity="0.7" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                      PlaceholderText="bez obszaru"
                      ItemsSource="{Binding ObszaryWydarzenia}"
                      SelectedItem="{Binding ObszarWydarzenia}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="da:Area">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <!-- Pokazanie jednej osobie. To druga z dwóch dróg, którymi Google pokazuje
               komuś coś ze swojego kalendarza, i jedyna działająca na pojedynczej
               rzeczy: udostępniony kalendarz znaczy „ta półka jest nasza wspólna",
               a gość znaczy „spójrz na to jedno". Osoba dostaje zaproszenie i może
               odmówić — wspólny kalendarz nie pyta o nic.

               Adres wpisuje się tu, a nie na osobnym ekranie ustawień: wpisuje się go
               dokładnie wtedy, gdy się komuś coś pokazuje, a „zarządzanie listą osób"
               byłoby ekranem, na który nikt nie wchodzi zawczasu. -->
          <StackPanel IsVisible="{Binding CanEditOpened}" Margin="0,4,0,0" Spacing="4">
            <TextBlock Text="Pokaż osobie" Opacity="0.7" />

            <ItemsControl ItemsSource="{Binding Osoby}" IsVisible="{Binding HasOsoby}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dk:Contact">
                  <Button Classes="nav" Margin="0,0,4,4" Content="{Binding Name}"
                          Command="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).PokazOsobieCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Watermark="adres e-mail"
                       ti:TextInputOptions.AutoCapitalization="False"
                       ti:TextInputOptions.ContentType="Email"
                       Text="{Binding NowaOsoba}" />
              <Button Grid.Column="1" Classes="nav" Margin="4,0,0,0" Content="Pokaż"
                      Command="{Binding DopiszOsobeCommand}" />
            </Grid>
          </StackPanel>

          <TextBlock Classes="hint" TextWrapping="Wrap" Foreground="{DynamicResource Ostrzezenie}"
                     Text="{Binding OpenedProblem}" IsVisible="{Binding HasOpenedProblem}" />

          <StackPanel IsVisible="{Binding CanEditOpened}">
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Zapis idzie prosto do kalendarza Google. Zmieniamy tylko tytuł i godziny — uczestnicy, przypomnienia i opis zostają nietknięte." />
            <!-- Bez potwierdzenia, choć kasowanie nie wraca. Wydarzenie i zadanie mają
                 być tą samą rzeczą pod ręką, a zadanie o nic nie pyta — pytanie tylko
                 przy jednym z nich uczy odklikiwać pytania, a wtedy psuje się także to,
                 które ma sens. Ostrzeżenie zostaje, bo mówi coś, czego nie widać. -->
            <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Skasowanego wydarzenia nie da się odzyskać — ani w Marshalu, ani w Google." />
          </StackPanel>

          <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding !CanEditOpened}"
                     Text="Ten kanał jest tylko do odczytu — zmiany rób tam, gdzie wydarzenie powstało." />

          <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Right">
            <Button Classes="nav glowny" IsVisible="{Binding CanEditOpened}"
                    Command="{Binding SaveOpenedCommand}" Content="Zapisz" />
            <Button Classes="nav" IsVisible="{Binding CanEditOpened}"
                    Command="{Binding DeleteOpenedCommand}" Content="Skasuj" />
            <Button Classes="nav" Command="{Binding CloseOpenedCommand}" Content="Zamknij" />
          </WrapPanel>

        </StackPanel>
      </Border>
    </Panel>

    </Panel>

    <!-- Notatki: lista, edytor i podgląd obok siebie -->
    <Panel IsVisible="{Binding IsNotes}">
    <DockPanel DataContext="{Binding Notes}">

      <StackPanel DockPanel.Dock="Top" x:DataType="vm:NotesViewModel" Margin="0,0,0,10"
                  IsVisible="{Binding !IsEditing}">
        <TextBox Text="{Binding Query}" Watermark="Szukaj w notatkach" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <TextBox Grid.Column="0" Text="{Binding NewTitle}" Watermark="Tytuł nowej notatki">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1" Margin="6,0,0,0" Padding="14,10"
                  Command="{Binding CreateCommand}" Content="Nowa" />
        </Grid>
      </StackPanel>

      <Grid x:DataType="vm:NotesViewModel">

        <!-- Lista -->
        <DockPanel IsVisible="{Binding !IsEditing}">
          <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                     TextWrapping="Wrap" Text="{Binding Empty}"
                     IsVisible="{Binding !HasItems}" />
          <ListBox ItemsSource="{Binding Items}" DoubleTapped="OtworzNotatke">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dn:Note">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                  <!-- Przypięcie znakiem, nie kolorem: wizja i zasady mają się
                       wyróżniać, a nie krzyczeć. Gwiazdka, nie pinezka: krój, którym
                       pisze aplikacja, nie ma znaków emoji i na Androidzie zostawał
                       po niej pusty kwadracik. -->
                  <TextBlock Grid.Column="0" Text="★" Margin="0,0,8,0"
                             IsVisible="{Binding IsPinned}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="Otwórz" Padding="10,4"
                          Command="{Binding $parent[ListBox].((vm:NotesViewModel)DataContext).OpenCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Edytor na całą szerokość, podgląd dopiero wtedy, gdy jest co podglądać.
             Stojąc zawsze, przy zwykłej notatce pokazywał dosłownie drugą kopię tego
             samego tekstu i zabierał na to połowę okna. Przełącznika „pisz / oglądaj"
             nadal nie ma: kazałby pamiętać, w którym trybie się jest, przy notatce
             pisanej raz i czytanej dziesięć razy. -->
        <DockPanel IsVisible="{Binding IsEditing}">

          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox Text="{Binding Title}" FontSize="18" />
            <WrapPanel Margin="0,8,0,0">
              <CheckBox IsChecked="{Binding IsPinned}" Content="Przypięta" Margin="0,0,14,0" />
              <Button Classes="nav glowny" Command="{Binding SaveCommand}" Content="Zapisz" />
              <Button Classes="nav" Command="{Binding CloseCommand}" Content="Zamknij" />
              <Button Classes="nav" Command="{Binding DeleteCommand}" Content="Usuń" />
            </WrapPanel>
            <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap"
                       Text="Przypięta trafia do kroku zerowego przeglądu — tam, gdzie wizja i zasady." />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto">

            <TextBox Grid.Column="0" Text="{Binding Content}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Watermark="Markdown: # nagłówek, - punkt, **gruby**, *pochyły*" />

            <ScrollViewer Grid.Column="1" Width="320" Margin="10,0,0,0"
                          IsVisible="{Binding HasMarkup}">
              <ItemsControl ItemsSource="{Binding Preview}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BlockView">
                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="{Binding Margin}">
                      <Border Grid.Column="0" Width="{Binding Indent}" />
                      <!-- Cytat kreską z boku, punkt listy kropką: jedno i drugie
                           znakiem, nie kolorem. -->
                      <TextBlock Grid.Column="1" Text="•" Margin="0,0,6,0"
                                 IsVisible="{Binding IsListItem}" />
                      <Border Grid.Column="1" Width="3" Margin="0,0,8,0"
                              Background="{DynamicResource Odznaka}" IsVisible="{Binding IsQuote}" />
                      <ItemsControl Grid.Column="2" ItemsSource="{Binding Spans}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SpanView">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                       FontWeight="{Binding Weight}"
                                       FontStyle="{Binding Style}"
                                       Opacity="{Binding Opacity}"
                                       FontSize="{Binding $parent[ItemsControl].((vm:BlockView)DataContext).FontSize}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

          </Grid>
        </DockPanel>

      </Grid>
    </DockPanel>
    </Panel>

    <!-- Filtry: konstruktor warunków i Ulubione (spec 11.5). Wszystkie osie widoczne
         naraz, każda domyślnie wyłączona — zamiast przycisku „dodaj warunek", który
         prowadzi do listy pól, a z niej do edytora zależnego od wybranego pola. Tu
         widać w jednym spojrzeniu, czym filtr jest, łącznie z tym, co nieustawione. -->
    <!-- Widoczność i podmiana kontekstu na osobnych elementach, x:DataType dopiero
         na dzieciach: na elemencie z DataContext obowiązywałby też dla samego
         {Binding Filters}. -->
    <Panel IsVisible="{Binding IsFilters}">
    <DockPanel DataContext="{Binding Filters}">

      <!-- Ulubione na górze: zapas gotowych odpowiedzi na pytanie „co teraz",
           ułożonych wtedy, kiedy dało się myśleć. -->
      <StackPanel DockPanel.Dock="Top" x:DataType="vm:FiltersViewModel"
                  Margin="0,0,0,10" IsVisible="{Binding HasFavourites}">
        <TextBlock Classes="label" Text="Ulubione" />
        <ItemsControl ItemsSource="{Binding Favourites}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="df:SavedFilter">
              <Button Classes="nav" Margin="0,4,8,0" Content="{Binding Name}"
                      Command="{Binding $parent[ItemsControl].((vm:FiltersViewModel)DataContext).OpenCommand}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Zapis na dole, bo jest ostatnim krokiem układania, a nie pierwszym. -->
      <Grid DockPanel.Dock="Bottom" x:DataType="vm:FiltersViewModel"
            ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
        <TextBox Grid.Column="0" Text="{Binding Name}"
                 Watermark="Nazwa widoku, np. „Kwadrans przed wyjściem”" />
        <Button Classes="glowny" Grid.Column="1" Margin="6,0,0,0" Padding="14,10" Content="Zapisz"
                Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
        <Button Grid.Column="2" Margin="6,0,0,0" Padding="14,10" Content="Wyczyść"
                Command="{Binding ResetCommand}" />
      </Grid>

      <ScrollViewer x:DataType="vm:FiltersViewModel">
        <StackPanel>

          <TextBlock Classes="label" Text="Stan" />
          <ItemsControl ItemsSource="{Binding States}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterToggle">
                <ToggleButton Margin="0,0,6,6" Padding="12,6"
                              Content="{Binding Label}" IsChecked="{Binding IsOn}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="label" Text="Obszar" />
          <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding Area}"
                    HorizontalAlignment="Stretch" />

          <TextBlock Classes="label" Text="Projekt" />
          <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding Project}"
                    HorizontalAlignment="Stretch" />

          <TextBlock Classes="label" Text="Tagi" />
          <ItemsControl ItemsSource="{Binding Tags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterToggle">
                <ToggleButton Margin="0,0,6,6" Padding="12,6"
                              Content="{Binding Label}" IsChecked="{Binding IsOn}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="label" Text="Termin" />
          <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding Deadline}"
                    HorizontalAlignment="Stretch" />

          <TextBlock Classes="label" Text="Dzień wykonania" />
          <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding DoDate}"
                    HorizontalAlignment="Stretch" />
          <!-- Okna liczone względem dzisiaj, nie datą z kalendarza: data wpisana
               w zapisany widok przestaje cokolwiek znaczyć po kilku dniach, nadal
               wyglądając na działającą. -->
          <TextBlock Classes="hint" Margin="2,4,0,0"
                     Text="Zawsze względem dzisiaj — zapisany widok ma być prawdziwy także za miesiąc." />

          <TextBlock Classes="label" Text="Mieści się w" />
          <ComboBox ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding Minutes}"
                    HorizontalAlignment="Stretch" />
          <TextBlock Classes="hint" Margin="2,4,0,0"
                     Text="Nieoszacowane nie mieści się w niczym — tak samo jak w „Teraz”." />

          <TextBlock Classes="label" Text="Waga" />
          <ItemsControl ItemsSource="{Binding Priorities}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterToggle">
                <ToggleButton Margin="0,0,6,6" Padding="12,6"
                              Content="{Binding Label}" IsChecked="{Binding IsOn}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="label" Text="Energia" />
          <ItemsControl ItemsSource="{Binding Energies}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterToggle">
                <ToggleButton Margin="0,0,6,6" Padding="12,6"
                              Content="{Binding Label}" IsChecked="{Binding IsOn}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="label" Text="Szukany tekst" />
          <TextBox Text="{Binding Text}" Watermark="W tytule albo w notatce zadania" />

          <TextBlock Classes="hint" Margin="2,10,0,0" TextWrapping="Wrap"
                     Text="{Binding Status}" IsVisible="{Binding HasStatus}" />

          <TextBlock Classes="label" Margin="0,18,0,0" Text="Wyniki" />
          <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding Empty}"
                     IsVisible="{Binding !HasResults}" />
          <ItemsControl ItemsSource="{Binding Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Classes="badge" Text="{Binding Badges}" TextWrapping="Wrap"
                               IsVisible="{Binding HasBadges}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Szczegół" Padding="10,4"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>

    </DockPanel>
    </Panel>

    <!-- Ustawienia: motyw, strefa, kopia zapasowa (spec 11, 12) -->
    <Panel IsVisible="{Binding IsSettings}">
    <ScrollViewer DataContext="{Binding Settings}">
      <StackPanel x:DataType="vm:SettingsViewModel" MaxWidth="560" HorizontalAlignment="Left">

        <TextBlock Classes="label" Text="Motyw" />
        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                  HorizontalAlignment="Stretch" />

        <TextBlock Classes="label" Margin="0,18,0,0" Text="Strefa, w której liczone są dni" />
        <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding Zone}"
                  HorizontalAlignment="Stretch" />
        <!-- Strefa jawna, nie z systemu (spec 3.4): wyjazd na zachód przestawiłby
             „dzisiaj" o dobę dokładnie wtedy, kiedy najmniej chce się to prostować. -->
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Nie bierzemy jej z systemu. Termin i dzień wykonania są bez strefy — ale to ona rozstrzyga, który dzień jest dzisiaj." />
        <TextBlock Classes="hint" Margin="2,6,0,0" Text="{Binding Now}" />
        <!-- Strefa nie do rozpoznania przesuwa wszystkie godziny naraz i wygląda
             przez to jak źle pobrane dane. Ostrzeżenie zamiast ciszy. -->
        <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Ostrzezenie}"
                   Text="{Binding ZoneProblem}" IsVisible="{Binding HasZoneProblem}" />

        <TextBlock Classes="label" Margin="0,18,0,0" Text="Kopia zapasowa" />
        <TextBlock Classes="hint" Margin="2,0,0,8" TextWrapping="Wrap"
                   Text="Jeden plik JSON, bez konta i bez sieci. Synchronizacja chroni przed utratą urządzenia; kopia chroni przed utratą Dysku, konta albo zaufania do nich." />
        <WrapPanel>
          <Button Classes="nav" Margin="0,0,8,8" Command="{Binding ExportCommand}"
                  Content="Zapisz kopię" />
          <Button Classes="nav" Margin="0,0,8,8" Command="{Binding ImportCommand}"
                  Content="Wczytaj kopię" />
        </WrapPanel>
        <CheckBox IsChecked="{Binding ReplaceOnImport}"
                  Content="Wczytaj z podmianą całości" />
        <!-- Podmiana wymaga świadomego kliknięcia, bo na urządzeniu podpiętym do
             synchronizacji jest pozorna: czyszczenie nie zostawia śladu w dzienniku,
             więc drugie urządzenie odda swój stan z powrotem. -->
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Bez zaznaczenia kopia scala się po zegarze: nowsze pole wygrywa i nic świeższego nie przepada. Z zaznaczeniem baza jest czyszczona — to tryb na urządzenie, które zaczyna od nowa." />

        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Text="{Binding Status}" />

        <TextBlock Classes="label" Margin="0,18,0,0" Text="Konto Google — synchronizacja" />
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="Poświadczenia zakłada się raz w konsoli Google; instrukcja jest w docs/google-dysk.md. Kanały iCal i kopia zapasowa działają bez tego." />

        <TextBlock Classes="label" Margin="0,10,0,0" Text="Identyfikator klienta" />
        <TextBox Text="{Binding GoogleClientId}"
                 ti:TextInputOptions.AutoCapitalization="False"
                 Watermark="…apps.googleusercontent.com" />

        <TextBlock Classes="label" Margin="0,6,0,0" Text="Tajemnica klienta" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding GoogleClientSecret}"
                   PasswordChar="{Binding SecretChar}"
                   ti:TextInputOptions.AutoCapitalization="False"
                   Watermark="GOCSPX-…" />
          <!-- Podejrzenie, bo konsola Google pokazuje tajemnicę raz, przy zakładaniu.
               Jeśli nie została wtedy zapisana, to pole bywa jedynym miejscem,
               w którym jeszcze jest — a drugie urządzenie potrzebuje tej samej. -->
          <ToggleButton Grid.Column="1" Classes="ikona" Margin="6,0,0,0"
                        IsChecked="{Binding ShowSecret}"
                        Content="pokaż" ToolTip.Tip="Pokaż tajemnicę" />
        </Grid>

        <CheckBox Margin="0,10,0,0" IsChecked="{Binding GoogleCalendar}"
                  Content="Czytaj i zmieniaj mój kalendarz Google" />
        <!-- Osobno i domyślnie wyłączone, bo te dwa uprawnienia różnią się ceną:
             drive.file nie jest wrażliwe i pozwala opublikować aplikację bez
             weryfikacji, calendar.readonly jest wrażliwe i publikacji już nie pozwoli.
             Wciągnięcie kalendarza do jednej zgody zabierałoby tę decyzję bez pytania. -->
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Uprawnienie do kalendarza jest przez Google uznane za wrażliwe: z nim aplikacji nie da się opublikować bez przeglądu, więc trzeba zostać w trybie testowym i logować się raz w tygodniu. Sama synchronizacja takiej ceny nie ma. Po zmianie tego pola zgoda jest pytana od nowa." />

        <WrapPanel Margin="0,10,0,0">
          <Button Classes="nav" Margin="0,0,8,6" Padding="14,10"
                  Command="{Binding SyncCommand}" IsEnabled="{Binding !IsSyncing}"
                  Content="Zapisz i zsynchronizuj" />
          <!-- Widoczne tylko w trakcie. Gdy Google odrzuci zgodę, przeglądarka zostaje
               na stronie błędu i nie wraca — bez tego przycisku jedynym wyjściem
               z czekania było zamknięcie aplikacji. -->
          <Button Classes="nav" Margin="0,0,0,6" Padding="14,10"
                  Command="{Binding CancelSyncCommand}" IsVisible="{Binding IsSyncing}"
                  Content="Przerwij" />
        </WrapPanel>

        <!-- Ręcznie, nie w tle. Pierwsze przebiegi na żywym koncie mają mieć widoczny
             wynik: synchronizacja uruchamiana po cichu przy starcie znaczy, że pierwszy
             błąd zobaczysz jako brakujące zadania, a nie jako komunikat. -->
        <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap"
                   Text="Przy pierwszym razie otworzy się przeglądarka i poprosi o zgodę. Potem już nie — żeton zostaje na tym urządzeniu. Na Androidzie tak samo: te same poświadczenia co na komputerze, przeglądarka telefonu i powrót do aplikacji." />

        <!-- Droga ratunkowa, widoczna tylko w trakcie logowania. Przeglądarka ma
             wrócić do aplikacji sama; na telefonie potrafi tego nie zrobić, bo system
             odkłada do zamrażarki proces, który zszedł w tło — wtedy strona wisi
             zamiast się zamknąć. Adres z jej paska zawiera ten sam kod zgody. -->
        <StackPanel IsVisible="{Binding IsSyncing}" Margin="0,10,0,0">
          <TextBlock Classes="label" Text="Przeglądarka nie wróciła sama?" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding ConsentUrl}"
                     Watermark="http://127.0.0.1:…/authorize/?code=…" />
            <Button Grid.Column="1" Margin="6,0,0,0" Content="Dokończ"
                    Command="{Binding FinishConsentCommand}" />
          </Grid>
          <TextBlock Classes="hint" Margin="2,4,0,0"
                     Text="Skopiuj adres z paska przeglądarki — ten, na którym się zatrzymała — i wklej tutaj." />
        </StackPanel>

        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding SyncStatus}" />

        <TextBlock Classes="hint" Margin="2,8,0,0" TextWrapping="Wrap"
                   Text="{Binding TokenFolder, StringFormat='Żeton logowania: {0} — skasuj ten katalog, żeby zalogować się od nowa.'}" />

        <!-- Próba powiadomienia. To jedyny sposób, żeby czegokolwiek się dowiedzieć:
             brak powiadomienia ma trzy przyczyny wyglądające identycznie i bez
             rozróżnienia naprawia się je na oślep. -->
        <TextBlock Classes="label" Margin="0,22,0,0" Text="Powiadomienia systemowe" />
        <Button Padding="14,8" HorizontalAlignment="Left"
                Command="{Binding TestNotificationCommand}"
                Content="Wyślij powiadomienie próbne" />
        <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap"
                   Text="{Binding NotificationStatus}"
                   IsVisible="{Binding NotificationStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Classes="label" Margin="0,22,0,0" Text="Kalendarze" />
        <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding !HasCalendars}"
                   Text="Nie ma podłączonego żadnego. Dopóki go nie ma, siatka godzinowa pokazuje same zadania." />

        <!-- Kalendarz domyślny. Bez niego każde zadanie trzeba było przenosić do
             kalendarza ręcznie, jedno po drugim — a synchronizacja, o której trzeba
             pamiętać przy każdym zadaniu, nie jest synchronizacją. -->
        <TextBlock Classes="label" Margin="0,14,0,0" Text="Zadania z godziną lądują w kalendarzu" />
        <ComboBox ItemsSource="{Binding MainCalendars}" SelectedItem="{Binding MainCalendar}"
                  HorizontalAlignment="Stretch" IsVisible="{Binding HasCalendars}" />
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   IsVisible="{Binding HasCalendars}"
                   Text="Zadanie stoi w jednym kalendarzu naraz. Przeniesione stąd do innego — na przykład wspólnego z kimś — znika z tego, a wraca po cofnięciu przeniesienia. Bez dnia i godziny nie trafia nigdzie: kalendarz nie ma jak pokazać „kiedyś w tym tygodniu”." />

        <ItemsControl ItemsSource="{Binding Calendars}" Margin="0,14,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="dc:CalendarSource">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Classes="hint" Text="{Binding ExternalId}" TextWrapping="Wrap" />
                  <!-- Konto widoczne tylko tam, gdzie jest inne niż główne. Wiersz
                       „konto: (główne)" przy każdym kalendarzu byłby szumem, a przy
                       dwóch kontach właśnie tego jednego zdania się szuka. -->
                  <TextBlock Classes="hint" TextWrapping="Wrap"
                             Text="{Binding Account, StringFormat='konto: {0}'}"
                             IsVisible="{Binding Account, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center"
                           Margin="0,0,10,0" Text="{Binding Kind}" />
                <Button Grid.Column="2" Content="Odłącz" Padding="10,4" VerticalAlignment="Center"
                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveCalendarCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Konta dodatkowe. Kalendarz z drugiego konta da się zwykle wciągnąć taniej
             — udostępniając go w Google samemu sobie — ale kalendarza służbowego
             często nie wolno udostępnić na zewnątrz i wtedy zostaje druga zgoda. -->
        <TextBlock Classes="label" Margin="0,18,0,0" Text="Konta Google" />
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="Konto główne jest zawsze. Dodatkowe wnosi wyłącznie swoje kalendarze — Dysk z dziennikiem synchronizacji zostaje przy głównym. Zgoda leży na tym urządzeniu, więc na telefonie trzeba ją dać osobno." />

        <ItemsControl ItemsSource="{Binding CalendarAccounts}" Margin="0,6,0,0"
                      IsVisible="{Binding HasCalendarAccounts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="{Binding}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="Odłącz konto" Padding="10,4"
                        VerticalAlignment="Center"
                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveGoogleAccountCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Classes="nav" Margin="0,6,0,0" Padding="14,10"
                Command="{Binding AddGoogleAccountCommand}"
                Content="Dodaj konto Google" />

        <TextBlock Classes="label" Margin="0,12,0,0" Text="Dodaj kalendarz Google" />
        <Button Classes="nav" Padding="14,10"
                Command="{Binding LoadGoogleCalendarsCommand}"
                Content="Pobierz moje kalendarze" />
        <!-- Lista z konta, nie pole na identyfikator. Wpisywanie ręczne kończy się
             kalendarzami dodanymi po nazwie i błędem 404 przy każdym odświeżeniu:
             „Praca" jest nazwą, a Google chce abc@group.calendar.google.com. -->
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Wymaga zaznaczonego pola wyżej i zgody obejmującej kalendarz." />

        <ItemsControl ItemsSource="{Binding AvailableGoogleCalendars}" Margin="0,6,0,0"
                      IsVisible="{Binding HasAvailableGoogleCalendars}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="cal:GoogleCalendarInfo">
              <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <!-- Opis, nie sama nazwa: „Prywatny" bywa na obu kontach i bez adresu
                       nie widać, który wiersz jest który. -->
                  <TextBlock Text="{Binding Opis}" TextWrapping="Wrap" />
                  <TextBlock Classes="hint" Text="{Binding Id}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Podłącz" Padding="10,4" VerticalAlignment="Center"
                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).AddGoogleCalendarCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="label" Margin="0,12,0,0" Text="Dodaj kanał iCal" />
        <Grid ColumnDefinitions="*,*,Auto">
          <TextBox Grid.Column="0" Margin="0,0,6,0" Text="{Binding NewIcalUrl}"
                   ti:TextInputOptions.AutoCapitalization="False"
                   ti:TextInputOptions.ContentType="Url"
                   Watermark="https://…/kalendarz.ics" />
          <TextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding NewIcalName}"
                   Watermark="Nazwa" />
          <Button Grid.Column="2" Content="Dodaj" Padding="12,8"
                  Command="{Binding AddIcalCommand}" />
        </Grid>
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Kanał .ics nie wymaga konta Google ani niczego z instrukcji — wystarczy adres." />

        <Button Classes="nav" Margin="0,12,0,0" Padding="14,10"
                Command="{Binding RefreshCalendarsCommand}" Content="Odśwież kalendarze teraz" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding CalendarStatus}" />

      </StackPanel>
    </ScrollViewer>
    </Panel>

    <!-- Oczekiwane: sortowane po liczbie dni, najdłużej czekające na górze -->
    <DockPanel IsVisible="{Binding IsWaiting}">
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                 Text="Czekanie jest prawidłowym stanem. Próg ponaglenia jest własnością obszaru — urząd nie odpowiada w tydzień." />
      <ListBox ItemsSource="{Binding WaitingItems}" DoubleTapped="OtworzZListy">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="rev:WaitingItem">
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Task.Title}" TextWrapping="Wrap" />
                <TextBlock Classes="badge" TextWrapping="Wrap">
                  <Run Text="{Binding Who}" />
                  <Run Text=" · " />
                  <Run Text="{Binding Days}" />
                  <Run Text=" dni z " />
                  <Run Text="{Binding NudgeDays}" />
                </TextBlock>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="ponaglić" VerticalAlignment="Center"
                         Opacity="0.75" IsVisible="{Binding NeedsNudge}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Projekty: obszar, cel, projekt -->
    <!-- Struktura: obszary z zagnieżdżonymi projektami i równowagą przy obszarach.
         Do dziś były to dwa ekrany na te same obiekty i każdy dawał co innego: tu
         barwa i usunięcie projektu, tam zakładanie obszaru, a nazwa wyłącznie tam.
         Jeden ekran, jeden zestaw czynności — a liczby równowagi są cechą obszaru,
         więc stoją przy nim, nie w osobnej tabeli. -->
    <DockPanel IsVisible="{Binding IsProjects}">
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8" TextWrapping="Wrap"
                 Text="Kwadracik po lewej ustawia barwę; barwa obszaru schodzi na jego projekty i zadania. Prawy przycisk na wierszu: nazwa, nowy projekt pod spodem, usunięcie pustego." />
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,10" TextWrapping="Wrap"
                 Text="Równowaga nie znaczy równy rozkład. Trzy miesiące w jednym obszarze bywają prawidłową decyzją — liczby mają pokazać, że zapadła." />

      <!-- Zakładanie obszaru. Podział odpowiedzialności jest rzeczą osobistą i zmienia
           się w życiu; zasiana dziesiątka jest punktem wyjścia, a nie zestawem, w który
           trzeba się wcisnąć. Projekty zakłada się z menu wiersza, bo muszą wiedzieć,
           pod czym mają stanąć. -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <TextBox Grid.Column="0" Text="{Binding NewAreaName}"
                 Watermark="Nowy obszar — na przykład „Rodzina”">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AddAreaCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Classes="glowny" Grid.Column="1" Margin="8,0,0,0" Padding="14,10"
                Command="{Binding AddAreaCommand}" Content="Dodaj obszar" />
      </Grid>

      <ListBox ItemsSource="{Binding ProjectRows}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectTreeRow">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,5">
              <Border Grid.Column="0" Width="{Binding Indent}" />

              <!-- Kwadracik barwy jest przyciskiem: barwę ustawia się tam, gdzie się ją
                   widzi. Osobny ekran ustawień kolorów znaczyłby, że po każdej zmianie
                   trzeba wrócić tutaj, żeby sprawdzić, co z tego wyszło. -->
              <Border Grid.Column="1" Width="14" Height="14" CornerRadius="3"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center" Cursor="Hand"
                      Background="{Binding Swatch}"
                      BorderThickness="1" BorderBrush="{DynamicResource Odznaka}"
                      PointerPressed="NaBarwie" />

              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                <!-- N1 napisem, nie kolorem: plakietka bez treści uczy ignorowania. -->
                <TextBlock Classes="badge" Text="{Binding Marker}"
                           IsVisible="{Binding IsBlocked}" />
              </StackPanel>

              <!-- Sama liczba dni, bez ocen i bez czerwieni: etykieta dokłada wstyd,
                   który nie pomaga podjąć działania (8.5). -->
              <TextBlock Grid.Column="3" Classes="hint" VerticalAlignment="Center"
                         TextAlignment="Right" Margin="12,0,0,0"
                         Text="{Binding BalanceText}" IsVisible="{Binding HasBalance}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Przegląd tygodniowy: kreator ośmiu kroków (8.3) -->
    <Panel IsVisible="{Binding IsReview}">
    <ScrollViewer DataContext="{Binding Review}">
      <StackPanel MaxWidth="620" HorizontalAlignment="Center"
                  x:DataType="vm:ReviewViewModel">

        <StackPanel IsVisible="{Binding !IsFinished}">

          <TextBlock Classes="hint" HorizontalAlignment="Center" Text="{Binding StepNumber}" />
          <TextBlock Text="{Binding StepTitle}" FontSize="22" Margin="0,6,0,4"
                     TextWrapping="Wrap" HorizontalAlignment="Center" />
          <TextBlock Classes="hint" Text="{Binding StepHint}" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBlock Classes="hint" Text="{Binding Remaining}" Margin="0,10,0,0"
                     HorizontalAlignment="Center" IsVisible="{Binding !IsPinnedStep}" />
          <TextBlock Classes="hint" HorizontalAlignment="Center" Margin="0,2,0,0"
                     Text="{Binding TotalRemaining, StringFormat='w całym przeglądzie: {0}'}" />

          <!-- Krok zerowy: sam tekst, bez żadnej akcji. Jest po to, żeby reszta
               przeglądu działa się po jego przeczytaniu, a nie żeby coś z nim zrobić. -->
          <Border Margin="0,16,0,0" Padding="18" CornerRadius="8" Background="{DynamicResource Panel}"
                  IsVisible="{Binding IsPinnedStep}">
            <StackPanel Spacing="10">
              <TextBlock TextWrapping="Wrap"
                         Text="Aplikacja nie może liczyć na to, że przegląd się odbędzie. Wszystko, co tu zobaczysz, wyliczyło się samo — nie musiałaś o tym pamiętać." />
              <TextBlock TextWrapping="Wrap"
                         Text="Przerwanie w dowolnym momencie nic nie kosztuje. Stan zapisuje się po każdej pojedynczej pozycji, więc przegląd rozłożony na pięć wieczorów jest przeglądem zrobionym." />
              <!-- Przypięte notatki: czwarty i piąty horyzont GTD. Rzeczy, których nie
                   da się odhaczyć, więc nie mają tu żadnego przycisku. -->
              <ItemsControl ItemsSource="{Binding Pinned}" IsVisible="{Binding HasPinned}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="dn:Note">
                    <StackPanel Margin="0,10,0,0" Spacing="3">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Opacity="0.85" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding !HasPinned}"
                         Text="Nie masz jeszcze przypiętych notatek. Przypnij tę, którą chcesz czytać przed każdym przeglądem — wizję albo zasady." />
            </StackPanel>
          </Border>

          <!-- Krok ósmy: tabela do obejrzenia, nie lista do odhaczenia. -->
          <StackPanel Margin="0,16,0,0" IsVisible="{Binding IsBalanceStep}">
            <ItemsControl ItemsSource="{Binding Balance}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rev:AreaBalance">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,5">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Classes="hint" Width="120" TextAlignment="Right"
                               Text="{Binding ActiveProjects, StringFormat='{}{0} aktywnych'}" />
                    <TextBlock Grid.Column="2" Classes="hint" Width="150" TextAlignment="Right"
                               Text="{Binding DaysSinceMove, StringFormat='{}{0} dni bez ruchu'}"
                               IsVisible="{Binding DaysSinceMove, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Grid.Column="2" Classes="hint" Width="150" TextAlignment="Right"
                               Text="brak ruchu"
                               IsVisible="{Binding DaysSinceMove, Converter={x:Static ObjectConverters.IsNull}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Krok skrzynki: pozycji się nie odhacza, tylko się je przetwarza.
               Oznaczenie wrzutu jako „rozpatrzony" zostawiłoby go w skrzynce,
               a za tydzień trzeba by go oznaczyć znowu. -->
          <StackPanel IsVisible="{Binding IsInboxStep}" Margin="0,16,0,0">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rev:ReviewItem">
                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="glowny" HorizontalAlignment="Stretch" Margin="0,12,0,0" Padding="14,10"
                    Command="{Binding ProcessInboxCommand}" IsEnabled="{Binding HasItems}"
                    Content="Przetwórz skrzynkę" />
            <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap"
                       Text="Przegląd zostaje otwarty — wróci na ten sam krok." />
          </StackPanel>

          <!-- Pozycje kroku. Odhaczenie zapisuje się natychmiast — to jest cały
               mechanizm wznawialności, a nie optymalizacja. -->
          <ItemsControl ItemsSource="{Binding Items}" Margin="0,16,0,0"
                        IsVisible="{Binding HasChecklist}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="rev:ReviewItem">
                <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="8" Background="{DynamicResource Panel}">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                      <TextBlock Classes="badge" Text="{Binding Detail}" TextWrapping="Wrap"
                                 IsVisible="{Binding HasDetail}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Rozpatrzone" Padding="12,6"
                            VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:ReviewViewModel)DataContext).ProcessCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,20,0,0">
            <Button Grid.Column="0" Content="Wstecz" Padding="14,8"
                    IsEnabled="{Binding CanGoBack}" Command="{Binding BackCommand}" />
            <Button Grid.Column="2" Padding="14,8" Command="{Binding NextCommand}"
                    Content="Dalej" IsVisible="{Binding !IsLastStep}" />
            <Button Grid.Column="2" Padding="14,8" Command="{Binding NextCommand}"
                    Content="Zakończ przegląd" IsVisible="{Binding IsLastStep}" />
          </Grid>

          <TextBlock Classes="hint" Margin="0,10,0,0" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center"
                     Text="Można wyjść w każdej chwili. Nieukończony przegląd nie wygasa i o sobie nie przypomina." />

        </StackPanel>

        <!-- Zakończenie bez podsumowania „wykonano 2 z 5" i bez oceny. -->
        <Border IsVisible="{Binding IsFinished}" Margin="0,40,0,0" Padding="24"
                CornerRadius="10" Background="{DynamicResource Panel}">
          <StackPanel Spacing="10">
            <TextBlock Text="Przegląd zamknięty." FontSize="20" HorizontalAlignment="Center" />
            <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Następny założy się sam, kiedy tu wrócisz. Bez terminu i bez licznika dni." />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
    </Panel>

    <!-- Co się działo (spec 12). „Nic się nie stało" i „zadziałało" wyglądają na
         ekranie identycznie — ten ekran jest jedynym miejscem, gdzie się rozchodzą. -->
    <Panel IsVisible="{Binding IsJournal}">
    <DockPanel DataContext="{Binding Journal}">

      <StackPanel DockPanel.Dock="Top" x:DataType="vm:JournalViewModel" Margin="0,0,0,10">
        <WrapPanel>
          <Button Classes="nav" Command="{Binding RefreshCommand}" Content="Odśwież" />
          <Button Classes="nav" Command="{Binding ClearCommand}" Content="Wyczyść" />
          <CheckBox Margin="8,0,0,0" VerticalAlignment="Center"
                    IsChecked="{Binding OnlyProblems}" Content="tylko problemy" />
        </WrapPanel>
        <!-- Piątka na dziś nad siatką, nie wstawiana w siatkę z góry: wolny blok wybrany
             przez aplikację byłby zgadywaniem, kiedy się na to zbierzesz. Ptaszek
             zapisuje blok wstecz — kończący się teraz, o długości oszacowania. -->
        <ItemsControl Margin="0,6,0,0"
                      ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).FocusOffGrid}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="tasks:TaskItem">
              <Border Margin="0,0,6,6" Padding="8,4" CornerRadius="6" Background="{DynamicResource Panel}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <CheckBox MinWidth="0" Padding="0"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CompleteTaskCommand}"
                            CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap" Text="{Binding Summary}" />
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Zapis lokalny, nie wchodzi do synchronizacji ani do kopii. Trzymane jest ostatnie 500 wpisów." />
      </StackPanel>

      <ScrollViewer x:DataType="vm:JournalViewModel">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:JournalRow">
              <Border Margin="0,0,0,6" Padding="10,6" CornerRadius="6"
                      Background="{DynamicResource PoleSlabe}" BorderThickness="3,0,0,0"
                      BorderBrush="{Binding Mark}">
                <StackPanel>
                  <TextBlock Classes="hint" Text="{Binding When}" />
                  <TextBlock Text="{Binding Operation}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" />
                  <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>
    </Panel>

    <!-- Archiwum -->
    <DockPanel IsVisible="{Binding IsArchive}">
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                 Text="Wykonane i wyrzucone, najnowsze pierwsze. Nic nie znika z bazy." />
      <ListBox ItemsSource="{Binding ArchiveItems}" DoubleTapped="OtworzZListy">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="tasks:TaskItem">
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
              <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap" Opacity="0.75" />
              <TextBlock Grid.Column="1" Classes="hint" Text="{Binding State}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    </Grid>
  </DockPanel>

      <!-- „Więcej": reszta ekranów. Nakładka, nie kolejny ekran — wybranie czegoś
           ma być jednym gestem, a nie wejściem w listę i wyjściem z niej.
           Widoczność i podmiana kontekstu na osobnych elementach, jak wszędzie. -->
      <Panel IsVisible="{Binding IsMoreOpen}" Background="{DynamicResource Zaslona}">
      <Border VerticalAlignment="Bottom" Padding="12" CornerRadius="12,12,0,0"
              Background="{DynamicResource Karta}">
      <ScrollViewer MaxHeight="440">
        <StackPanel>
          <Button Classes="sheet" Content="Następne" Command="{Binding ShowNextCommand}" />
          <Button Classes="sheet" Content="Obszary i projekty" Command="{Binding ShowProjectsCommand}" />
          <Button Classes="sheet" Content="Oczekiwane" Command="{Binding ShowWaitingCommand}" />
          <Button Classes="sheet" Content="Kiedyś" Command="{Binding ShowSomedayCommand}" />
          <Button Classes="sheet" Content="Przegląd" Command="{Binding ShowReviewCommand}" />
          <Button Classes="sheet" Content="Notatki" Command="{Binding ShowNotesCommand}" />
          <Button Classes="sheet" Content="Filtry" Command="{Binding ShowFiltersCommand}" />
          <Button Classes="sheet" Content="Archiwum" Command="{Binding ShowArchiveCommand}" />
          <Button Classes="sheet" Content="Ustawienia" Command="{Binding ShowSettingsCommand}" />
          <Button Classes="sheet" Content="Co się działo" Command="{Binding ShowJournalCommand}" />
          <Button Classes="sheet" Content="Zamknij" Margin="0,8,0,0"
                  Command="{Binding CloseMoreCommand}" />
        </StackPanel>
      </ScrollViewer>
      </Border>
      </Panel>

      <!-- Szczegół zadania: nakładka nad ekranami, nie osobna pozycja w nawigacji.
           Ta sama sztuczka co przy przetwarzaniu: widoczność na jednym elemencie,
           podmiana kontekstu na drugim, bo DataContext ustawiony na elemencie
           obowiązuje też dla pozostałych powiązań na tym samym elemencie. -->
      <!-- Podgląd przeciąganego bloku. Nad wszystkim i nieprzezroczysty dla wskaźnika,
           żeby nie łapał zdarzeń, które należą do siatki pod nim. -->
      <!-- Podgląd przeciągania: kopia bloku, nie dymek z napisem.
           Dymek mówił, dokąd blok trafi, ale nie pokazywał **czego** się nie zmieści
           ani ile miejsca zajmie — a to jest jedyne pytanie, które się zadaje, ciągnąc
           coś po kalendarzu. Kopia ma tę samą szerokość, wysokość i barwę, i trzyma się
           tego punktu, w którym złapała ją ręka. -->
      <Canvas Name="WarstwaPodgladu" IsHitTestVisible="False">
        <Border Name="Podglad" IsVisible="False" CornerRadius="4" Padding="4,2"
                BorderBrush="{DynamicResource Akcent}" BorderThickness="1" Opacity="0.9">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Name="PodgladTytul" FontSize="11"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Margin="4,0,0,0" Name="PodgladGodziny">
              <TextBlock Classes="godzina" Name="PodgladOd" />
              <TextBlock Classes="godzina" Name="PodgladDo" />
            </StackPanel>
          </Grid>
        </Border>
      </Canvas>

      <Panel IsVisible="{Binding Detail.IsOpen}" Background="{DynamicResource Zaslona}"
             PointerPressed="TloSzczegolu">
      <!-- Kliknięcie w przyciemnione tło zamyka okno, kliknięcie w samo okno nie:
           zdarzenie zatrzymuje się na ramce, więc do tła nie dociera. -->
      <!-- Na wąskim ekranie karta przestaje być kartą i wypełnia okno. Okienko
           z marginesem wygląda na telefonie jak coś doklejonego nad treścią, a przy
           dwunastu polach i tak zasłania wszystko — więc margines kosztuje miejsce
           i nic za nie nie daje. Ten sam warunek co przy nawigacji: wąsko to wąsko,
           niezależnie od tego, czy jest to telefon, czy zwężone okno na pulpicie. -->
      <Border Classes.pelny="{Binding IsNarrow}"
              MaxWidth="560" MaxHeight="620" Margin="8" Padding="24" CornerRadius="14"
              Background="{DynamicResource Karta}" VerticalAlignment="Center"
              BorderThickness="1" BorderBrush="{DynamicResource Krawedz}"
              PointerPressed="ZatrzymajKlikniecie">
      <DockPanel DataContext="{Binding Detail}" x:DataType="vm:TaskDetailViewModel">

        <!-- Przyciski przyszpilone na dole, poza przewijaniem. Wcześniej stały na
             końcu treści: przy rozwiniętym rytmie trzeba było przewinąć całe okno,
             żeby dojść do „Zapisz", a na pełnym ekranie telefonu jest tego jeszcze
             więcej. Bez pośrednika: okno woła metodę wprost, bo polecenie
             asynchroniczne potrafi cicho odmówić, a odmowa wygląda wtedy dokładnie
             jak martwy przycisk i nie zostawia śladu nigdzie. -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,16,0,0">
          <!-- Kosz z lewej, z dala od zapisu: to jedyny przycisk w tym oknie, który coś
               zabiera, a na telefonie kciuk ląduje po prawej. Widoczny tylko przy
               zadaniu, które już istnieje — nowego nie ma czego wyrzucać.

               Do dziś nie było go wcale. Na komputerze kasowało się z listy, prawym
               przyciskiem; na telefonie nie ma ani prawego przycisku, ani listy pod
               ręką, więc zadania otwartego z kalendarza nie dało się usunąć w ogóle. -->
          <Button Grid.Column="0" Classes="cichy" Padding="14,8" Click="UsunZadanie"
                  Content="Do kosza" IsVisible="{Binding IsExisting}" />

          <Button Grid.Column="2" Classes="cichy" Padding="14,8" Margin="8,0"
                  Click="ZamknijZadanie" Content="Zamknij" />
          <Button Grid.Column="3" Classes="glowny" Padding="14,8"
                  Click="ZapiszZadanie" Content="Zapisz" />
        </Grid>

      <ScrollViewer Name="SzczegolPrzewijanie">
        <StackPanel>

          <Grid ColumnDefinitions="Auto,*">
            <!-- Ptaszek przy nazwie zamiast przycisku „Zrobione" na dole: odhaczenie
                 dotyczy tej jednej rzeczy, której nazwa stoi obok, a nie okna. -->
            <CheckBox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                      IsVisible="{Binding IsExisting}"
                      IsChecked="{Binding IsDone, Mode=OneWay}"
                      Click="OdhaczZadanie" />
            <!-- Znak wodny, bo puste pole bez podpisu jest samym prostokątem:
                 nie widać po nim, że to jest miejsce na nazwę zadania. -->
            <TextBox Grid.Column="1" Text="{Binding Title}" FontSize="18"
                     Watermark="Co jest do zrobienia?"
                     KeyDown="NazwaKlawisz" />
          </Grid>

          <!-- Nieudany zapis zamykał okno tak samo jak udany. -->
          <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Ostrzezenie}"
                     Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />

          <TextBlock Classes="label" Text="Notatka" />
          <TextBox Text="{Binding Note}" AcceptsReturn="True" MinHeight="60"
                   TextWrapping="Wrap" Watermark="Cokolwiek, co pomoże zacząć" />

          <TextBlock Classes="label" Text="Miejsce — obszar albo projekt w nim" />
          <!-- Jedna lista, wcięciem udająca drzewko: wybór projektu jest zarazem
               wyborem jego obszaru, więc nie da się wskazać sprzecznej pary. -->
          <ComboBox ItemsSource="{Binding Placements}" SelectedItem="{Binding SelectedPlacement}"
                    HorizontalAlignment="Stretch" PlaceholderText="jeszcze nierozstrzygnięte">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PlacementChoice">
                <StackPanel Orientation="Horizontal">
                  <Border Width="{Binding Indent}" />
                  <TextBlock Text="{Binding Label}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Classes="label" Text="Dzień wykonania — obietnica dana sobie" />
          <k:WyborDaty Wartosc="{Binding DoDate}" />

          <TextBlock Classes="label" Text="Od której do której" />
          <Grid ColumnDefinitions="*,Auto,*">
            <k:WyborGodziny Grid.Column="0" Wartosc="{Binding DoTime}" />
            <TextBlock Grid.Column="1" Text="–" Margin="8,0" VerticalAlignment="Center" />
            <k:WyborGodziny Grid.Column="2" Wartosc="{Binding EndTime}" />
          </Grid>
          <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                     Text="Bez godziny zadanie idzie na pasek całodniowy. Bez godziny końca trwa pół godziny." />

          <!-- Rzadkie pola pod jednym przełącznikiem. Okno miało dwanaście pól jedno
               pod drugim i do przycisku zapisu trzeba było przewijać; pole, które
               w dziewięciu zadaniach na dziesięć zostaje puste, jest w oknie kosztem,
               a nie możliwością. Podsumowanie obok, żeby zwinięte nie znaczyło
               „nie wiadomo, co tam jest". -->
          <!-- Pasek przełączników: każdy odsłania swoją rzecz. Dopisanie terminu nie ma
               wywlekać rytmu, wagi i energii, których się nie dotyka.

               **Rysunki, nie znaki pisma.** Stały tu najpierw emoji 📅 🔔 ❗ 🔋 🔁
               i na Androidzie nie pojawiało się nic: krój Inter, którym pisze cała
               aplikacja, nie ma takich znaków, a podstawienia innego kroju Avalonia
               tam nie robi. Potem były słowa — czytelne i odporne, ale pięć chipów
               z napisami rozkładało się na telefonie na dwa wiersze.

               Ścieżka rozwiązuje jedno i drugie: rysuje się niezależnie od kroju,
               a pięć kwadracików mieści się w jednym wierszu. Znaczenia nie niesie
               sam rysunek — niesie je pełne zdanie, które odsłania się **pod** paskiem
               zaraz po wciśnięciu. Na dotyku, gdzie nie ma czym najechać po podpowiedź,
               to jest jedyna droga, którą da się przejść raz i zapamiętać. -->
          <WrapPanel Margin="0,14,0,0">
            <ToggleButton Classes="ikona rysunek" IsChecked="{Binding ShowDeadline}"
                          ToolTip.Tip="Termin — fakt zewnętrzny">
              <Path Classes="ikonka" Data="{StaticResource IkonaTerminu}" />
            </ToggleButton>
            <ToggleButton Classes="ikona rysunek" IsChecked="{Binding ShowReminder}"
                          ToolTip.Tip="Przypomnienie">
              <Path Classes="ikonka" Data="{StaticResource IkonaPrzypomnienia}" />
            </ToggleButton>
            <ToggleButton Classes="ikona rysunek" IsChecked="{Binding ShowPriority}"
                          ToolTip.Tip="Waga">
              <Path Classes="ikonka" Data="{StaticResource IkonaWagi}" />
            </ToggleButton>
            <ToggleButton Classes="ikona rysunek" IsChecked="{Binding ShowEnergy}"
                          ToolTip.Tip="Ile trzeba mieć w sobie">
              <Path Classes="ikonka" Data="{StaticResource IkonaSil}" />
            </ToggleButton>
            <ToggleButton Classes="ikona rysunek" IsChecked="{Binding ShowRepeat}"
                          ToolTip.Tip="Rytm">
              <Path Classes="ikonka" Data="{StaticResource IkonaRytmu}" />
            </ToggleButton>
          </WrapPanel>

          <StackPanel>
          <StackPanel IsVisible="{Binding ShowDeadline}">
            <TextBlock Classes="label" Text="Termin — fakt zewnętrzny, świat się nie przesunie" />
            <k:WyborDaty Wartosc="{Binding Deadline}" />
          </StackPanel>

          <StackPanel IsVisible="{Binding ShowReminder}">
          <TextBlock Classes="label" Text="Przypomnienie — kiedy chcesz o tym usłyszeć" />

          <!-- Zadanie z godziną dostaje wyprzedzenia liczone od niej, a nie własne
               chwile: tak się o tym myśli („pół godziny przed wizytą"), a przesunięcie
               zadania zabiera je ze sobą, zamiast zostawiać przypomnienia przy starej
               godzinie. Kilka naraz, bo jedno rzadko wystarcza. -->
          <StackPanel IsVisible="{Binding HasTime}">
            <ItemsControl ItemsSource="{Binding Leads}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LeadChoice">
                  <CheckBox Margin="0,0,14,0" IsChecked="{Binding IsChecked}"
                            Content="{Binding Label}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Dowolnie: liczba, jednostka, „Dodaj". Wpisane wskakuje na listę
                 na swoje miejsce w kolejności czasu i zostaje zaznaczone. -->
            <Grid ColumnDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
              <NumericUpDown Grid.Column="0" Width="108" Value="{Binding CustomLead}"
                             Minimum="1" Maximum="999" Increment="1" FormatString="0" />
              <ComboBox Grid.Column="1" Margin="6,0,0,0" Width="108"
                        ItemsSource="{Binding LeadUnits}" SelectedItem="{Binding SelectedLeadUnit}" />
              <Button Grid.Column="2" Margin="6,0,0,0" Content="Dodaj"
                      Command="{Binding AddLeadCommand}" />
            </Grid>

            <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap"
                       Text="Liczone od godziny zadania — przesunięcie zadania przesuwa je razem z nim." />
          </StackPanel>

          <!-- Bez godziny nie ma od czego liczyć wyprzedzenia, więc przypomnienie
               ma własny dzień i porę. -->
          <StackPanel IsVisible="{Binding !HasTime}">
            <Grid ColumnDefinitions="*,Auto">
              <k:WyborDaty Grid.Column="0" Wartosc="{Binding ReminderDay}" />
              <k:WyborGodziny Grid.Column="1" Margin="6,0,0,0" Wartosc="{Binding ReminderTime}" />
            </Grid>
            <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                       Text="Bez godziny znaczy rano. Sama godzina bez dnia nie znaczy nic." />
          </StackPanel>
          </StackPanel>

          <StackPanel IsVisible="{Binding ShowPriority}">
            <TextBlock Classes="label" Text="Waga" />
            <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>

          <!-- Bez oszacowania zadanie nigdy nie trafi do „Teraz" (8.1). To nie jest
               surowość, tylko warunek: widok dobierający pod dostępne minuty nie ma jak
               ocenić czegoś, co nie ma długości. -->
          <TextBlock Classes="label" Text="Ile to zajmie (minuty)" />
          <NumericUpDown Value="{Binding EstimatedMinutes}" Minimum="1" Maximum="600"
                         Increment="5" FormatString="0" />

          <StackPanel IsVisible="{Binding ShowEnergy}">
            <TextBlock Classes="label" Text="Ile trzeba mieć w sobie" />
            <ComboBox ItemsSource="{Binding Energies}" SelectedItem="{Binding SelectedEnergyLevel}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Classes="hint" Margin="2,4,0,0"
                       Text="Nieokreślona przechodzi przy każdym poziomie — brak decyzji nie udaje decyzji." />
          </StackPanel>
          </StackPanel>

          <Border Margin="0,18,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource Panel}"
                  IsVisible="{Binding ShowRepeat}">
            <StackPanel>

              <TextBlock Text="Rytm" FontWeight="SemiBold" />

              <TextBlock Classes="label" Text="Jak często" />
              <ComboBox ItemsSource="{Binding Repeats}" SelectedItem="{Binding SelectedRepeat}"
                        HorizontalAlignment="Stretch" />

              <StackPanel IsVisible="{Binding NeedsInterval}">
                <TextBlock Classes="label" Text="Co ile" />
                <NumericUpDown Value="{Binding Interval}" Minimum="1" Maximum="99"
                               Increment="1" FormatString="0" />
              </StackPanel>

              <StackPanel IsVisible="{Binding NeedsWeekdays}">
                <TextBlock Classes="label" Text="W które dni" />
                <WrapPanel>
                  <ToggleButton Classes="day" IsChecked="{Binding Monday}" Content="pn" />
                  <ToggleButton Classes="day" IsChecked="{Binding Tuesday}" Content="wt" />
                  <ToggleButton Classes="day" IsChecked="{Binding Wednesday}" Content="śr" />
                  <ToggleButton Classes="day" IsChecked="{Binding Thursday}" Content="cz" />
                  <ToggleButton Classes="day" IsChecked="{Binding Friday}" Content="pt" />
                  <ToggleButton Classes="day" IsChecked="{Binding Saturday}" Content="sb" />
                  <ToggleButton Classes="day" IsChecked="{Binding Sunday}" Content="nd" />
                </WrapPanel>
              </StackPanel>

              <StackPanel IsVisible="{Binding NeedsDayOfMonth}">
                <TextBlock Classes="label" Text="Którego dnia miesiąca" />
                <NumericUpDown Value="{Binding DayOfMonth}" Minimum="1" Maximum="31"
                               Increment="1" FormatString="0" />
                <TextBlock Classes="hint" Margin="2,4,0,0"
                           Text="31 znaczy ostatniego — w lutym wypadnie 28 albo 29." />
              </StackPanel>

              <StackPanel IsVisible="{Binding IsRepeating}">
                <TextBlock Classes="label" Text="Kolejne liczone" />
                <ComboBox ItemsSource="{Binding Anchors}" SelectedItem="{Binding SelectedAnchor}"
                          HorizontalAlignment="Stretch" />

                <TextBlock Classes="label" Text="Gdy dzień minie niewykonany" />
                <ComboBox ItemsSource="{Binding Missed}" SelectedItem="{Binding SelectedMissed}"
                          HorizontalAlignment="Stretch" />
              </StackPanel>

              <!-- Rytm zdaniem, nie formularzem. Sześć pól da się wypełnić źle i nie
                   zauważyć; zdanie da się przeczytać i od razu wiedzieć, czy o to chodziło. -->
              <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource Panel}">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontStyle="Italic" />
              </Border>

            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
      </DockPanel>
      </Border>
      </Panel>

      <!--
        Zasłona na czas startu.

        Okno powstaje i pokazuje się, zanim aplikacja ma bazę i model widoku —
        i to jest w porządku, bo puste okno jest lepsze niż żadne przez trzy sekundy.
        Gorsze jest to, co widać w międzyczasie: powiązanie bez kontekstu danych nie
        daje ani prawdy, ani fałszu, więc każde „IsVisible" wraca do wartości domyślnej,
        czyli **widoczne**. Przez tę chwilę na wierzchu leżą naraz wszystkie ekrany,
        arkusz „Więcej" i okno szczegółu zadania — pusty formularz, którego nikt nie
        otwierał.

        Zasłona zdejmowana jest z kodu, a nie powiązaniem, właśnie dlatego, że
        powiązanie bez kontekstu jest tu tym, co psuje.
      -->
      <Panel Name="ZaslonaStartu" Background="{DynamicResource Tlo}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <Image Source="/Assets/marshal.png" Width="52" Height="52"
                 HorizontalAlignment="Center" />
          <TextBlock Text="Marshal" FontSize="18" FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="hint" Text="Chwileczkę — otwieram bazę."
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>
  </Grid>
</UserControl>
