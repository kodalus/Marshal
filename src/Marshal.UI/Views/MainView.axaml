<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Marshal.UI.ViewModels"
             xmlns:tasks="using:Marshal.Domain.Tasks"
             xmlns:uc="using:Marshal.Application.UseCases"
             xmlns:abs="using:Marshal.Application.Abstractions"
             xmlns:rev="using:Marshal.Application.Review"
             xmlns:sys="using:System"
             xmlns:dn="using:Marshal.Domain.Notes"
             xmlns:dc="using:Marshal.Domain.Calendar"
             xmlns:cal="using:Marshal.Infrastructure.Calendar"
             xmlns:df="using:Marshal.Domain.Filters"
             x:Class="Marshal.UI.Views.MainView"
             x:DataType="vm:MainViewModel">

  <!--
    Barwy w jednym miejscu, osobno dla obu motywów.
    Do dziś karta szczegółu miała wpisane na sztywno #FF1E1E1E, a przyciemnienie tła
    #CC101010 — czyli w motywie jasnym, który aplikacja umie ustawić, okno szczegółu
    było czarnym prostokątem. Reszta pliku używa szarości z przezroczystością
    (#20808080), bo ta wygląda znośnie w obu; ale powierzchnia karty musi być
    nieprzezroczysta, więc nie da się jej tak zapisać i musi mieć dwie wersje.
  -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Karta" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="Krawedz" Color="#22000000" />
          <SolidColorBrush x:Key="Pole" Color="#0A000000" />
          <SolidColorBrush x:Key="Zaslona" Color="#66000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Karta" Color="#FF23272E" />
          <SolidColorBrush x:Key="Krawedz" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="Pole" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="Zaslona" Color="#99000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Bursztyn z ikony aplikacji. Jedna barwa wyróżnienia na całe okno: dwie
           znaczą, że żadna nie znaczy nic. Ta sama w obu motywach, bo jest czytelna
           i na jasnym, i na ciemnym. -->
      <SolidColorBrush x:Key="Akcent" Color="#D89B3C" />
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!--
      Pola do wpisywania: wypełnienie zamiast ramki.
      Okno szczegółu miało czternaście kontrolek, każdą w pełnej ramce, jedna pod
      drugą — i to jest ten „ściana prostokątów", od którego oko nie ma się gdzie
      zaczepić. Delikatne wypełnienie z włosową krawędzią pokazuje, gdzie się pisze,
      nie rysując przy tym czternastu równorzędnych pudełek.
    -->
    <Style Selector="TextBox, ComboBox, NumericUpDown, DatePicker, TimePicker, CalendarDatePicker">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Krawedz}" />
      <Setter Property="Background" Value="{DynamicResource Pole}" />
    </Style>

    <!-- Pole daty ma własną szerokość najmniejszą, liczoną na trzy panele. W wierszu
         przypomnienia stało obok pola godziny i wypychało je poza krawędź karty —
         widać to było jako „hourminute" wciśnięte w sam róg. -->
    <Style Selector="DatePicker.waska">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="DatePicker.waska /template/ Button#PART_FlyoutButton">
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <!-- Godziny na bloku kalendarza: mniejsze od tytułu, bo są odpowiedzią na drugie
         pytanie, nie na pierwsze. -->
    <!-- Pole godziny ma własną szerokość najmniejszą, liczoną na trzy panele
         z sekundami — dwa takie pola obok siebie nie mieściły się w karcie i wychodziły
         poza jej krawędź. Zerowa szerokość najmniejsza oddaje rozstrzygnięcie siatce,
         w której leżą; ta sama poprawka dotyczy przycisku w środku, bo on ma swoją. -->
    <Style Selector="TimePicker.waska">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TimePicker.waska /template/ Button#PART_FlyoutButton">
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Pasek ikon: równe kwadraty, nie prostokąty wielkości znaku. Pięć przycisków
         o pięciu różnych szerokościach czytało się jak pięć różnych rzeczy. -->
    <Style Selector="ToggleButton.ikona">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Pole}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Krawedz}" />
    </Style>
    <!-- Włączone poznaje się po obwódce w barwie wyróżnienia, nie po zamalowaniu:
         zamalowane tło zjada czytelność znaku, który na nim stoi. -->
    <Style Selector="ToggleButton.ikona:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Akcent}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="TextBlock.godzina">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Kwadracik odhaczenia rysowany z ramki i napisu. Gotowe pole wyboru ma
         w motywie własną najmniejszą wysokość, poniżej której nie schodzi — na bloku
         kwadransa układało się na trzydzieści dwa punkty, rysowało na szesnaście
         i przycinało krawędzią bloku do rogu. Ramka pokazuje się przy najechaniu,
         ptaszek widać zawsze, gdy zadanie jest odhaczone. Na dotyku najechania nie ma,
         więc tam odhacza się z listy, z menu podręcznego albo ze szczegółu. -->
    <Style Selector="Border.odhacz">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#00FFFFFF" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="#10FFFFFF" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- Blok jest przyciskiem, żeby kliknięcie otwierało szczegół. Własna oprawa
         przycisku wyłączona: barwę bloku niesie ramka w środku, a domyślne tło
         motywu zamalowałoby kolor kalendarza przy najechaniu. -->
    <Style Selector="Border.slot">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.slot">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.slot /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.slot:pointerover Border.odhacz">
      <Setter Property="BorderBrush" Value="#C0FFFFFF" />
      <Setter Property="Background" Value="#25FFFFFF" />
    </Style>

    <!-- Pasek dolny: pole dotyku na całą szerokość kolumny i wysokość, w którą trafia
         kciuk. Przycisk wielkości napisu jest na telefonie celem, nie przyciskiem. -->
    <Style Selector="Button.tab">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="4,12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.sheet">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Button.branch">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- Pusta lista nie ma rysować płyty. Domyślne tło listy przy braku pozycji daje
         szary prostokąt na pół ekranu, po którym nie widać, czy jest pusto, czy się
         nie wczytało. Dotyczy wszystkich list, nie tylko tej jednej. -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="FontSize" Value="12" />
      <!-- Zawijanie w stylu, nie przy każdym użyciu. Na telefonie każde podpowiedziane
           zdanie bez tego urywa się w połowie, a jest ich w tym pliku trzydzieści. -->
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Etykiety stanu bez czerwieni i bez wykrzykników: „przesunięte 4 razy" jest
         informacją, a ta sama liczba na czerwono jest wyrzutem (spec 11.1, N12–N15). -->
    <Style Selector="TextBlock.badge">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,10,0,3" />
    </Style>
    <Style Selector="ToggleButton.day">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
  </UserControl.Styles>

  <Grid>
  <DockPanel Margin="12">

    <!-- Odmowa, która nie miała gdzie się pokazać. Jeden pasek na całe okno, bo
         kliknięcie bez skutku zdarza się na każdym ekranie, a ramka z wyjaśnieniem
         stała tylko na jednym. -->
    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="14,10" CornerRadius="8"
            Background="#2E8C6A40"
            IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="rozumiem" Padding="10,4" Margin="10,0,0,0"
                VerticalAlignment="Top" Command="{Binding DismissNoticeCommand}" />
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Przypomnienia, które odezwały się przy starcie. Nad wszystkim, bo po to były
         ustawione; z przyciskiem odprawienia, bo mają zniknąć po przeczytaniu, a nie
         zostać jako kolejna lista do obsłużenia. -->
    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="14,10" CornerRadius="8"
            Background="#2E9C7A40" IsVisible="{Binding HasReminders}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Zakończ" Padding="10,4" Margin="10,0,0,0"
                VerticalAlignment="Top"
                Command="{Binding DismissRemindersCommand}" />
        <StackPanel>
          <TextBlock Text="Przypomnienia" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding Reminders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="abs:Notification">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Nawigacja szeroka: wszystkie ekrany naraz. Na pulpicie mieszczą się w rzędzie
         albo dwóch i są najkrótszą drogą do każdego z nich. -->
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16" IsVisible="{Binding ShowWideNav}">
      <Button Classes="nav" Command="{Binding ShowTodayCommand}" Content="Dzisiaj" />
      <Button Classes="nav" Command="{Binding ShowNowCommand}" Content="Teraz" />
      <Button Classes="nav" Command="{Binding ShowInboxCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Skrzynka" />
          <Border Background="#40808080" CornerRadius="9" Padding="7,1"
                  IsVisible="{Binding HasInbox}">
            <TextBlock Text="{Binding InboxCount}" FontSize="12" />
          </Border>
        </StackPanel>
      </Button>
      <Button Classes="nav" Command="{Binding ShowNextCommand}" Content="Następne" />
      <Button Classes="nav" Command="{Binding ShowProjectsCommand}" Content="Projekty" />
      <Button Classes="nav" Command="{Binding ShowSomedayCommand}" Content="Kiedyś" />
      <Button Classes="nav" Command="{Binding ShowWaitingCommand}" Content="Oczekiwane" />
      <Button Classes="nav" Command="{Binding ShowReviewCommand}" Content="Przegląd" />
      <Button Classes="nav" Command="{Binding ShowCalendarCommand}" Content="Kalendarz" />
      <Button Classes="nav" Command="{Binding ShowNotesCommand}" Content="Notatki" />
      <Button Classes="nav" Command="{Binding ShowFiltersCommand}" Content="Filtry" />
      <Button Classes="nav" Command="{Binding ShowAreasCommand}" Content="Obszary" />
      <Button Classes="nav" Command="{Binding ShowArchiveCommand}" Content="Archiwum" />
      <Button Classes="nav" Command="{Binding ShowSettingsCommand}" Content="Ustawienia" />
      <Button Classes="nav" Command="{Binding ShowJournalCommand}" Content="Co się działo" />
    </WrapPanel>

    <!-- Pasek dolny (wąskie okno). Cztery ekrany dnia codziennego pod kciukiem plus
         „Więcej" na resztę. Wybór czwórki nie jest dowolny: Dzisiaj jest ekranem
         startowym, Teraz odpowiada na „co robić", Skrzynka jest jedynym miejscem,
         które rośnie samo, a Kalendarz jest jedyną rzeczą z godziną. Reszta to ekrany,
         do których siada się świadomie, a nie zagląda między jednym a drugim. -->
    <Border DockPanel.Dock="Bottom" IsVisible="{Binding ShowBottomNav}"
            Margin="-12,8,-12,-12" Padding="4,0,4,2" Background="#22808080">
      <Grid ColumnDefinitions="*,*,*,*,*">
        <Button Grid.Column="0" Classes="tab" Content="Dzisiaj"
                Command="{Binding ShowTodayCommand}" />
        <Button Grid.Column="1" Classes="tab" Content="Teraz"
                Command="{Binding ShowNowCommand}" />
        <Button Grid.Column="2" Classes="tab" Command="{Binding ShowInboxCommand}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="Skrzynka" VerticalAlignment="Center" />
            <!-- Liczba tylko wtedy, gdy jest niezerowa, i bez czerwieni (spec 11.1). -->
            <Border Background="#40808080" CornerRadius="9" Padding="6,1"
                    IsVisible="{Binding HasInbox}">
              <TextBlock Text="{Binding InboxCount}" FontSize="11" />
            </Border>
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="tab" Content="Kalendarz"
                Command="{Binding ShowCalendarCommand}" />
        <Button Grid.Column="4" Classes="tab" Content="Więcej"
                Command="{Binding ToggleMoreCommand}" />
      </Grid>
    </Border>

    <!-- Wrzut na dole, nad paskiem. Na telefonie to jest miejsce, w którym stoi kciuk
         i nad którym otwiera się klawiatura; na górze ekranu pole do pisania każe
         sięgać przez cały ekran. Na pulpicie różnicy nie ma, więc jeden układ. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                IsVisible="{Binding ShowCapture}">
      <TextBox Text="{Binding CaptureText}"
               Watermark="Wrzuć myśl i naciśnij Enter"
               FontSize="16"
               AcceptsReturn="False">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding CaptureCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <TextBlock Classes="hint" Margin="2,4,0,0" IsVisible="{Binding ShowWideNav}"
                 Text="Bez pól, bez decyzji — obszar i reszta dochodzą przy przetwarzaniu." />
    </StackPanel>

    <!-- Ekrany leżą na sobie w jednej komórce; widoczny jest zawsze jeden. -->
    <Grid>

    <!-- Skrzynka -->
    <DockPanel IsVisible="{Binding IsInbox}">
      <Button DockPanel.Dock="Bottom" Margin="0,12,0,0"
              HorizontalAlignment="Stretch" Padding="14,12"
              Command="{Binding ShowClarifyCommand}"
              IsEnabled="{Binding HasInbox}"
              Content="Przetwórz skrzynkę" />
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                 Text="Przetwarzanie pokazuje jedną pozycję naraz." />
      <!-- Dwuklik otwiera szczegół. Do dziś jedyną drogą do wrzutu było przetwarzanie,
           więc dopisanie godziny do myśli, która już leży w skrzynce, wymagało przejścia
           przez całe drzewko decyzji. -->
      <ListBox ItemsSource="{Binding InboxItems}" DoubleTapped="OtworzZListy">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="tasks:TaskItem">
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Padding="0,4" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Przetwarzanie: jedna pozycja, bez listy w tle -->
    <!-- Widoczność i podmiana kontekstu muszą siedzieć na różnych elementach:
         DataContext ustawiony na elemencie obowiązuje też dla pozostałych powiązań
         na tym samym elemencie, więc IsVisible szukałoby właściwości w modelu
         przetwarzania zamiast w głównym. -->
    <Panel IsVisible="{Binding IsClarify}">
    <ScrollViewer DataContext="{Binding Clarify}">
      <StackPanel MaxWidth="560" HorizontalAlignment="Center"
                  x:DataType="vm:ClarifyViewModel">

        <!-- Wyjście z przetwarzania. Do dziś nie było stąd żadnej drogi na ekrany:
             pasek nawigacji jest w tym widoku schowany, żeby decyzja nie konkurowała
             z resztą aplikacji — ale „nie konkuruje" nie znaczy „nie da się wyjść". -->
        <Grid ColumnDefinitions="Auto,*">
          <Button Grid.Column="0" Classes="nav" Content="◀ wyjdź"
                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowCalendarCommand}" />
          <TextBlock Grid.Column="1" Classes="hint" HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Text="{Binding Remaining, StringFormat='Do rozstrzygnięcia: {0}'}" />
        </Grid>

        <Border Margin="0,12,0,20" Padding="20" CornerRadius="8" Background="#20808080">
          <TextBlock Text="{Binding Current.Title}" FontSize="22" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="Obszar" Classes="hint" />
        <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}"
                  HorizontalAlignment="Stretch" Margin="0,4,0,16" />

        <!-- Długość i siły pytane tutaj, przy decyzji: ekran „Teraz" dobiera pod
             dostępne minuty i poziom sił, więc zadanie bez oszacowania nie trafia tam
             nigdy. Dotąd dało się to wpisać tylko w szczegółach — czyli trzeba było
             przetworzyć skrzynkę, znaleźć zadanie na liście i otworzyć je jeszcze raz.
             Myśl jest najświeższa właśnie teraz. -->
        <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
          <StackPanel Grid.Column="0" Margin="0,0,6,0">
            <TextBlock Text="Ile to zajmie (minuty)" Classes="hint" />
            <NumericUpDown Value="{Binding EstimatedMinutes}" Minimum="1" Maximum="600"
                           Increment="5" FormatString="0" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <TextBlock Text="Ile trzeba mieć w sobie" Classes="hint" />
            <ComboBox ItemsSource="{Binding Energies}" SelectedItem="{Binding SelectedEnergy}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
        <TextBlock Classes="hint" Margin="2,0,0,16" TextWrapping="Wrap"
                   Text="{Binding EstimateHint}" />

        <TextBlock Text="Nie wymaga działania" Classes="hint" Margin="0,0,0,6" />
        <Button Classes="branch" Command="{Binding TrashCommand}" Content="Kosz" />
        <Button Classes="branch" Command="{Binding SomedayCommand}" Content="Kiedyś-może" />
        <Button Classes="branch" Command="{Binding ToNoteCommand}" Content="Materiał referencyjny (notatka)" />

        <TextBlock Text="Wymaga działania" Classes="hint" Margin="0,14,0,6" />
        <Button Classes="branch" Command="{Binding DoNowCommand}"
                Content="Zrobione teraz (krócej niż dwie minuty)" />
        <Button Classes="branch" Command="{Binding MakeNextCommand}" Content="Następna akcja" />

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBox Grid.Column="0" Text="{Binding WaitingForWho}" Watermark="Na kogo czekasz?" />
          <Button Grid.Column="1" Margin="6,0,0,0" Padding="14,10"
                  Command="{Binding DelegateCommand}" Content="Oczekiwane" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <DatePicker Grid.Column="0" SelectedDate="{Binding ScheduledFor}" />
          <Button Grid.Column="1" Margin="6,0,0,0" Padding="14,10"
                  Command="{Binding ScheduleCommand}" Content="Zaplanuj" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding ProjectOutcome}"
                   Watermark="Po czym poznasz, że to skończone?" />
          <Button Grid.Column="1" Margin="6,0,0,0" Padding="14,10"
                  Command="{Binding PromoteToProjectCommand}" Content="To projekt" />
        </Grid>
        <TextBlock Classes="hint" Margin="2,4,0,0"
                   Text="Projekt nazywa się wynikiem, nie czynnością." />

        <TextBlock Text="{Binding Problem}" Foreground="#E06C75" Margin="0,16,0,0"
                   TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
      </StackPanel>
    </ScrollViewer>
    </Panel>

    <!-- Następne akcje -->
    <ListBox IsVisible="{Binding IsNext}" ItemsSource="{Binding NextActions}" DoubleTapped="OtworzZListy">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TaskRow">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
              <TextBlock Classes="badge" Text="{Binding Badges}" TextWrapping="Wrap"
                         IsVisible="{Binding HasBadges}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Szczegół" Padding="10,4" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenCommand}"
                    CommandParameter="{Binding}" />
            <Button Grid.Column="2" Content="Zrobione" Padding="10,4"
                    VerticalAlignment="Center"
                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).CompleteCommand}"
                    CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Dzisiaj -->
    <DockPanel IsVisible="{Binding IsToday}">
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                 Text="Zadania na dziś i po terminie. Terminy pierwsze — to fakt zewnętrzny, nie decyzja." />

      <!-- Pięć slotów wyboru na dziś (8.6). To nie to samo co dzień wykonania:
           dzień wykonania może mieć dwadzieścia zadań, a to jest te pięć, na które
           się piszesz. -->
      <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="14,12" CornerRadius="8"
              Background="#18808080">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Na dziś" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Classes="hint" Text="{Binding FocusCount}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding FocusItems}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="tasks:TaskItem">
                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="zrobione" Padding="10,4"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CompleteTaskCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="zdejmij" Padding="10,4"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).UnfocusCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Szósty nie wchodzi, dopóki coś nie zejdzie. Limit działa bez oporu,
               bo dotyczy jednego dnia i zeruje się co dobę (8.6). -->
          <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="6" Background="#20808080"
                  IsVisible="{Binding HasPendingFocus}">
            <StackPanel Spacing="6">
              <TextBlock TextWrapping="Wrap">
                <Run Text="Pięć slotów jest zajętych. Co schodzi, żeby weszło:" />
                <Run Text="{Binding PendingFocus.Title}" FontWeight="SemiBold" />
                <Run Text="?" />
              </TextBlock>
              <Button Content="jednak nie" Padding="10,4" HorizontalAlignment="Left"
                      Command="{Binding CancelPendingFocusCommand}" />
            </StackPanel>
          </Border>

          <!-- Kandydaci: „Następne" i zaplanowane na dziś lub wcześniej (8.6).
               Nie to samo co lista poniżej — większość następnych akcji nie ma daty
               wykonania i bez tego miejsca nie dałoby się ich w ogóle wybrać. -->
          <StackPanel IsVisible="{Binding !FocusIsFull}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="label" Text="Do wyboru" />
              <!-- Granica „kiedyś-może" zostaje, ale da się ją przekroczyć świadomie.
                   Zadanie z dopisaną długością i siłą jest już opisane jak rzecz do
                   zrobienia, a mimo to nie dawało się go stąd wybrać w ogóle. -->
              <CheckBox Grid.Column="1" IsChecked="{Binding AlsoSomeday}"
                        Content="także z „Kiedyś”" FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer MaxHeight="220">
              <ItemsControl ItemsSource="{Binding FocusCandidates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TaskRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap"
                                 VerticalAlignment="Center" Opacity="0.8" />
                      <Button Grid.Column="1" Content="na dziś" Padding="10,4"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).FocusCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <TextBlock Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Niewykonany wybór po prostu wygasa o północy. Bez podsumowania i bez oceny." />
        </StackPanel>
      </Border>

      <!-- N1 i N3 trafiają tutaj, bo są sprawami na dziś. Cisza obszarów (N10) nigdy —
           to nie jest sprawa na dziś, a codzienne przypominanie zamieniłoby ją w szum. -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">

        <Border Padding="12,10" CornerRadius="8" Background="#18808080"
                IsVisible="{Binding HasNudges}">
          <StackPanel>
            <TextBlock Text="Do ponaglenia" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Nudges}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rev:WaitingItem">
                  <TextBlock Margin="0,2" TextWrapping="Wrap">
                    <Run Text="{Binding Task.Title}" />
                    <Run Text=" — " />
                    <Run Text="{Binding Who}" />
                    <Run Text=", " />
                    <Run Text="{Binding Days}" />
                    <Run Text=" dni" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="8" Background="#18808080"
                IsVisible="{Binding HasBlocked}">
          <StackPanel>
            <TextBlock Text="Projekty bez następnej akcji" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding BlockedProjects}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rev:BlockedProject">
                  <TextBlock Margin="0,2" TextWrapping="Wrap">
                    <Run Text="{Binding Outcome}" />
                    <Run Text=" · " />
                    <Run Text="{Binding AreaName}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
      <TextBlock Classes="hint" Margin="2,4,0,0" IsVisible="{Binding !HasToday}"
                 Text="Na dziś nic nie ma terminu ani dnia wykonania. To jest poprawny stan, nie pusty ekran." />
      <ListBox ItemsSource="{Binding TodayItems}" IsVisible="{Binding HasToday}" DoubleTapped="OtworzZListy">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TaskRow">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
              <StackPanel Grid.Column="0" VerticalAlignment="Center"
                          Opacity="{Binding Opacity}">
                <TextBlock TextWrapping="Wrap">
                  <Run Text="{Binding Mark}" />
                  <Run Text="{Binding Title}" />
                </TextBlock>
                <TextBlock Classes="badge" Text="{Binding Badges}" TextWrapping="Wrap"
                           IsVisible="{Binding HasBadges}" />
              </StackPanel>
              <Button Grid.Column="1" Content="na dziś" Padding="10,4" Margin="0,0,6,0"
                      IsVisible="{Binding !IsDone}"
                      VerticalAlignment="Center"
                      Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).FocusCommand}"
                      CommandParameter="{Binding}" />
              <Button Grid.Column="2" Content="Zrobione" Padding="10,4"
                      VerticalAlignment="Center" IsVisible="{Binding !IsDone}"
                      Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).CompleteCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Kiedyś-może -->
    <DockPanel IsVisible="{Binding IsSomeday}">
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                 TextWrapping="Wrap"
                 Text="Bez presji i bez terminu. Wraca, gdy dojrzeje. Prawy przycisk na pozycji — „Weź na dziś” wyjmuje ją stąd i robi z niej następną akcję." />
      <ListBox ItemsSource="{Binding SomedayItems}" DoubleTapped="OtworzZListy">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="tasks:TaskItem">
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Padding="0,4" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Teraz: odpowiedź na jedno pytanie, nie lista (8.1) -->
    <DockPanel IsVisible="{Binding IsNow}">
      <StackPanel DockPanel.Dock="Top" DataContext="{Binding Now}"
                  x:DataType="vm:NowViewModel" Margin="0,0,0,12">

        <TextBlock Classes="label" Text="Ile masz czasu" />
        <ComboBox ItemsSource="{Binding Minutes}" SelectedItem="{Binding SelectedMinutes}"
                  HorizontalAlignment="Stretch" />

        <TextBlock Classes="label" Text="Ile masz siły" />
        <ComboBox ItemsSource="{Binding Energies}" SelectedItem="{Binding SelectedEnergy}"
                  HorizontalAlignment="Stretch" />
        <TextBlock Classes="hint" Margin="2,4,0,0"
                   Text="Podpowiedziane z pory dnia. Do nadpisania jednym kliknięciem." />

        <!-- „Kiedyś-może" jest z założenia poza systemem rzeczy do zrobienia i dlatego
             ten ekran go nie rusza. Ale zadanie, któremu dopisano długość i siłę, jest
             już opisane tak jak rzecz do zrobienia — i odmowa pokazania go, gdy pyta
             się wprost, byłaby upieraniem się przy metodzie wbrew człowiekowi. -->
        <CheckBox IsChecked="{Binding AlsoSomeday}" Margin="0,10,0,0"
                  Content="sięgnij też do „Kiedyś”" />

        <!-- Pusty ekran z komunikatem „nic nie pasuje" byłby prawdą bezużyteczną.
             Zamiast niego mikrozadanie, które samo się rozwiązuje w miarę używania. -->
        <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="8" Background="#20808080"
                IsVisible="{Binding SuggestEstimating}">
          <TextBlock Text="{Binding EstimatePrompt}" TextWrapping="Wrap" />
        </Border>

      </StackPanel>

      <ScrollViewer DataContext="{Binding Now}">
        <ItemsControl ItemsSource="{Binding Picks}" x:DataType="vm:NowViewModel"
                      DoubleTapped="OtworzZListy">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="uc:NowPick">
              <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="8" Background="#18808080">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Task.Title}" TextWrapping="Wrap" FontSize="15" />
                    <!-- Powód jest częścią odpowiedzi, nie ozdobnikiem: lista bez
                         uzasadnienia każe wierzyć na słowo, a wtedy pierwszy chybiony
                         wybór odbiera jej zaufanie w całości. -->
                    <TextBlock Classes="badge" TextWrapping="Wrap">
                      <Run Text="{Binding Reason}" />
                      <Run Text=" · " />
                      <Run Text="{Binding Task.EstimatedMinutes}" />
                      <Run Text=" min" />
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Zrobione" Padding="12,6"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:NowViewModel)DataContext).CompleteCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Kalendarz godzinowy (spec 11). Wydarzenia pełne, zadania półprzezroczyste:
         umowa z kimś i zamiar wobec siebie nie mogą wyglądać tak samo. -->
    <!-- Widoczność i podmiana kontekstu na osobnych elementach. DataContext ustawiony
         na elemencie obowiązuje też dla pozostałych powiązań tego elementu, więc
         IsVisible szukałoby właściwości w modelu kalendarza zamiast w głównym. -->
    <Panel IsVisible="{Binding IsCalendar}">
    <DockPanel DataContext="{Binding Calendar}">

      <StackPanel DockPanel.Dock="Top" x:DataType="vm:CalendarViewModel" Margin="0,0,0,10">
        <WrapPanel>
          <Button Classes="nav" Command="{Binding PreviousCommand}" Content="◀" />
          <Button Classes="nav" Command="{Binding TodayCommand}" Content="dziś" />
          <Button Classes="nav" Command="{Binding NextCommand}" Content="▶" />
          <Button Classes="nav" Command="{Binding ShowDayCommand}" Content="dzień" />
          <Button Classes="nav" Command="{Binding ShowThreeDaysCommand}" Content="3 dni" />
          <Button Classes="nav" Command="{Binding ShowWeekCommand}" Content="tydzień" />
          <Button Classes="nav" Command="{Binding FetchCommand}" Content="Pobierz" />
        </WrapPanel>
        <TextBlock Classes="hint" Margin="2,6,0,0" Text="{Binding Range}" />
        <!-- Pusta siatka ma trzy przyczyny wyglądające tak samo. Ta linijka je rozdziela. -->
        <TextBlock Classes="hint" Margin="2,2,0,0" Text="{Binding Summary}" />
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />

        <!-- Cofnięcie po przeniesieniu wydarzenia. Przy zapisie do cudzego kalendarza
             nie jest wygodą, tylko jedyną odpowiedzią na omsknięcie ręki. -->
        <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="#20808080"
                IsVisible="{Binding CanUndo}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Classes="hint" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="{Binding UndoText}" />
            <Button Grid.Column="1" Classes="nav" Content="Cofnij"
                    Command="{Binding UndoMoveCommand}" />
            <Button Grid.Column="2" Classes="nav" Content="Zostaw"
                    Command="{Binding ForgetUndoCommand}" />
          </Grid>
        </Border>
      </StackPanel>

      <ScrollViewer x:Name="SiatkaKalendarza" x:DataType="vm:CalendarViewModel"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Horizontal">

          <!-- Godziny raz, z lewej, żeby nie powtarzać ich przy każdej kolumnie. -->
          <StackPanel Width="52">
            <Border Height="46" />
            <ItemsControl ItemsSource="{Binding HourLabels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Height="48">
                    <TextBlock Classes="hint" Text="{Binding}" VerticalAlignment="Top" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <ItemsControl Name="KolumnyDni" ItemsSource="{Binding Columns}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CalendarColumn">
                <StackPanel Margin="0,0,2,0">

                  <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Margin="0,0,0,4" />

                  <!-- Pasek całodniowy nad siatką, nie w niej: wydarzenie bez godziny
                       umieszczone o północy kłamałoby o porze. -->
                  <Border Height="24" CornerRadius="4" Background="#18808080"
                          IsVisible="{Binding HasAllDay}">
                    <ItemsControl ItemsSource="{Binding AllDay}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AllDayBox">
                          <Button Classes="slot" Padding="6,2" Margin="0,0,4,0"
                                  Height="24" VerticalContentAlignment="Center"
                                  Background="#20808080"
                                  Click="OtworzCalodniowe" Tag="{Binding}">
                            <TextBlock Text="{Binding Label}" FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <Border Height="24" IsVisible="{Binding !HasAllDay}" />

                  <!-- Rozmiar na liście, nie na płótnie pod nią. Płótno **nie mierzy się
                       swoją zawartością** — jego rozmiar własny to zero — więc lista
                       z płótnem w środku, wstawiona do drugiego płótna, dostawała
                       zero na zero i obcinała wszystko. Całodniowe rysowały się dalej,
                       bo idą zwykłym paskiem nad siatką; godzinowe znikały bez śladu. -->
                  <Panel>

                    <!-- Siatka pod blokami: po jednej linii na godzinę i pionowa
                         krecha na prawej krawędzi kolumny. Bez niej blok wisi
                         w pustce i nie widać, o której się zaczyna. Linie są
                         osobną warstwą, nie tłem bloków, bo mają być widoczne
                         również tam, gdzie nic nie zaplanowano. -->
                    <ItemsControl Name="Godziny" Tag="{Binding Date}"
                                  Loaded="WarstwaGodzinGotowa"
                                  PointerPressed="NowaRzeczNaSiatce"
                                  ItemsSource="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).HourLabels}"
                                  Width="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).ColumnWidth}"
                                  Background="#0C808080">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Border Height="48" BorderThickness="0,1,1,0" BorderBrush="#22808080" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Slots}"
                                  Height="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).GridHeight}"
                                  Width="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).ColumnWidth}"
                                  Background="{x:Null}">
                      <!-- Tło **puste**, nie przezroczyste. Przezroczyste jest w Avalonii
                           normalnym celem kliknięcia, więc warstwa bloków zjadała każde
                           kliknięcie na całej wysokości kolumny — także w miejscach, gdzie
                           nie ma żadnego bloku. Zakładanie zadania klikiem w pustą siatkę
                           nie działało wcale, bo zdarzenie nigdy nie docierało do warstwy
                           z liniami godzin. Puste tło przepuszcza klik dalej. -->
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter" x:DataType="vm:SlotBox">
                          <Setter Property="Canvas.Top" Value="{Binding Top}" />
                          <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        </ControlTheme>
                      </ItemsControl.ItemContainerTheme>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SlotBox">
                          <!-- Ramka, nie przycisk. Przycisk obsługuje wciśnięcie
                               wskaźnika sam i oznacza je jako załatwione, więc nasze
                               powiadomienia o przeciąganiu **nigdy do nas nie docierały**
                               i blok nie dawał się ruszyć. Kliknięcie rozpoznajemy sami:
                               puszczenie bez przejechania progu. -->
                          <Border Classes="slot" Width="{Binding Width}" Height="{Binding Height}"
                                  Tag="{Binding}"
                                  PointerPressed="BlokWcisniety"
                                  PointerMoved="BlokRuszony"
                                  PointerReleased="BlokPuszczony"
                                  Opacity="{Binding Opacity}"
                                  Background="{Binding Background}" CornerRadius="4" Padding="4,2">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                              <!-- Miejsce na odhaczenie zajęte na stałe, a nie odsłaniane:
                                   pole pojawiające się pod kursorem przesuwałoby tytuł
                                   w chwili najechania. Samo pole jest przezroczyste i
                                   nieklikalne do czasu najechania — niewidoczne, ale
                                   klikalne byłoby gorsze niż jedno i drugie naraz. -->
                              <!-- Bez najechania widać sam ptaszek, po najechaniu pole
                                   wyboru. Odhaczenie mieszka w polu, nie obok nazwy:
                                   ptaszek dopisany do tytułu był napisem, a nie stanem,
                                   i nie dawał się kliknąć. -->
                              <Panel Grid.Column="0" Width="{Binding CheckSize}"
                                     Margin="0,0,3,0"
                                     IsVisible="{Binding ShowMarkColumn}">
                                <Border Classes="odhacz" Tag="{Binding}"
                                        Width="{Binding CheckSize}"
                                        Height="{Binding CheckSize}"
                                        VerticalAlignment="Top" HorizontalAlignment="Left"
                                        PointerPressed="OdhaczNaSiatce">
                                  <TextBlock Text="✓" IsVisible="{Binding IsDone}"
                                             FontSize="{Binding MarkSize}"
                                             LineHeight="{Binding CheckSize}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Border>
                              </Panel>

                              <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11"
                                         TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />

                              <!-- Godziny przy prawej krawędzi. Blok pokazuje, ile coś trwa,
                                   ale nie od której — a to jest pierwsze pytanie o wpis. -->
                              <StackPanel Grid.Column="2" Margin="4,0,0,0"
                                          IsVisible="{Binding ShowTimes}">
                                <TextBlock Classes="godzina" Text="{Binding StartText}" />
                                <TextBlock Classes="godzina" Text="{Binding EndText}" />
                              </StackPanel>

                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Bieżąca godzina, tylko na dzisiejszej kolumnie i **nad** blokami.
                         Pod nimi ginęłaby dokładnie wtedy, gdy coś teraz trwa — czyli
                         w jedynym momencie, w którym cokolwiek znaczy. -->
                    <Canvas IsVisible="{Binding IsToday}">
                      <Border Canvas.Top="{Binding NowTop}" Canvas.Left="0" Height="2"
                              Background="#D0553C"
                              Width="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).ColumnWidth}" />
                    </Canvas>

                  </Panel>

                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Kliknięte wydarzenie z cudzego kalendarza. Zmienić się go stąd nie da (spec 10.2),
         ale „nie da się zmienić" to nie to samo co „kliknięcie nic nie robi" — drugie
         wygląda jak zepsuty przycisk. -->
    <Panel DataContext="{Binding Calendar}" IsVisible="{Binding HasOpened}"
           Background="#CC101010">
      <Border x:DataType="vm:CalendarViewModel" MaxWidth="480" Margin="12" Padding="20"
              CornerRadius="10" Background="#FF1E1E1E" VerticalAlignment="Center">
        <StackPanel Spacing="8">

          <TextBox Text="{Binding OpenedTitle}" FontSize="18"
                   IsEnabled="{Binding CanEditOpened}" />

          <TextBlock Classes="hint" Text="{Binding Opened.DayText}" />

          <Grid ColumnDefinitions="*,Auto,*">
            <TimePicker Classes="waska" Grid.Column="0" SelectedTime="{Binding OpenedStart}"
                        ClockIdentifier="24HourClock" IsEnabled="{Binding CanEditOpened}"
                        HorizontalAlignment="Stretch" />
            <TextBlock Grid.Column="1" Text="–" Margin="8,0" VerticalAlignment="Center" />
            <TimePicker Classes="waska" Grid.Column="2" SelectedTime="{Binding OpenedEnd}"
                        ClockIdentifier="24HourClock" IsEnabled="{Binding CanEditOpened}"
                        HorizontalAlignment="Stretch" />
          </Grid>

          <TextBlock Classes="hint" TextWrapping="Wrap" Foreground="#D0553C"
                     Text="{Binding OpenedProblem}" IsVisible="{Binding HasOpenedProblem}" />

          <StackPanel IsVisible="{Binding CanEditOpened}">
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Zapis idzie prosto do kalendarza Google. Zmieniamy tylko tytuł i godziny — uczestnicy, przypomnienia i opis zostają nietknięte." />
            <CheckBox Margin="0,8,0,0" IsChecked="{Binding ConfirmDelete}"
                      Content="Pozwól skasować to wydarzenie" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Skasowanego wydarzenia nie da się odzyskać — ani w Marshalu, ani w Google." />
          </StackPanel>

          <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding !CanEditOpened}"
                     Text="Ten kanał jest tylko do odczytu — zmiany rób tam, gdzie wydarzenie powstało." />

          <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Right">
            <Button Classes="nav" IsVisible="{Binding CanEditOpened}"
                    Command="{Binding SaveOpenedCommand}" Content="Zapisz" />
            <Button Classes="nav" IsVisible="{Binding CanEditOpened}"
                    Command="{Binding DeleteOpenedCommand}" Content="Skasuj" />
            <Button Classes="nav" Command="{Binding CloseOpenedCommand}" Content="Zamknij" />
          </WrapPanel>

        </StackPanel>
      </Border>
    </Panel>

    </Panel>

    <!-- Notatki: lista, edytor i podgląd obok siebie -->
    <Panel IsVisible="{Binding IsNotes}">
    <DockPanel DataContext="{Binding Notes}">

      <StackPanel DockPanel.Dock="Top" x:DataType="vm:NotesViewModel" Margin="0,0,0,10"
                  IsVisible="{Binding !IsEditing}">
        <TextBox Text="{Binding Query}" Watermark="Szukaj w notatkach" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <TextBox Grid.Column="0" Text="{Binding NewTitle}" Watermark="Tytuł nowej notatki">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1" Margin="6,0,0,0" Padding="14,10"
                  Command="{Binding CreateCommand}" Content="Nowa" />
        </Grid>
      </StackPanel>

      <Grid x:DataType="vm:NotesViewModel">

        <!-- Lista -->
        <DockPanel IsVisible="{Binding !IsEditing}">
          <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                     TextWrapping="Wrap" Text="{Binding Empty}"
                     IsVisible="{Binding !HasItems}" />
          <ListBox ItemsSource="{Binding Items}" DoubleTapped="OtworzNotatke">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dn:Note">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                  <!-- Przypięcie znakiem, nie kolorem: wizja i zasady mają się
                       wyróżniać, a nie krzyczeć. -->
                  <TextBlock Grid.Column="0" Text="📌" Margin="0,0,8,0"
                             IsVisible="{Binding IsPinned}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="Otwórz" Padding="10,4"
                          Command="{Binding $parent[ListBox].((vm:NotesViewModel)DataContext).OpenCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Edytor na całą szerokość, podgląd dopiero wtedy, gdy jest co podglądać.
             Stojąc zawsze, przy zwykłej notatce pokazywał dosłownie drugą kopię tego
             samego tekstu i zabierał na to połowę okna. Przełącznika „pisz / oglądaj"
             nadal nie ma: kazałby pamiętać, w którym trybie się jest, przy notatce
             pisanej raz i czytanej dziesięć razy. -->
        <DockPanel IsVisible="{Binding IsEditing}">

          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox Text="{Binding Title}" FontSize="18" />
            <WrapPanel Margin="0,8,0,0">
              <CheckBox IsChecked="{Binding IsPinned}" Content="Przypięta" Margin="0,0,14,0" />
              <Button Classes="nav" Command="{Binding SaveCommand}" Content="Zapisz" />
              <Button Classes="nav" Command="{Binding CloseCommand}" Content="Zamknij" />
              <Button Classes="nav" Command="{Binding DeleteCommand}" Content="Usuń" />
            </WrapPanel>
            <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap"
                       Text="Przypięta trafia do kroku zerowego przeglądu — tam, gdzie wizja i zasady." />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto">

            <TextBox Grid.Column="0" Text="{Binding Content}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Watermark="Markdown: # nagłówek, - punkt, **gruby**, *pochyły*" />

            <ScrollViewer Grid.Column="1" Width="320" Margin="10,0,0,0"
                          IsVisible="{Binding HasMarkup}">
              <ItemsControl ItemsSource="{Binding Preview}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BlockView">
                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="{Binding Margin}">
                      <Border Grid.Column="0" Width="{Binding Indent}" />
                      <!-- Cytat kreską z boku, punkt listy kropką: jedno i drugie
                           znakiem, nie kolorem. -->
                      <TextBlock Grid.Column="1" Text="•" Margin="0,0,6,0"
                                 IsVisible="{Binding IsListItem}" />
                      <Border Grid.Column="1" Width="3" Margin="0,0,8,0"
                              Background="#40808080" IsVisible="{Binding IsQuote}" />
                      <ItemsControl Grid.Column="2" ItemsSource="{Binding Spans}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SpanView">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                       FontWeight="{Binding Weight}"
                                       FontStyle="{Binding Style}"
                                       Opacity="{Binding Opacity}"
                                       FontSize="{Binding $parent[ItemsControl].((vm:BlockView)DataContext).FontSize}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

          </Grid>
        </DockPanel>

      </Grid>
    </DockPanel>
    </Panel>

    <!-- Filtry: konstruktor warunków i Ulubione (spec 11.5). Wszystkie osie widoczne
         naraz, każda domyślnie wyłączona — zamiast przycisku „dodaj warunek", który
         prowadzi do listy pól, a z niej do edytora zależnego od wybranego pola. Tu
         widać w jednym spojrzeniu, czym filtr jest, łącznie z tym, co nieustawione. -->
    <!-- Widoczność i podmiana kontekstu na osobnych elementach, x:DataType dopiero
         na dzieciach: na elemencie z DataContext obowiązywałby też dla samego
         {Binding Filters}. -->
    <Panel IsVisible="{Binding IsFilters}">
    <DockPanel DataContext="{Binding Filters}">

      <!-- Ulubione na górze: zapas gotowych odpowiedzi na pytanie „co teraz",
           ułożonych wtedy, kiedy dało się myśleć. -->
      <StackPanel DockPanel.Dock="Top" x:DataType="vm:FiltersViewModel"
                  Margin="0,0,0,10" IsVisible="{Binding HasFavourites}">
        <TextBlock Classes="label" Text="Ulubione" />
        <ItemsControl ItemsSource="{Binding Favourites}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="df:SavedFilter">
              <Button Classes="nav" Margin="0,4,8,0" Content="{Binding Name}"
                      Command="{Binding $parent[ItemsControl].((vm:FiltersViewModel)DataContext).OpenCommand}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Zapis na dole, bo jest ostatnim krokiem układania, a nie pierwszym. -->
      <Grid DockPanel.Dock="Bottom" x:DataType="vm:FiltersViewModel"
            ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
        <TextBox Grid.Column="0" Text="{Binding Name}"
                 Watermark="Nazwa widoku, np. „Kwadrans przed wyjściem”" />
        <Button Grid.Column="1" Margin="6,0,0,0" Padding="14,10" Content="Zapisz"
                Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
        <Button Grid.Column="2" Margin="6,0,0,0" Padding="14,10" Content="Wyczyść"
                Command="{Binding ResetCommand}" />
      </Grid>

      <ScrollViewer x:DataType="vm:FiltersViewModel">
        <StackPanel>

          <TextBlock Classes="label" Text="Stan" />
          <ItemsControl ItemsSource="{Binding States}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterToggle">
                <ToggleButton Margin="0,0,6,6" Padding="12,6"
                              Content="{Binding Label}" IsChecked="{Binding IsOn}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="label" Text="Obszar" />
          <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding Area}"
                    HorizontalAlignment="Stretch" />

          <TextBlock Classes="label" Text="Projekt" />
          <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding Project}"
                    HorizontalAlignment="Stretch" />

          <TextBlock Classes="label" Text="Tagi" />
          <ItemsControl ItemsSource="{Binding Tags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterToggle">
                <ToggleButton Margin="0,0,6,6" Padding="12,6"
                              Content="{Binding Label}" IsChecked="{Binding IsOn}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="label" Text="Termin" />
          <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding Deadline}"
                    HorizontalAlignment="Stretch" />

          <TextBlock Classes="label" Text="Dzień wykonania" />
          <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding DoDate}"
                    HorizontalAlignment="Stretch" />
          <!-- Okna liczone względem dzisiaj, nie datą z kalendarza: data wpisana
               w zapisany widok przestaje cokolwiek znaczyć po kilku dniach, nadal
               wyglądając na działającą. -->
          <TextBlock Classes="hint" Margin="2,4,0,0"
                     Text="Zawsze względem dzisiaj — zapisany widok ma być prawdziwy także za miesiąc." />

          <TextBlock Classes="label" Text="Mieści się w" />
          <ComboBox ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding Minutes}"
                    HorizontalAlignment="Stretch" />
          <TextBlock Classes="hint" Margin="2,4,0,0"
                     Text="Nieoszacowane nie mieści się w niczym — tak samo jak w „Teraz”." />

          <TextBlock Classes="label" Text="Waga" />
          <ItemsControl ItemsSource="{Binding Priorities}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterToggle">
                <ToggleButton Margin="0,0,6,6" Padding="12,6"
                              Content="{Binding Label}" IsChecked="{Binding IsOn}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="label" Text="Energia" />
          <ItemsControl ItemsSource="{Binding Energies}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterToggle">
                <ToggleButton Margin="0,0,6,6" Padding="12,6"
                              Content="{Binding Label}" IsChecked="{Binding IsOn}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="label" Text="Szukany tekst" />
          <TextBox Text="{Binding Text}" Watermark="W tytule albo w notatce zadania" />

          <TextBlock Classes="hint" Margin="2,10,0,0" TextWrapping="Wrap"
                     Text="{Binding Status}" IsVisible="{Binding HasStatus}" />

          <TextBlock Classes="label" Margin="0,18,0,0" Text="Wyniki" />
          <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding Empty}"
                     IsVisible="{Binding !HasResults}" />
          <ItemsControl ItemsSource="{Binding Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Classes="badge" Text="{Binding Badges}" TextWrapping="Wrap"
                               IsVisible="{Binding HasBadges}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Szczegół" Padding="10,4"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>

    </DockPanel>
    </Panel>

    <!-- Ustawienia: motyw, strefa, kopia zapasowa (spec 11, 12) -->
    <Panel IsVisible="{Binding IsSettings}">
    <ScrollViewer DataContext="{Binding Settings}">
      <StackPanel x:DataType="vm:SettingsViewModel" MaxWidth="560" HorizontalAlignment="Left">

        <TextBlock Classes="label" Text="Motyw" />
        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                  HorizontalAlignment="Stretch" />

        <TextBlock Classes="label" Margin="0,18,0,0" Text="Strefa, w której liczone są dni" />
        <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding Zone}"
                  HorizontalAlignment="Stretch" />
        <!-- Strefa jawna, nie z systemu (spec 3.4): wyjazd na zachód przestawiłby
             „dzisiaj" o dobę dokładnie wtedy, kiedy najmniej chce się to prostować. -->
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Nie bierzemy jej z systemu. Termin i dzień wykonania są bez strefy — ale to ona rozstrzyga, który dzień jest dzisiaj." />
        <TextBlock Classes="hint" Margin="2,6,0,0" Text="{Binding Now}" />
        <!-- Strefa nie do rozpoznania przesuwa wszystkie godziny naraz i wygląda
             przez to jak źle pobrane dane. Ostrzeżenie zamiast ciszy. -->
        <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap"
                   Foreground="#D0553C"
                   Text="{Binding ZoneProblem}" IsVisible="{Binding HasZoneProblem}" />

        <TextBlock Classes="label" Margin="0,18,0,0" Text="Kopia zapasowa" />
        <TextBlock Classes="hint" Margin="2,0,0,8" TextWrapping="Wrap"
                   Text="Jeden plik JSON, bez konta i bez sieci. Synchronizacja chroni przed utratą urządzenia; kopia chroni przed utratą Dysku, konta albo zaufania do nich." />
        <WrapPanel>
          <Button Classes="nav" Margin="0,0,8,8" Command="{Binding ExportCommand}"
                  Content="Zapisz kopię" />
          <Button Classes="nav" Margin="0,0,8,8" Command="{Binding ImportCommand}"
                  Content="Wczytaj kopię" />
        </WrapPanel>
        <CheckBox IsChecked="{Binding ReplaceOnImport}"
                  Content="Wczytaj z podmianą całości" />
        <!-- Podmiana wymaga świadomego kliknięcia, bo na urządzeniu podpiętym do
             synchronizacji jest pozorna: czyszczenie nie zostawia śladu w dzienniku,
             więc drugie urządzenie odda swój stan z powrotem. -->
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Bez zaznaczenia kopia scala się po zegarze: nowsze pole wygrywa i nic świeższego nie przepada. Z zaznaczeniem baza jest czyszczona — to tryb na urządzenie, które zaczyna od nowa." />

        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Text="{Binding Status}" />

        <TextBlock Classes="label" Margin="0,18,0,0" Text="Konto Google — synchronizacja" />
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="Poświadczenia zakłada się raz w konsoli Google; instrukcja jest w docs/google-dysk.md. Kanały iCal i kopia zapasowa działają bez tego." />

        <TextBlock Classes="label" Margin="0,10,0,0" Text="Identyfikator klienta" />
        <TextBox Text="{Binding GoogleClientId}"
                 Watermark="…apps.googleusercontent.com" />

        <TextBlock Classes="label" Margin="0,6,0,0" Text="Tajemnica klienta" />
        <TextBox Text="{Binding GoogleClientSecret}" PasswordChar="•"
                 Watermark="GOCSPX-…" />

        <CheckBox Margin="0,10,0,0" IsChecked="{Binding GoogleCalendar}"
                  Content="Czytaj i zmieniaj mój kalendarz Google" />
        <!-- Osobno i domyślnie wyłączone, bo te dwa uprawnienia różnią się ceną:
             drive.file nie jest wrażliwe i pozwala opublikować aplikację bez
             weryfikacji, calendar.readonly jest wrażliwe i publikacji już nie pozwoli.
             Wciągnięcie kalendarza do jednej zgody zabierałoby tę decyzję bez pytania. -->
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Uprawnienie do kalendarza jest przez Google uznane za wrażliwe: z nim aplikacji nie da się opublikować bez przeglądu, więc trzeba zostać w trybie testowym i logować się raz w tygodniu. Sama synchronizacja takiej ceny nie ma. Po zmianie tego pola zgoda jest pytana od nowa." />

        <WrapPanel Margin="0,10,0,0">
          <Button Classes="nav" Margin="0,0,8,6" Padding="14,10"
                  Command="{Binding SyncCommand}" IsEnabled="{Binding !IsSyncing}"
                  Content="Zapisz i zsynchronizuj" />
          <!-- Widoczne tylko w trakcie. Gdy Google odrzuci zgodę, przeglądarka zostaje
               na stronie błędu i nie wraca — bez tego przycisku jedynym wyjściem
               z czekania było zamknięcie aplikacji. -->
          <Button Classes="nav" Margin="0,0,0,6" Padding="14,10"
                  Command="{Binding CancelSyncCommand}" IsVisible="{Binding IsSyncing}"
                  Content="Przerwij" />
        </WrapPanel>

        <!-- Ręcznie, nie w tle. Pierwsze przebiegi na żywym koncie mają mieć widoczny
             wynik: synchronizacja uruchamiana po cichu przy starcie znaczy, że pierwszy
             błąd zobaczysz jako brakujące zadania, a nie jako komunikat. -->
        <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap"
                   Text="Przy pierwszym razie otworzy się przeglądarka i poprosi o zgodę. Potem już nie — żeton zostaje na tym urządzeniu. Na Androidzie ta droga jeszcze nie działa, bo wymaga osobnych poświadczeń." />

        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding SyncStatus}" />

        <TextBlock Classes="hint" Margin="2,8,0,0" TextWrapping="Wrap"
                   Text="{Binding TokenFolder, StringFormat='Żeton logowania: {0} — skasuj ten katalog, żeby zalogować się od nowa.'}" />

        <TextBlock Classes="label" Margin="0,22,0,0" Text="Kalendarze" />
        <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding !HasCalendars}"
                   Text="Nie ma podłączonego żadnego. Dopóki go nie ma, siatka godzinowa pokazuje same zadania." />

        <ItemsControl ItemsSource="{Binding Calendars}" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="dc:CalendarSource">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Classes="hint" Text="{Binding ExternalId}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center"
                           Margin="0,0,10,0" Text="{Binding Kind}" />
                <Button Grid.Column="2" Content="Odłącz" Padding="10,4" VerticalAlignment="Center"
                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveCalendarCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="label" Margin="0,12,0,0" Text="Dodaj kalendarz Google" />
        <Button Classes="nav" Padding="14,10"
                Command="{Binding LoadGoogleCalendarsCommand}"
                Content="Pobierz moje kalendarze" />
        <!-- Lista z konta, nie pole na identyfikator. Wpisywanie ręczne kończy się
             kalendarzami dodanymi po nazwie i błędem 404 przy każdym odświeżeniu:
             „Praca" jest nazwą, a Google chce abc@group.calendar.google.com. -->
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Wymaga zaznaczonego pola wyżej i zgody obejmującej kalendarz." />

        <ItemsControl ItemsSource="{Binding AvailableGoogleCalendars}" Margin="0,6,0,0"
                      IsVisible="{Binding HasAvailableGoogleCalendars}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="cal:GoogleCalendarInfo">
              <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Classes="hint" Text="{Binding Id}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Podłącz" Padding="10,4" VerticalAlignment="Center"
                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).AddGoogleCalendarCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="label" Margin="0,12,0,0" Text="Dodaj kanał iCal" />
        <Grid ColumnDefinitions="*,*,Auto">
          <TextBox Grid.Column="0" Margin="0,0,6,0" Text="{Binding NewIcalUrl}"
                   Watermark="https://…/kalendarz.ics" />
          <TextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding NewIcalName}"
                   Watermark="Nazwa" />
          <Button Grid.Column="2" Content="Dodaj" Padding="12,8"
                  Command="{Binding AddIcalCommand}" />
        </Grid>
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Kanał .ics nie wymaga konta Google ani niczego z instrukcji — wystarczy adres." />

        <Button Classes="nav" Margin="0,12,0,0" Padding="14,10"
                Command="{Binding RefreshCalendarsCommand}" Content="Odśwież kalendarze teraz" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding CalendarStatus}" />

      </StackPanel>
    </ScrollViewer>
    </Panel>

    <!-- Oczekiwane: sortowane po liczbie dni, najdłużej czekające na górze -->
    <DockPanel IsVisible="{Binding IsWaiting}">
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                 Text="Czekanie jest prawidłowym stanem. Próg ponaglenia jest własnością obszaru — urząd nie odpowiada w tydzień." />
      <ListBox ItemsSource="{Binding WaitingItems}" DoubleTapped="OtworzZListy">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="rev:WaitingItem">
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Task.Title}" TextWrapping="Wrap" />
                <TextBlock Classes="badge" TextWrapping="Wrap">
                  <Run Text="{Binding Who}" />
                  <Run Text=" · " />
                  <Run Text="{Binding Days}" />
                  <Run Text=" dni z " />
                  <Run Text="{Binding NudgeDays}" />
                </TextBlock>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="ponaglić" VerticalAlignment="Center"
                         Opacity="0.75" IsVisible="{Binding NeedsNudge}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Projekty: obszar, cel, projekt -->
    <DockPanel IsVisible="{Binding IsProjects}">
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8" TextWrapping="Wrap"
                 Text="Kwadracik po lewej ustawia barwę. Barwa obszaru schodzi na jego projekty i zadania, projekt może ją nadpisać. Prawy przycisk usuwa pusty projekt." />
      <ListBox ItemsSource="{Binding ProjectRows}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectTreeRow">
            <StackPanel Orientation="Horizontal" Margin="0,5" Spacing="10">
              <Border Width="{Binding Indent}" />
              <!-- Kwadracik barwy jest przyciskiem: barwę ustawia się tam, gdzie się ją
                   widzi. Osobny ekran ustawień kolorów znaczyłby, że po każdej zmianie
                   trzeba wrócić tutaj, żeby sprawdzić, co z tego wyszło. -->
              <Border Width="14" Height="14" CornerRadius="3"
                      VerticalAlignment="Center" Cursor="Hand"
                      Background="{Binding Swatch}"
                      BorderThickness="1" BorderBrush="#40808080"
                      PointerPressed="NaBarwie" />
              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <!-- N1 napisem, nie kolorem: plakietka bez treści uczy ignorowania. -->
              <TextBlock Classes="badge" Text="{Binding Marker}"
                         IsVisible="{Binding IsBlocked}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Obszary: tabela równowagi (8.5) plus progi -->
    <DockPanel IsVisible="{Binding IsAreas}">
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8" TextWrapping="Wrap"
                 Text="Równowaga nie znaczy równy rozkład. Trzy miesiące w jednym obszarze bywają prawidłową decyzją — tabela ma pokazać, że zapadła." />
      <!-- Barwy mają jedno miejsce, a nie dwa: na „Projektach" widać obszar razem z tym,
           co pod nim wisi, więc od razu widać, co dany kolor zabarwi. -->
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8" TextWrapping="Wrap"
                 Text="Barwę obszaru ustawia się na ekranie „Projekty” — kwadracikiem przy jego nazwie. Schodzi stamtąd na projekty i zadania." />
      <ListBox ItemsSource="{Binding BalanceRows}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="rev:AreaBalance">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,5">
              <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center"
                         Width="130" TextAlignment="Right"
                         Text="{Binding ActiveProjects, StringFormat='{}{0} aktywnych'}" />
              <!-- Sama liczba dni, bez ocen i bez czerwieni: etykieta dokłada wstyd,
                   który nie pomaga podjąć działania (8.5). -->
              <TextBlock Grid.Column="2" Classes="hint" VerticalAlignment="Center"
                         Width="150" TextAlignment="Right"
                         Text="{Binding DaysSinceMove, StringFormat='{}{0} dni bez ruchu'}"
                         IsVisible="{Binding DaysSinceMove, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Grid.Column="2" Classes="hint" VerticalAlignment="Center"
                         Width="150" TextAlignment="Right" Text="brak ruchu"
                         IsVisible="{Binding DaysSinceMove, Converter={x:Static ObjectConverters.IsNull}}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Przegląd tygodniowy: kreator ośmiu kroków (8.3) -->
    <Panel IsVisible="{Binding IsReview}">
    <ScrollViewer DataContext="{Binding Review}">
      <StackPanel MaxWidth="620" HorizontalAlignment="Center"
                  x:DataType="vm:ReviewViewModel">

        <StackPanel IsVisible="{Binding !IsFinished}">

          <TextBlock Classes="hint" HorizontalAlignment="Center" Text="{Binding StepNumber}" />
          <TextBlock Text="{Binding StepTitle}" FontSize="22" Margin="0,6,0,4"
                     TextWrapping="Wrap" HorizontalAlignment="Center" />
          <TextBlock Classes="hint" Text="{Binding StepHint}" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBlock Classes="hint" Text="{Binding Remaining}" Margin="0,10,0,0"
                     HorizontalAlignment="Center" IsVisible="{Binding !IsPinnedStep}" />
          <TextBlock Classes="hint" HorizontalAlignment="Center" Margin="0,2,0,0"
                     Text="{Binding TotalRemaining, StringFormat='w całym przeglądzie: {0}'}" />

          <!-- Krok zerowy: sam tekst, bez żadnej akcji. Jest po to, żeby reszta
               przeglądu działa się po jego przeczytaniu, a nie żeby coś z nim zrobić. -->
          <Border Margin="0,16,0,0" Padding="18" CornerRadius="8" Background="#18808080"
                  IsVisible="{Binding IsPinnedStep}">
            <StackPanel Spacing="10">
              <TextBlock TextWrapping="Wrap"
                         Text="Aplikacja nie może liczyć na to, że przegląd się odbędzie. Wszystko, co tu zobaczysz, wyliczyło się samo — nie musiałaś o tym pamiętać." />
              <TextBlock TextWrapping="Wrap"
                         Text="Przerwanie w dowolnym momencie nic nie kosztuje. Stan zapisuje się po każdej pojedynczej pozycji, więc przegląd rozłożony na pięć wieczorów jest przeglądem zrobionym." />
              <!-- Przypięte notatki: czwarty i piąty horyzont GTD. Rzeczy, których nie
                   da się odhaczyć, więc nie mają tu żadnego przycisku. -->
              <ItemsControl ItemsSource="{Binding Pinned}" IsVisible="{Binding HasPinned}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="dn:Note">
                    <StackPanel Margin="0,10,0,0" Spacing="3">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Opacity="0.85" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding !HasPinned}"
                         Text="Nie masz jeszcze przypiętych notatek. Przypnij tę, którą chcesz czytać przed każdym przeglądem — wizję albo zasady." />
            </StackPanel>
          </Border>

          <!-- Krok ósmy: tabela do obejrzenia, nie lista do odhaczenia. -->
          <StackPanel Margin="0,16,0,0" IsVisible="{Binding IsBalanceStep}">
            <ItemsControl ItemsSource="{Binding Balance}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rev:AreaBalance">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,5">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Classes="hint" Width="120" TextAlignment="Right"
                               Text="{Binding ActiveProjects, StringFormat='{}{0} aktywnych'}" />
                    <TextBlock Grid.Column="2" Classes="hint" Width="150" TextAlignment="Right"
                               Text="{Binding DaysSinceMove, StringFormat='{}{0} dni bez ruchu'}"
                               IsVisible="{Binding DaysSinceMove, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Grid.Column="2" Classes="hint" Width="150" TextAlignment="Right"
                               Text="brak ruchu"
                               IsVisible="{Binding DaysSinceMove, Converter={x:Static ObjectConverters.IsNull}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Krok skrzynki: pozycji się nie odhacza, tylko się je przetwarza.
               Oznaczenie wrzutu jako „rozpatrzony" zostawiłoby go w skrzynce,
               a za tydzień trzeba by go oznaczyć znowu. -->
          <StackPanel IsVisible="{Binding IsInboxStep}" Margin="0,16,0,0">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rev:ReviewItem">
                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Stretch" Margin="0,12,0,0" Padding="14,10"
                    Command="{Binding ProcessInboxCommand}" IsEnabled="{Binding HasItems}"
                    Content="Przetwórz skrzynkę" />
            <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap"
                       Text="Przegląd zostaje otwarty — wróci na ten sam krok." />
          </StackPanel>

          <!-- Pozycje kroku. Odhaczenie zapisuje się natychmiast — to jest cały
               mechanizm wznawialności, a nie optymalizacja. -->
          <ItemsControl ItemsSource="{Binding Items}" Margin="0,16,0,0"
                        IsVisible="{Binding HasChecklist}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="rev:ReviewItem">
                <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="8" Background="#18808080">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                      <TextBlock Classes="badge" Text="{Binding Detail}" TextWrapping="Wrap"
                                 IsVisible="{Binding HasDetail}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Rozpatrzone" Padding="12,6"
                            VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:ReviewViewModel)DataContext).ProcessCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,20,0,0">
            <Button Grid.Column="0" Content="Wstecz" Padding="14,8"
                    IsEnabled="{Binding CanGoBack}" Command="{Binding BackCommand}" />
            <Button Grid.Column="2" Padding="14,8" Command="{Binding NextCommand}"
                    Content="Dalej" IsVisible="{Binding !IsLastStep}" />
            <Button Grid.Column="2" Padding="14,8" Command="{Binding NextCommand}"
                    Content="Zakończ przegląd" IsVisible="{Binding IsLastStep}" />
          </Grid>

          <TextBlock Classes="hint" Margin="0,10,0,0" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center"
                     Text="Można wyjść w każdej chwili. Nieukończony przegląd nie wygasa i o sobie nie przypomina." />

        </StackPanel>

        <!-- Zakończenie bez podsumowania „wykonano 2 z 5" i bez oceny. -->
        <Border IsVisible="{Binding IsFinished}" Margin="0,40,0,0" Padding="24"
                CornerRadius="10" Background="#18808080">
          <StackPanel Spacing="10">
            <TextBlock Text="Przegląd zamknięty." FontSize="20" HorizontalAlignment="Center" />
            <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Następny założy się sam, kiedy tu wrócisz. Bez terminu i bez licznika dni." />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
    </Panel>

    <!-- Co się działo (spec 12). „Nic się nie stało" i „zadziałało" wyglądają na
         ekranie identycznie — ten ekran jest jedynym miejscem, gdzie się rozchodzą. -->
    <Panel IsVisible="{Binding IsJournal}">
    <DockPanel DataContext="{Binding Journal}">

      <StackPanel DockPanel.Dock="Top" x:DataType="vm:JournalViewModel" Margin="0,0,0,10">
        <WrapPanel>
          <Button Classes="nav" Command="{Binding RefreshCommand}" Content="Odśwież" />
          <Button Classes="nav" Command="{Binding ClearCommand}" Content="Wyczyść" />
          <CheckBox Margin="8,0,0,0" VerticalAlignment="Center"
                    IsChecked="{Binding OnlyProblems}" Content="tylko problemy" />
        </WrapPanel>
        <!-- Piątka na dziś nad siatką, nie wstawiana w siatkę z góry: wolny blok wybrany
             przez aplikację byłby zgadywaniem, kiedy się na to zbierzesz. Ptaszek
             zapisuje blok wstecz — kończący się teraz, o długości oszacowania. -->
        <ItemsControl Margin="0,6,0,0"
                      ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).FocusOffGrid}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="tasks:TaskItem">
              <Border Margin="0,0,6,6" Padding="8,4" CornerRadius="6" Background="#20808080">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <CheckBox MinWidth="0" Padding="0"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CompleteTaskCommand}"
                            CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap" Text="{Binding Summary}" />
        <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="Zapis lokalny, nie wchodzi do synchronizacji ani do kopii. Trzymane jest ostatnie 500 wpisów." />
      </StackPanel>

      <ScrollViewer x:DataType="vm:JournalViewModel">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:JournalRow">
              <Border Margin="0,0,0,6" Padding="10,6" CornerRadius="6"
                      Background="#0C808080" BorderThickness="3,0,0,0"
                      BorderBrush="{Binding Mark}">
                <StackPanel>
                  <TextBlock Classes="hint" Text="{Binding When}" />
                  <TextBlock Text="{Binding Operation}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" />
                  <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>
    </Panel>

    <!-- Archiwum -->
    <DockPanel IsVisible="{Binding IsArchive}">
      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                 Text="Wykonane i wyrzucone, najnowsze pierwsze. Nic nie znika z bazy." />
      <ListBox ItemsSource="{Binding ArchiveItems}" DoubleTapped="OtworzZListy">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="tasks:TaskItem">
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
              <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap" Opacity="0.75" />
              <TextBlock Grid.Column="1" Classes="hint" Text="{Binding State}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    </Grid>
  </DockPanel>

      <!-- „Więcej": reszta ekranów. Nakładka, nie kolejny ekran — wybranie czegoś
           ma być jednym gestem, a nie wejściem w listę i wyjściem z niej.
           Widoczność i podmiana kontekstu na osobnych elementach, jak wszędzie. -->
      <Panel IsVisible="{Binding IsMoreOpen}" Background="#CC101010">
      <Border VerticalAlignment="Bottom" Padding="12" CornerRadius="12,12,0,0"
              Background="#FF1E1E1E">
      <ScrollViewer MaxHeight="440">
        <StackPanel>
          <Button Classes="sheet" Content="Następne" Command="{Binding ShowNextCommand}" />
          <Button Classes="sheet" Content="Projekty" Command="{Binding ShowProjectsCommand}" />
          <Button Classes="sheet" Content="Oczekiwane" Command="{Binding ShowWaitingCommand}" />
          <Button Classes="sheet" Content="Kiedyś" Command="{Binding ShowSomedayCommand}" />
          <Button Classes="sheet" Content="Przegląd" Command="{Binding ShowReviewCommand}" />
          <Button Classes="sheet" Content="Notatki" Command="{Binding ShowNotesCommand}" />
          <Button Classes="sheet" Content="Filtry" Command="{Binding ShowFiltersCommand}" />
          <Button Classes="sheet" Content="Obszary" Command="{Binding ShowAreasCommand}" />
          <Button Classes="sheet" Content="Archiwum" Command="{Binding ShowArchiveCommand}" />
          <Button Classes="sheet" Content="Ustawienia" Command="{Binding ShowSettingsCommand}" />
          <Button Classes="sheet" Content="Co się działo" Command="{Binding ShowJournalCommand}" />
          <Button Classes="sheet" Content="Zamknij" Margin="0,8,0,0"
                  Command="{Binding CloseMoreCommand}" />
        </StackPanel>
      </ScrollViewer>
      </Border>
      </Panel>

      <!-- Szczegół zadania: nakładka nad ekranami, nie osobna pozycja w nawigacji.
           Ta sama sztuczka co przy przetwarzaniu: widoczność na jednym elemencie,
           podmiana kontekstu na drugim, bo DataContext ustawiony na elemencie
           obowiązuje też dla pozostałych powiązań na tym samym elemencie. -->
      <!-- Podgląd przeciąganego bloku. Nad wszystkim i nieprzezroczysty dla wskaźnika,
           żeby nie łapał zdarzeń, które należą do siatki pod nim. -->
      <Canvas Name="WarstwaPodgladu" IsHitTestVisible="False">
        <Border Name="Podglad" IsVisible="False" Padding="8,5" CornerRadius="6"
                Background="#E6303030" BorderBrush="#80FFFFFF" BorderThickness="1">
          <StackPanel>
            <TextBlock Name="PodgladTytul" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Name="PodgladKiedy" FontSize="12" Opacity="0.85" />
          </StackPanel>
        </Border>
      </Canvas>

      <Panel IsVisible="{Binding Detail.IsOpen}" Background="{DynamicResource Zaslona}"
             PointerPressed="TloSzczegolu">
      <!-- Kliknięcie w przyciemnione tło zamyka okno, kliknięcie w samo okno nie:
           zdarzenie zatrzymuje się na ramce, więc do tła nie dociera. -->
      <Border MaxWidth="560" MaxHeight="620" Margin="8" Padding="24" CornerRadius="14"
              Background="{DynamicResource Karta}" VerticalAlignment="Center"
              BorderThickness="1" BorderBrush="{DynamicResource Krawedz}"
              PointerPressed="ZatrzymajKlikniecie">
      <ScrollViewer Name="SzczegolPrzewijanie" DataContext="{Binding Detail}">
        <StackPanel x:DataType="vm:TaskDetailViewModel">

          <Grid ColumnDefinitions="Auto,*">
            <!-- Ptaszek przy nazwie zamiast przycisku „Zrobione" na dole: odhaczenie
                 dotyczy tej jednej rzeczy, której nazwa stoi obok, a nie okna. -->
            <CheckBox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                      IsVisible="{Binding IsExisting}" Click="OdhaczZadanie" />
            <!-- Znak wodny, bo puste pole bez podpisu jest samym prostokątem:
                 nie widać po nim, że to jest miejsce na nazwę zadania. -->
            <TextBox Grid.Column="1" Text="{Binding Title}" FontSize="18"
                     Watermark="Co jest do zrobienia?"
                     KeyDown="NazwaKlawisz" />
          </Grid>

          <!-- Nieudany zapis zamykał okno tak samo jak udany. -->
          <TextBlock Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap" Foreground="#D0553C"
                     Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />

          <TextBlock Classes="label" Text="Notatka" />
          <TextBox Text="{Binding Note}" AcceptsReturn="True" MinHeight="60"
                   TextWrapping="Wrap" Watermark="Cokolwiek, co pomoże zacząć" />

          <TextBlock Classes="label" Text="Miejsce — obszar albo projekt w nim" />
          <!-- Jedna lista, wcięciem udająca drzewko: wybór projektu jest zarazem
               wyborem jego obszaru, więc nie da się wskazać sprzecznej pary. -->
          <ComboBox ItemsSource="{Binding Placements}" SelectedItem="{Binding SelectedPlacement}"
                    HorizontalAlignment="Stretch" PlaceholderText="jeszcze nierozstrzygnięte">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PlacementChoice">
                <StackPanel Orientation="Horizontal">
                  <Border Width="{Binding Indent}" />
                  <TextBlock Text="{Binding Label}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Classes="label" Text="Dzień wykonania — obietnica dana sobie" />
          <DatePicker SelectedDate="{Binding DoDate}" HorizontalAlignment="Stretch" />

          <TextBlock Classes="label" Text="Od której do której" />
          <Grid ColumnDefinitions="*,Auto,*">
            <TimePicker Classes="waska" Grid.Column="0" SelectedTime="{Binding DoTime}"
                        ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Column="1" Text="–" Margin="8,0" VerticalAlignment="Center" />
            <TimePicker Classes="waska" Grid.Column="2" SelectedTime="{Binding EndTime}"
                        ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
          </Grid>
          <TextBlock Classes="hint" Margin="2,4,0,0" TextWrapping="Wrap"
                     Text="Bez godziny zadanie idzie na pasek całodniowy. Bez godziny końca trwa pół godziny." />

          <!-- Rzadkie pola pod jednym przełącznikiem. Okno miało dwanaście pól jedno
               pod drugim i do przycisku zapisu trzeba było przewijać; pole, które
               w dziewięciu zadaniach na dziesięć zostaje puste, jest w oknie kosztem,
               a nie możliwością. Podsumowanie obok, żeby zwinięte nie znaczyło
               „nie wiadomo, co tam jest". -->
          <!-- Pasek ikon: każda odsłania swoją rzecz. Dopisanie terminu nie ma
               wywlekać rytmu, wagi i energii, których się nie dotyka. Podpowiedzi
               po najechaniu, bo dziesięć symboli do zapamiętania to za dużo przy
               oknie otwieranym kilka razy dziennie. -->
          <WrapPanel Margin="0,14,0,0">
            <ToggleButton Classes="ikona" IsChecked="{Binding ShowDeadline}"
                          Content="📅" ToolTip.Tip="Termin" />
            <ToggleButton Classes="ikona" IsChecked="{Binding ShowReminder}"
                          Content="🔔" ToolTip.Tip="Przypomnienie" />
            <ToggleButton Classes="ikona" IsChecked="{Binding ShowPriority}"
                          Content="❗" ToolTip.Tip="Waga" />
            <ToggleButton Classes="ikona" IsChecked="{Binding ShowEnergy}"
                          Content="🔋" ToolTip.Tip="Ile trzeba mieć w sobie" />
            <ToggleButton Classes="ikona" IsChecked="{Binding ShowRepeat}"
                          Content="🔁" ToolTip.Tip="Rytm" />
          </WrapPanel>

          <StackPanel>
          <StackPanel IsVisible="{Binding ShowDeadline}">
            <TextBlock Classes="label" Text="Termin — fakt zewnętrzny, świat się nie przesunie" />
            <DatePicker SelectedDate="{Binding Deadline}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel IsVisible="{Binding ShowReminder}">
          <TextBlock Classes="label" Text="Przypomnienie — kiedy chcesz o tym usłyszeć" />
          <Grid ColumnDefinitions="*,Auto">
            <DatePicker Classes="waska" Grid.Column="0" SelectedDate="{Binding ReminderDay}"
                        HorizontalAlignment="Stretch" />
            <TimePicker Classes="waska" Grid.Column="1" Margin="6,0,0,0" SelectedTime="{Binding ReminderTime}"
                        ClockIdentifier="24HourClock" />
          </Grid>
          <TextBlock Classes="hint" Margin="2,4,0,0"
                     Text="Bez godziny znaczy rano. Sama godzina bez dnia nie znaczy nic." />
          </StackPanel>

          <StackPanel IsVisible="{Binding ShowPriority}">
            <TextBlock Classes="label" Text="Waga" />
            <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>

          <!-- Bez oszacowania zadanie nigdy nie trafi do „Teraz" (8.1). To nie jest
               surowość, tylko warunek: widok dobierający pod dostępne minuty nie ma jak
               ocenić czegoś, co nie ma długości. -->
          <TextBlock Classes="label" Text="Ile to zajmie (minuty)" />
          <NumericUpDown Value="{Binding EstimatedMinutes}" Minimum="1" Maximum="600"
                         Increment="5" FormatString="0" />

          <StackPanel IsVisible="{Binding ShowEnergy}">
            <TextBlock Classes="label" Text="Ile trzeba mieć w sobie" />
            <ComboBox ItemsSource="{Binding Energies}" SelectedItem="{Binding SelectedEnergyLevel}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Classes="hint" Margin="2,4,0,0"
                       Text="Nieokreślona przechodzi przy każdym poziomie — brak decyzji nie udaje decyzji." />
          </StackPanel>
          </StackPanel>

          <Border Margin="0,18,0,0" Padding="14" CornerRadius="8" Background="#18808080"
                  IsVisible="{Binding ShowRepeat}">
            <StackPanel>

              <TextBlock Text="Rytm" FontWeight="SemiBold" />

              <TextBlock Classes="label" Text="Jak często" />
              <ComboBox ItemsSource="{Binding Repeats}" SelectedItem="{Binding SelectedRepeat}"
                        HorizontalAlignment="Stretch" />

              <StackPanel IsVisible="{Binding NeedsInterval}">
                <TextBlock Classes="label" Text="Co ile" />
                <NumericUpDown Value="{Binding Interval}" Minimum="1" Maximum="99"
                               Increment="1" FormatString="0" />
              </StackPanel>

              <StackPanel IsVisible="{Binding NeedsWeekdays}">
                <TextBlock Classes="label" Text="W które dni" />
                <WrapPanel>
                  <ToggleButton Classes="day" IsChecked="{Binding Monday}" Content="pn" />
                  <ToggleButton Classes="day" IsChecked="{Binding Tuesday}" Content="wt" />
                  <ToggleButton Classes="day" IsChecked="{Binding Wednesday}" Content="śr" />
                  <ToggleButton Classes="day" IsChecked="{Binding Thursday}" Content="cz" />
                  <ToggleButton Classes="day" IsChecked="{Binding Friday}" Content="pt" />
                  <ToggleButton Classes="day" IsChecked="{Binding Saturday}" Content="sb" />
                  <ToggleButton Classes="day" IsChecked="{Binding Sunday}" Content="nd" />
                </WrapPanel>
              </StackPanel>

              <StackPanel IsVisible="{Binding NeedsDayOfMonth}">
                <TextBlock Classes="label" Text="Którego dnia miesiąca" />
                <NumericUpDown Value="{Binding DayOfMonth}" Minimum="1" Maximum="31"
                               Increment="1" FormatString="0" />
                <TextBlock Classes="hint" Margin="2,4,0,0"
                           Text="31 znaczy ostatniego — w lutym wypadnie 28 albo 29." />
              </StackPanel>

              <StackPanel IsVisible="{Binding IsRepeating}">
                <TextBlock Classes="label" Text="Kolejne liczone" />
                <ComboBox ItemsSource="{Binding Anchors}" SelectedItem="{Binding SelectedAnchor}"
                          HorizontalAlignment="Stretch" />

                <TextBlock Classes="label" Text="Gdy dzień minie niewykonany" />
                <ComboBox ItemsSource="{Binding Missed}" SelectedItem="{Binding SelectedMissed}"
                          HorizontalAlignment="Stretch" />
              </StackPanel>

              <!-- Rytm zdaniem, nie formularzem. Sześć pól da się wypełnić źle i nie
                   zauważyć; zdanie da się przeczytać i od razu wiedzieć, czy o to chodziło. -->
              <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="6" Background="#20808080">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontStyle="Italic" />
              </Border>

            </StackPanel>
          </Border>

          <!-- Bez pośrednika: okno woła metodę wprost. Polecenie asynchroniczne ma
               własny warunek wykonalności i własne pilnowanie jednoczesności, a jedno
               i drugie potrafi cicho odmówić — odmowa wygląda wtedy dokładnie jak
               martwy przycisk i nie zostawia śladu nigdzie. -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0"
                      HorizontalAlignment="Right">
            <Button Padding="14,8" Click="ZamknijZadanie" Content="Zamknij" />
            <Button Padding="14,8" Click="ZapiszZadanie" Content="Zapisz" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
      </Border>
      </Panel>
  </Grid>
</UserControl>
