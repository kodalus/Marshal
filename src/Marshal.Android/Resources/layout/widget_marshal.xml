<?xml version="1.0" encoding="utf-8"?>
<!--
  Pasek tygodnia nad listą.

  Widget odpowiadał na pytanie „co mam dziś" i na nic więcej: żeby zobaczyć czwartek,
  trzeba było trafić strzałkę cztery razy i po drodze nie było widać, dokąd się idzie.
  Tydzień na wierzchu odpowiada na to jednym spojrzeniem — który dzień jest oglądany,
  które dni mają cokolwiek i jak daleko do soboty.

  Siedem kolumn wypisanych wprost, bo RemoteViews nie zna pętli: system rozwija ten
  układ w procesie ekranu domowego i wolno tu wyłącznie to, co umie rozwinąć. Stąd
  też znikanie kropki i kreski przez podmianę tła na przezroczyste, a nie przez
  ukrycie — ukryty widok oddaje miejsce, a oddane miejsce przesuwa numery w kolumnach
  obok i pasek przestaje być siatką.

  updatePeriodMillis zostaje zerem świadomie: system i tak nie odświeża częściej
  niż co pół godziny, a widget ma być aktualny **po zmianie**, nie co pół godziny.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/root"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="10dp"
              android:background="@drawable/widget_background">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

