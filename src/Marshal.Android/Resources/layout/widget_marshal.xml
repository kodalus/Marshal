<?xml version="1.0" encoding="utf-8"?>
<!--
  Lista przewijana, nie wiersze wpisane na sztywno.

  Do dziś było tu osiem wierszy wprost, bo przy stałym limicie pięciu pozycji cała
  machina listy obsługiwałaby liczbę, która się nie zmienia. Plan całego dnia nie ma
  takiego limitu: bierze też rzeczy umówione i zaległe, a tych bywa dowolnie wiele.
  Wiersz, którego nie widać, jest w planie dnia tym samym co wiersz, którego nie ma.

  ListView w widgecie znaczy osobną usługę (TodayWidgetService) i osobną fabrykę
  widoków — system rozwija wiersze w procesie ekranu domowego, a nie w naszym.
  Stąd też inny sposób na kliknięcie: wzorzec zamiaru na liście i uzupełnienie
  przy wierszu, bo pojedynczemu wierszowi listy nie da się dać własnego zamiaru.

  updatePeriodMillis zostaje zerem świadomie: system i tak nie odświeża częściej
  niż co pół godziny, a widget ma być aktualny **po zmianie**, nie co pół godziny.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/korzen"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="12dp"
              android:background="@drawable/tlo_widgetu">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <Button
        android:id="@+id/wstecz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/przycisk_widgetu"
        android:textColor="@color/tekst"
        android:textSize="15sp"
        android:text="‹" />

    <TextView
        android:id="@+id/naglowek"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/tekst"
        android:textSize="15sp"
        android:text="Na dziś" />

    <Button
        android:id="@+id/naprzod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/przycisk_widgetu"
        android:textColor="@color/tekst"
        android:textSize="15sp"
        android:text="›" />

    <Button
        android:id="@+id/wrzut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="6dp"
        android:background="@drawable/przycisk_widgetu"
        android:textColor="@color/tekst"
        android:textSize="13sp"
        android:text="Wrzuć" />
  </LinearLayout>

  <TextView
      android:id="@+id/pusto"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:layout_marginTop="10dp"
      android:textColor="@color/tekst_przygaszony"
      android:textSize="13sp"
      android:text="Na dziś nic nie zaplanowane." />

  <ListView
      android:id="@+id/lista"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:layout_marginTop="6dp"
      android:divider="@null"
      android:dividerHeight="0dp" />

</LinearLayout>
