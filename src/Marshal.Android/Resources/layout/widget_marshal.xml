    <Button android:id="@+id/zrobione_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:minHeight="0dp" android:padding="6dp" android:layout_marginStart="6dp" android:background="@drawable/przycisk_widgetu" android:textColor="@color/tekst" android:textSize="13sp" android:text="✓" />
