<?xml version="1.0" encoding="utf-8"?>
<!--
  Pasek tygodnia nad listą.

  Widget odpowiadał na pytanie „co mam dziś" i na nic więcej: żeby zobaczyć czwartek,
  trzeba było trafić strzałkę cztery razy i po drodze nie było widać, dokąd się idzie.
  Tydzień na wierzchu odpowiada na to jednym spojrzeniem — który dzień jest oglądany,
  które dni mają cokolwiek i jak daleko do soboty.

  Siedem kolumn wypisanych wprost, bo RemoteViews nie zna pętli: system rozwija ten
  układ w procesie ekranu domowego i wolno tu wyłącznie to, co umie rozwinąć. Stąd
  też znikanie kropki i kreski przez podmianę tła na przezroczyste, a nie przez
  ukrycie — ukryty widok oddaje miejsce, a oddane miejsce przesuwa numery w kolumnach
  obok i pasek przestaje być siatką.

  updatePeriodMillis zostaje zerem świadomie: system i tak nie odświeża częściej
  niż co pół godziny, a widget ma być aktualny **po zmianie**, nie co pół godziny.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/korzen"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="10dp"
              android:background="@drawable/tlo_widgetu">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <Button
        android:id="@+id/wstecz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/przycisk_widgetu"
        android:textColor="@color/tekst"
        android:textSize="15sp"
        android:text="‹" />

    <TextView
        android:id="@+id/naglowek"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/tekst"
        android:textSize="16sp"
        android:text="Wrzesień" />

    <Button
        android:id="@+id/naprzod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/przycisk_widgetu"
        android:textColor="@color/tekst"
        android:textSize="15sp"
        android:text="›" />

    <Button
        android:id="@+id/wrzut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/przycisk_widgetu"
        android:textColor="@color/tekst"
        android:textSize="15sp"
        android:text="+" />
  </LinearLayout>

  <LinearLayout
