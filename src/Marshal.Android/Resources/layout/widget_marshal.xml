<?xml version="1.0" encoding="utf-8"?>
<!--
  Osiem wierszy wpisanych wprost, a nie ListView z RemoteViewsService.
  Lista w widgecie to osobna usługa, osobna fabryka widoków i osobny cykl życia.
  Przy planie jednego dnia osiem pozycji mieści to, co widać na ekranie domowym
  bez przewijania — a widget, po który trzeba sięgnąć palcem, przestaje być
  spojrzeniem i staje się aplikacją. Reszta dnia jest w aplikacji, o jedno
  dotknięcie stąd, i licznik na dole mówi, ile jej zostało.

  Wiersz ma dwie linijki: co i kiedy. Sama nazwa nie odpowiada na pytanie, po
  które się na plan patrzy — „czy mam teraz coś umówionego".

  updatePeriodMillis zostaje zerem świadomie: system i tak nie odświeża częściej
  niż co pół godziny, a widget ma być aktualny **po zmianie**, nie co pół godziny.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="12dp"
