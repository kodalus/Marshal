<?xml version="1.0" encoding="utf-8"?>
<!--
  Pusty kwadrat odhaczenia.

  Do dziś stał tu przycisk z ptaszkiem i czytało się go jako zadanie **już odhaczone**
  — czyli dokładnie odwrotnie, niż znaczył. Kwadracik do zaznaczenia jest pusty; ptaszek
  jest tym, co się w nim pojawia po kliknięciu, a nie zaproszeniem do kliknięcia.

  Obrys wsunięty w tło, bo przycisk ma czterdzieści osiem punktów na dotknięcie,
  a kwadracik dwadzieścia dwa na wygląd. Tło przycisku wypełnia go w całości, więc
  różnicę trzeba zrobić tutaj — inaczej albo kwadracik jest za duży, albo w przycisk
  nie da się trafić palcem.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
       android:insetLeft="13dp"
       android:insetRight="13dp"
       android:insetTop="13dp"
       android:insetBottom="13dp">

  <shape android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke android:width="1.5dp" android:color="@color/tekst_przygaszony" />
    <corners android:radius="4dp" />
  </shape>
</inset>
