<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />

  <!-- Od Androida 13 powiadomienia wymagają zgody, o którą aplikacja pyta przy
       pierwszym uruchomieniu. Wcześniejsze wydania dają ją z instalacją, ale wpis
       musi być tak czy inaczej — bez niego prośba nie ma o co pytać. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Sieć. W wydaniu do debugowania Android dokłada to uprawnienie sam i właśnie
       dlatego łatwo o nim zapomnieć: bez wpisu wydanie Release nie ma dostępu do
       sieci w ogóle — ani do Dysku, ani do kalendarza, ani do kanałów iCal. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Usługa pierwszoplanowa na czas logowania. Bez niej system odkłada proces
       do zamrażarki, gdy przeglądarka go przykryje, i powrót ze zgody nie ma kogo
       obudzić. Rodzaj „dataSync", bo logowanie jest pierwszym krokiem synchronizacji. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

  <!-- Dokładne budziki na przypomnienia. Dwa wpisy, bo Android zmienił tu zdanie:

       USE_EXACT_ALARM (od Androida 13) przyznaje się **przy instalacji**, bez pytania
       i bez wchodzenia w ustawienia systemu. Jest zastrzeżone dla aplikacji, których
       istotą są budziki, kalendarze i przypomnienia — Marshal nią jest, więc wpis
       jest uczciwy, a nie naciągnięty. Uwaga na przyszłość: przy publikacji w sklepie
       Google wymaga do tego osobnej deklaracji; przy instalacji z pliku nie ma to
       znaczenia.

       SCHEDULE_EXACT_ALARM zostaje dla Androida 12, gdzie tamtego jeszcze nie ma.
       Tam zgoda bywa nieprzyznana i aplikacja schodzi na budzik niedokładny zamiast
       prosić na siłę — spóźnione przypomnienie jest lepsze od żadnego. -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

  <!-- Budziki nie przeżywają wyłączenia telefonu. Bez tego przypomnienia milkną po
       każdym restarcie aż do następnego otwarcia aplikacji — i nie widać, że zamilkły. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Ikona wskazana wprost. Bez niej system bierze zieloną ikonę domyślną, przez co
       aplikacja na ekranie domowym nie ma nic wspólnego z tą samą aplikacją na pulpicie.
       „roundIcon" celowo nie ma: ikona adaptacyjna radzi sobie z okrągłą maską sama,
       a osobny wpis to drugi zestaw plików, który musiałby się z tym zgadzać. -->
  <application android:label="Marshal"
               android:icon="@mipmap/ic_launcher"
               android:allowBackup="false" />
</manifest>
