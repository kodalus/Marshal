<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!--
      Na Windowsie budujemy pod wersjonowany cel windowsowy, gdzie indziej pod zwykły.

      Dymki potrzebują typu ToastNotificationManagerCompat, a ten istnieje **tylko**
      w windowsowej odmianie biblioteki powiadomień. Przy celu net10.0 NuGet podstawia
      odmianę netstandard, w której tego typu nie ma — i wychodzi to dopiero przy
      próbie pokazania powiadomienia, jako TypeLoadException. Kompilacja przechodzi,
      bo brakujący typ jest po drugiej stronie cudzej biblioteki.

      Koszt: na Linuksie (tam chodzi CI) kod od dymków nie jest kompilowany. Świadomy,
      bo wybór jest między „CI nie sprawdza dziesięciu linii" a „dymki nie działają
      w ogóle".
    -->
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.17763.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <DefineConstants Condition="'$(OS)' == 'Windows_NT'">$(DefineConstants);TOASTS</DefineConstants>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Marshal</AssemblyName>
    <RootNamespace>Marshal.Desktop</RootNamespace>

    <!-- Ikona pliku wykonywalnego. Osobno od ikony okna: pierwszą pokazuje pulpit
         i pasek zadań, zanim aplikacja w ogóle wstanie, drugą rysuje sama aplikacja.

         **Ten sam plik**, co ikona okna, a nie kopia obok. Kopia leżała tutaj i została
         w tyle: znak przerysowano, ikona okna i ikona Androida pojechały za nim,
         bo rysuje je „tools/ikona.py", a ta jedna nie — bo skrypt o niej nie wiedział.
         Na pulpicie i w pasku zadań siedział przez to stary znak, i to w miejscu,
         w które patrzy się najczęściej. Dwa pliki na jeden znak nie mają jak zostać
         zgodne; jeden nie ma jak się rozejść. -->
    <ApplicationIcon>..\Marshal.UI\Assets\marshal.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />

    <!-- Powiadomienia systemowe. Tylko tutaj, nie w warstwie okna: pakiet jest
         desktopowy, a warstwa okna jest współdzielona z Androidem.

         Sama część windowsowa, nie zestaw z wariantem linuksowym. Ten drugi wciąga
         Tmds.DBus 0.9.1 z zgłoszoną luką wysokiej wagi, a projekt traktuje ostrzeżenia
         jak błędy — i słusznie. Podniesienie tej zależności na siłę uciszyłoby
         ostrzeżenie kosztem ścieżki, której i tak nikt tu nie uruchamia: Marshal
         chodzi na Windowsie i Androidzie. -->
    <PackageReference Include="DesktopNotifications.Windows" Version="1.3.1"
                      Condition="'$(OS)' == 'Windows_NT'" />

    <!-- Podniesione wprost, choć sami tego nie wołamy.
         Biblioteka powiadomień ciągnie System.Drawing.Common 4.7.0 z luką o wadze
         krytycznej, a zależności przechodniej nie da się poprawić inaczej niż
         wskazaniem wersji u siebie: wpis bezpośredni wygrywa z tym, co przyszło
         po drodze. Wyciszenie ostrzeżenia byłoby udawaniem, że luki nie ma. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.12"
                      Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Marshal.UI\Marshal.UI.csproj" />
  </ItemGroup>
</Project>
