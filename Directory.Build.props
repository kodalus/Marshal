<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaVersion>11.*</AvaloniaVersion>
    <EfCoreVersion>10.0.11</EfCoreVersion>
    <GoogleApisVersion>1.76.0</GoogleApisVersion>
    <!-- Pakiety wygenerowane z opisu API mają czwarty człon wersji własny dla każdego API. -->
    <GoogleDriveVersion>1.76.0.4261</GoogleDriveVersion>
    <GoogleCalendarVersion>1.75.0.4206</GoogleCalendarVersion>
    <IcalNetVersion>5.2.3</IcalNetVersion>
  </PropertyGroup>
</Project>
