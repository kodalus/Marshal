<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- **Nie włączać z powrotem.** W trybie niezmiennym .NET nie ma bazy stref
         czasowych: na Windowsie każde FindSystemTimeZoneById poza „UTC" rzuca,
         więc „Europe/Warsaw" nie istnieje, aplikacja cofa się do czasu uniwersalnego
         i **wszystkie** godziny są o dwie za wcześnie — kalendarz, kreska bieżącej
         godziny, zapisane zadania. Na Linuksie strefy czyta się z katalogu systemowego
         niezależnie od tego trybu, więc CI przechodziło i usterki nie było widać przez
         cały czas jej trwania. Kalendarz bez stref czasowych nie jest kalendarzem.
         Pilnuje tego GlobalizacjaTests. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AvaloniaVersion>11.*</AvaloniaVersion>
    <EfCoreVersion>10.0.11</EfCoreVersion>
    <GoogleApisVersion>1.76.0</GoogleApisVersion>
    <!-- Pakiety wygenerowane z opisu API mają czwarty człon wersji własny dla każdego API. -->
    <GoogleDriveVersion>1.76.0.4261</GoogleDriveVersion>
    <GoogleCalendarVersion>1.75.0.4206</GoogleCalendarVersion>
    <!-- Celowo 4.x, nie 5.x. Piąta wersja przepisała API dat: zniknęło
         AsDateTimeOffset, a rozwijanie powtórzeń przyjmuje własny typ daty zamiast
         zwykłego. Nie jest gorsza — jest inna, a tutaj nie ma lokalnego kompilatora,
         więc każde nietrafione założenie o jej kształcie kosztuje pełny przebieg CI.
         Do przejścia wtedy, gdy będzie się co przy tym oprzeć. -->
    <IcalNetVersion>4.3.1</IcalNetVersion>
    <MarkdigVersion>1.3.2</MarkdigVersion>

    <!-- Odcisk wydania w wersji informacyjnej. .NET dokleja go po znaku plus, więc
         w aplikacji widać „0.1.0+<skrót>" i wiadomo, z którego zapisu jest to, co
         chodzi na telefonie.

         Wpisane było dotąd co innego: data pliku aplikacji. Na Androidzie pliku pod tą
         ścieżką nie ma, a odczyt daty nieistniejącego pliku oddaje zero kalendarza
         Windows — stąd w dzienniku „wydanie 1601-01-01 01:24" (zero czasu uniwersalnego
         przeliczone na średni czas słoneczny Warszawy, bo tak wyglądała jej strefa przed
         rokiem 1915). Zamiast wersji stała tam więc informacja, że aplikacja nie zna
         swojej wersji — i tak wyglądała przez cały czas, gdy była potrzebna.

         Tylko z CI: warunek na GITHUB_SHA. Przy budowaniu u siebie odcisku nie ma,
         bo tam i tak wiadomo, co się zbudowało. -->
    <SourceRevisionId Condition="'$(GITHUB_SHA)' != ''">$(GITHUB_SHA.Substring(0, 12))</SourceRevisionId>
  </PropertyGroup>
</Project>
